    """Находит рабочий путь ONVIF device-сервиса (без авторизации)."""
    for path in ONVIF_DEVICE_PATHS:
        try:
            r = requests.post(f'http://{ip}{path}', data=GET_DATE_TIME_BODY,
                              headers={'Content-Type': 'application/soap+xml; charset=utf-8'},
                              timeout=timeout)
            if r.status_code == 200 and b'GetSystemDateAndTimeResponse' in r.content:
                return f'http://{ip}{path}'
        except Exception:
            continue
    return None


def onvif_get_device_info(ip, user, passwd, auth_type='digest',
                          device_url=None, timeout=6):
    """ONVIF GetDeviceInformation с авторизацией.
    Возвращает (info_dict, error)."""
    if not device_url:
        device_url = f'http://{ip}/onvif/device_service'
    body = _soap(
        '<s:Body><GetDeviceInformation xmlns='
        '"http://www.onvif.org/ver10/device/wsdl"/></s:Body>')
    headers = {'Content-Type': 'application/soap+xml; charset=utf-8'}
    resp = None
    try:
        # 1) HTTP Digest
        resp = requests.post(device_url, data=body, headers=headers,
                             auth=HTTPDigestAuth(user, passwd), timeout=timeout)
        # 2) WS-Security UsernameToken, если digest не принят
        if resp.status_code in (401, 403) or b'NotAuthorized' in resp.content:
            sec = _wsse_header(user, passwd)
            wsse_body = _soap(
                f'{sec}<s:Body><GetDeviceInformation xmlns='
                f'"http://www.onvif.org/ver10/device/wsdl"/></s:Body>')
            resp = requests.post(device_url, data=wsse_body, headers=headers,
                                 timeout=timeout)
        if resp.status_code == 200 and b'GetDeviceInformationResponse' in resp.content:
            root = ET.fromstring(resp.content)
            ns = {'tds': 'http://www.onvif.org/ver10/device/wsdl'}
            node = root.find('.//tds:GetDeviceInformationResponse', ns)

            def _t(tag):
                el = node.find(f'tds:{tag}', ns) if node is not None else None
                return (el.text or '').strip() if el is not None and el.text else ''
            return {'manufacturer': _t('Manufacturer'), 'model': _t('Model'),
                    'fw': _t('FirmwareVersion'), 'serial': _t('SerialNumber'),
                    'hw': _t('HardwareId')}, None
        err = 'ONVIF: доступ запрещён (неверные учётные данные?)'
        if resp is not None:
            try:
                fr = ET.fromstring(resp.content)
                tr = fr.find('.//{http://www.onvif.org/ver10/soap}Text')
                if tr is not None and tr.text:
                    err = f'ONVIF: {tr.text}'
            except Exception:
                pass
        return None, err
    except requests.Timeout:
        return None, 'ONVIF: таймаут запроса'
    except Exception as e:
        return None, f'ONVIF: {e}'


def _wsse_header(user, passwd):
    """WS-Security UsernameToken (PasswordDigest) для ONVIF."""
    nonce = os.urandom(16)
    created = datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%S.%f')[:-3] + 'Z'
    digest = base64.b64encode(
        hashlib.sha1(nonce + created.encode() + passwd.encode()).digest()).decode()
    b64nonce = base64.b64encode(nonce).decode()
    wsu = 'http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd'
    return (f'<s:Header><Security xmlns="http://docs.oasis-open.org/wss/2004/01/'
            f'oasis-200401-wss-wssecurity-secext-1.0.xsd">'
            f'<UsernameToken><Username>{user}</Username>'
            f'<Password Type="http://docs.oasis-open.org/wss/2004/01/'
            f'oasis-200401-wss-username-token-profile-1.0#PasswordDigest">'
            f'{digest}</Password>'
            f'<Nonce EncodingType="http://docs.oasis-open.org/wss/2004/01/'
            f'oasis-200401-wss-soap-message-security-1.0#Base64Binary">'
            f'{b64nonce}</Nonce>'
            f'<Created xmlns="{wsu}">{created}</Created>'
            f'</UsernameToken></Security></s:Header>')


def hikvision_isapi_probe(ip, user=None, passwd=None, timeout=HTTP_TIMEOUT):
    """Проверка /ISAPI/System/deviceInfo. Без пароля: 401 => это Hikvision.
    С паролем: полная информация об устройстве."""
    out = {'present': False, 'info': None, 'name': ''}
    try:
        r = requests.get(f'http://{ip}/ISAPI/System/deviceInfo', timeout=timeout)
        if r.status_code in (401, 403) or (r.status_code == 200 and b'deviceInfo' in r.content):
            out['present'] = True
        if user and out['present']:
            r2 = requests.get(f'http://{ip}/ISAPI/System/deviceInfo',
                              auth=HTTPDigestAuth(user, passwd), timeout=timeout)
            if r2.status_code == 200:
                try:
                    root = ET.fromstring(r2.content)

                    def _t(tag):
                        el = root.find(tag)
                        return (el.text or '').strip() if el is not None and el.text else ''
                    out['info'] = {'model': _t('model'), 'serial': _t('serialNumber'),
                                   'fw': _t('firmwareVersion'), 'name': _t('deviceName')}
                    out['name'] = _t('deviceName')
                except Exception:
                    pass
    except Exception:
        pass
    return out


def http_fingerprint(ip, timeout=HTTP_TIMEOUT):
    """Сбор отпечатков веб-интерфейса: Server, заголовок страницы."""
    out = {'server': '', 'title': ''}
    for port in (80, 81, 8080):
        try:
            r = requests.get(f'http://{ip}:{port}/', timeout=timeout, allow_redirects=True)
            out['server'] = r.headers.get('Server', '') or ''
            m = re.search(r'<title[^>]*>(.*?)</title>', r.text, re.S | re.I)
            if m:
                out['title'] = re.sub(r'\s+', ' ', m.group(1)).strip()[:120]
            if out['server'] or out['title']:
                break
        except Exception:
            continue
    return out


def ws_discovery(timeout=5.0):
    """ONVIF WS-Discovery (UDP multicast 239.255.255.250:3702).
    Возвращает список {ip, hw, name, scopes}."""
    results = {}
    msg = ('<?xml version="1.0" encoding="UTF-8"?>'
           '<e:Envelope xmlns:e="http://www.w3.org/2003/05/soap-envelope" '
           'xmlns:a="http://schemas.xmlsoap.org/ws/2004/08/addressing" '
           'xmlns:d="http://schemas.xmlsoap.org/ws/2005/04/discovery" '
           'xmlns:dn="http://www.onvif.org/ver10/network/wsdl">'
           '<e:Header><a:Action>http://schemas.xmlsoap.org/ws/2005/04/discovery/Probe</a:Action>'
           '<a:MessageID>urn:uuid:' + str(uuid.uuid4()) + '</a:MessageID>'
           '<a:To>urn:schemas-xmlsoap-org:ws:2005:04:discovery</a:To></e:Header>'
           '<e:Body><d:Probe><d:Types>dn:NetworkVideoTransmitter</d:Types></d:Probe>'
           '</e:Body></e:Envelope>').encode()
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.settimeout(timeout)
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        s.sendto(msg, ('239.255.255.250', 3702))
        deadline = time.time() + timeout
        while time.time() < deadline:
            s.settimeout(max(0.1, deadline - time.time()))
            try:
                data, addr = s.recvfrom(65535)
            except socket.timeout:
                break
            xml = data.decode('latin1', errors='ignore')
            if 'ProbeMatch' not in xml:
                continue
            ip = addr[0]
            hw = ''
            name = ''
            scopes = ' '.join(re.findall(r'onvif://www\.onvif\.org/[^\s"<]+', xml))
            m = re.search(r'onvif://www\.onvif\.org/hardware/([^\s"<]+)', xml)
            if m:
                hw = m.group(1)
            m = re.search(r'onvif://www\.onvif\.org/name/([^\s"<]+)', xml)
            if m:
                name = urllib_unquote(m.group(1))
            xaddr_m = re.search(r'<d:XAddrs>(.*?)</d:XAddrs>', xml, re.S)
            xaddrs = xaddr_m.group(1).strip() if xaddr_m else ''
            if ip not in results:
                results[ip] = {'ip': ip, 'hw': hw, 'name': name,
                               'scopes': scopes, 'xaddrs': xaddrs}
        s.close()
    except Exception:
        pass
    return list(results.values())


def urllib_unquote(s):
    try:
        from urllib.parse import unquote
        return unquote(s)
    except Exception:
        return s


def classify_host(ip):
    """Глубокий анализ одного хоста: камера это или нет + вендор.
    Возвращает карточку устройства или None (не камера)."""
    # 1) быстрые порты
    open_ports = []
    for p in (554, 80, 8000, 37777, 34567, 8899, 8080, 81):
        if check_port(ip, p):
            open_ports.append(p)
    if not open_ports:
        return None

    rtsp_ok = False
    rtsp_server = ''
    if 554 in open_ports:
        rp = rtsp_probe(ip)
        rtsp_ok = rp['ok']
        rtsp_server = rp['server']

    isapi = {'present': False}
    http_fp = {'server': '', 'title': ''}
    if any(p in open_ports for p in (80, 81, 8080)):
        http_fp = http_fingerprint(ip)
        isapi = hikvision_isapi_probe(ip)

    onvif_url = onvif_device_service_url(ip) if rtsp_ok or any(
        p in open_ports for p in (80, 81, 8080, 8899)) else None

    # ---- Оценка "камерности" ----
    score = 0
    evidence = []
    vendor_key = None

    if rtsp_ok:
        score += 50
        evidence.append('RTSP ' + (rtsp_server or 'ответил'))
        vendor_key = match_vendor(server=rtsp_server) or vendor_key
    if onvif_url:
        score += 40
        evidence.append('ONVIF')
    if isapi['present']:
        score += 45
        evidence.append('ISAPI (Hikvision)')
        vendor_key = 'hikvision'
    if http_fp['server']:
        if any(h in http_fp['server'].lower() for h in CAMERA_HTTP_HEADERS):
            score += 15
            evidence.append('Server: ' + http_fp['server'])
        vendor_key = match_vendor(server=http_fp['server']) or vendor_key
    if http_fp['title']:
        if any(t in http_fp['title'].lower() for t in CAMERA_TITLE_PATTERNS):
            score += 15
            evidence.append('Title: ' + http_fp['title'])
        vendor_key = match_vendor(title=http_fp['title']) or vendor_key
    if 8000 in open_ports:
        score += 20
        evidence.append('порт 8000 (SDK Hikvision)')
        vendor_key = vendor_key or 'hikvision'
    if 37777 in open_ports:
        score += 20
        evidence.append('порт 37777 (SDK Dahua)')
        vendor_key = vendor_key or 'dahua'
    if 34567 in open_ports:
        score += 15
        evidence.append('порт 34567 (XM)')

    # Итог: это камера, если RTSP живой ИЛИ (ONVIF/ISAPI) ИЛИ вес >= 45
    is_camera = bool(rtsp_ok or onvif_url or isapi['present'] or score >= 45)
    if not is_camera:
        return None

    if vendor_key is None:
        vendor_key = 'generic'

    return {
        'ip': ip, 'vendor_key': vendor_key,
        'vendor': VENDORS[vendor_key]['name'],
        'model': '', 'fw': '', 'serial': '',
        'ports': open_ports, 'onvif': bool(onvif_url),
        'rtsp_server': rtsp_server, 'http_server': http_fp['server'],
        'title': http_fp['title'], 'score': score,
        'evidence': ' • '.join(evidence) if evidence else 'сетевой узел',
        'discovered_at': time.time(),
    }


def _scan_worker(ip):
    try:
        card = classify_host(ip)
        if card:
            with STATE.lock:
                STATE.devices[ip] = card
                STATE.scan['found'] += 1
            LOG.add('success',
                    f'Обнаружена камера: {card["vendor"]} {ip}',
                    ip)
        else:
            with STATE.lock:
                # убрать из devices, если ранее числилась, но исчезла
                STATE.devices.pop(ip, None)
    except Exception as e:
        LOG.add('warn', f'Ошибка сканирования {ip}: {e}', ip)
    finally:
        with STATE.lock:
            STATE.scan['progress'] += 1


def normalize_subnet(sn):
    """Приводит пользовательский ввод к CIDR-подсети /24.
    Понимает форматы: '10.1.246.', '10.1.246', '10.1.246.0',
    '10.1.246.15' (IP из сети — сканируется вся /24), '10.1.246.0/24',
    '10.1.0.0/16'. Возвращает None, если не похоже на подсеть."""
    sn = str(sn).strip().rstrip('.')
    if not sn:
        return None
    if '/' in sn:
        return sn
    parts = sn.split('.')
    if len(parts) < 3 or len(parts) > 4:
        return None
    if not all(p.isdigit() and 0 <= int(p) <= 255 for p in parts):
        return None
    return '.'.join(parts[:3]) + '.0/24'


def run_scan(subnets=None, use_ws=True):
    """Основной поток сканирования (исключительно камеры)."""
    from concurrent.futures import ThreadPoolExecutor
    with STATE.lock:
        if STATE.scan['running']:
            return
        STATE.scan['running'] = True
        STATE.scan['progress'] = 0
        STATE.scan['found'] = 0
        STATE.scan['phase'] = 'подготовка'
        STATE.scan['started'] = time.time()
        STATE.subnets = subnets or STATE.subnets
        targets = []
        for sn in STATE.subnets:
            cidr = normalize_subnet(sn)
            if cidr is None:
                LOG.add('error', f'Неверная подсеть: {sn} — введите например '
                                f'10.1.246. или 10.1.246.0/24')
                continue
            try:
                net = ipaddress.ip_network(cidr, strict=False)
                targets.extend([str(h) for h in net.hosts()])
            except ValueError:
                LOG.add('error', f'Неверная подсеть: {sn}')

    LOG.add('info', f'Сканирование запущено: {len(targets)} адресов, '
                    f'{len(STATE.subnets)} подсетей')
    t0 = time.time()

    try:
        with STATE.lock:
            STATE.scan['total'] = len(targets)
            STATE.scan['phase'] = 'сканирование портов'
        with ThreadPoolExecutor(max_workers=96) as pool:
            list(pool.map(_scan_worker, targets))

        # ONVIF WS-Discovery — дополняем картину
        if use_ws:
            with STATE.lock:
                STATE.scan['phase'] = 'ONVIF WS-Discovery'
            try:
                for d in ws_discovery(timeout=4.0):
                    ip = d['ip']
                    with STATE.lock:
                        known = STATE.devices.get(ip)
                    if not known:
                        card = {
                            'ip': ip,
                            'vendor_key': match_vendor(scopes=d['scopes'] + ' ' + d['hw'])
                                          or 'generic',
                            'model': d['hw'] or '', 'fw': '', 'serial': '',
                            'ports': [554], 'onvif': True,
                            'rtsp_server': '', 'http_server': '',
                            'title': d['name'], 'score': 60,
                            'evidence': 'WS-Discovery: ' + (d['hw'] or d['name'] or 'ONVIF'),
                            'discovered_at': time.time(),
                        }
                        with STATE.lock:
                            STATE.devices[ip] = card
                            STATE.scan['found'] += 1
                        LOG.add('success', f'WS-Discovery: {ip} '
                                           f'({d["hw"] or d["name"] or "ONVIF"})', ip)
            except Exception as e:
                LOG.add('warn', f'WS-Discovery ошибка: {e}')
    except Exception as e:
        LOG.add('error', f'Сбой сканирования: {e}')
    finally:
        with STATE.lock:
            STATE.scan['running'] = False
            STATE.scan['phase'] = ''
        LOG.add('info', f'Сканирование завершено за {time.time()-t0:.1f} c: '
                        f'камер найдено {len(STATE.devices)}')
        save_config()



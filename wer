]


def _placeholder_frame(ip, name):
    """Синтетический кадр-заглушка (камера без потока): тёмный фон, сетка,
    имя камеры. Нужен, чтобы редактор области контроля всегда открывался."""
    w, h = 960, 540
    try:
        if not _PIL:
            return None
        from PIL import ImageDraw, ImageFont
        if _NUMPY:
            kk = np.linspace(0.0, 1.0, h, dtype=np.float32)   # (h,)
            row = np.stack([20 + 10 * kk, 26 + 12 * kk, 34 + 16 * kk], axis=1)
            arr = np.tile(row[:, None, :], (1, w, 1)).astype(np.uint8)
            img = Image.fromarray(arr, 'RGB')
        else:
            img = Image.new('RGB', (w, h), (24, 30, 40))
        dr = ImageDraw.Draw(img, 'RGBA')
        for x in range(0, w, 60):
            dr.line([(x, 0), (x, h)], fill=(52, 64, 82, 90), width=1)
        for y in range(0, h, 60):
            dr.line([(0, y), (w, y)], fill=(52, 64, 82, 90), width=1)
        font = None
        for fp in _FONT_CANDIDATES:
            if os.path.isfile(fp):
                try:
                    font = ImageFont.truetype(fp, 30)
                    break
                except Exception:
                    pass
        if font:
            dr.text((28, 26), name or ip, font=font,
                    fill=(236, 240, 246, 255))
            dr.text((28, h - 52), 'НЕТ СИГНАЛА', font=font,
                    fill=(140, 154, 174, 220))
        buf = io.BytesIO()
        img.save(buf, 'JPEG', quality=85)
        return buf.getvalue()
    except Exception:
        return None


def _latest_event_snapshot(ip):
    """Последний снимок аналитики камеры (an_<ip>_*.jpg) — живее заглушки."""
    pref = 'an_' + _safe_ip(ip) + '_'
    best, best_ts = None, 0
    try:
        for fn in os.listdir(SNAPSHOT_DIR):
            if fn.startswith(pref) and fn.endswith('.jpg'):
                fp = os.path.join(SNAPSHOT_DIR, fn)
                stt = os.stat(fp)
                if stt.st_mtime > best_ts:
                    best, best_ts = fp, stt.st_mtime
    except Exception:
        return None
    try:
        if best and time.time() - best_ts < 86400 * 3:   # не старше 3 суток
            with open(best, 'rb') as f:
                return f.read()
    except Exception:
        pass
    return None



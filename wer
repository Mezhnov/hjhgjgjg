PRESENCE_DIR = os.path.join(ARCHIVE_DIR, 'presence')
PRESENCE_LOG_LOCK = threading.Lock()


def presence_log_append(ip, start, end, dur):
    """Дописать закрытую сессию присутствия в суточный jsonl-файл.

    Вызывается из потока движка аналитики, поэтому полностью
    безопасна: любая ошибка молча игнорируется, чтобы не уронить
    обработку кадров."""
    try:
        with PRESENCE_LOG_LOCK:
            os.makedirs(PRESENCE_DIR, exist_ok=True)
            day = datetime.fromtimestamp(start).strftime('%Y-%m-%d')
            fp = os.path.join(PRESENCE_DIR, f'presence_{day}.jsonl')
            rec = {'ip': ip, 'start': round(start, 1), 'end': round(end, 1),
                   'dur': round(dur, 1)}
            with open(fp, 'a', encoding='utf-8') as f:
                f.write(json.dumps(rec) + '\n')
    except Exception:
        pass


def presence_log_load(date_s):
    """Прочитать все сессии присутствия за дату (все камеры)."""
    out = []
    fp = os.path.join(PRESENCE_DIR, f'presence_{date_s}.jsonl')
    try:
        with open(fp, encoding='utf-8') as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                    if 'ip' in rec and 'start' in rec:
                        out.append(rec)
                except Exception:
                    continue
    except Exception:
        pass
    return out


def presence_log_dates(ip):
    """Даты, по которым у камеры есть записи в журнале присутствия."""
    dates = set()
    try:
        for fn in os.listdir(PRESENCE_DIR):
            m = re.match(r'presence_(\d{4}-\d{2}-\d{2})\.jsonl$', fn)
            if not m:
                continue
            for rec in presence_log_load(m.group(1)):
                if rec.get('ip') == ip:
                    dates.add(m.group(1))
                    break
    except Exception:
        pass
    return dates


def archive_dates(ip):
    """Даты, по которым у камеры есть mp4-файлы в архиве."""
    dates = set()
    try:
        for fn in os.listdir(ARCHIVE_DIR):
            m = re.match(r'rec_(\d+_\d+_\d+_\d+)_(\d{8})_\d{6}\.mp4$', fn)
            if m and m.group(1).replace('_', '.') == ip:
                dates.add(datetime.strptime(m.group(2), '%Y%m%d')
                          .strftime('%Y-%m-%d'))
    except Exception:
        pass
    return dates



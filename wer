    motion:       {label:'Движение',    color:'#f39c12', ico:'bolt'},
    scene:        {label:'Смена сцены', color:'#0e86d6', ico:'shuffle'},
    tamper_dark:  {label:'Затемнение',  color:'#e74c3c', ico:'moon'},
    tamper_bright:{label:'Засветка',    color:'#e74c3c', ico:'sun'},
    defocus:      {label:'Расфокус',    color:'#9b59b6', ico:'blur'},
    signal_loss:  {label:'Нет сигнала', color:'#e74c3c', ico:'wifi-off'},
    person_enter: {label:'Приход',      color:'#17994e', ico:'enter'},
    person_left:  {label:'Уход',        color:'#0e86d6', ico:'exit'},

        'ip': ip, 'name': c.get('name', ip), 'vendor': c.get('vendor', ''),
        'vendor_key': c.get('vendor_key', 'generic'),
        'model': c.get('model', ''), 'fw': c.get('fw', ''),
        'serial': c.get('serial', ''),

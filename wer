def get_ffmpeg_timeout_flag():
    """ffmpeg >= 5 использует -timeout, старые сборки — -stimeout (RTSP)."""
    if not FFMPEG_AVAILABLE:
        return ['-timeout', '5000000']
    try:
        r = subprocess.run(
            [FFMPEG_PATH, '-hide_banner', '-timeout', '1', '-i', 'rtsp://x',
             '-f', 'null', '-'],
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=4,
            creationflags=CREATE_NO_WINDOW)
        err = r.stderr.decode(errors='ignore')
        if 'Option not found' not in err and 'Unrecognized option' not in err:
            return ['-timeout', '5000000']
    except Exception:
        pass
    return ['-stimeout', '5000000']



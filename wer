class EventLog:
    """Кольцевой буфер событий системы."""

    def __init__(self, maxlen=600):
        self.lock = threading.Lock()
        self.events = deque(maxlen=maxlen)
        self.next_id = 1

    def add(self, etype, msg, ip=None):
        with self.lock:
            ev = {'id': self.next_id, 'ts': time.time(),
                  'type': etype, 'msg': msg, 'ip': ip}
            self.next_id += 1
            self.events.append(ev)
        icon = {'info': 'ℹ', 'success': '✓', 'warn': '⚠', 'error': '✗'}.get(etype, '·')
        try:
            print(f"[{datetime.now().strftime('%H:%M:%S')}] {icon} {msg}" +
                  (f" ({ip})" if ip else ""))
        except Exception:
            pass

    def since(self, last_id, limit=200):
        with self.lock:
            return [e for e in self.events if e['id'] > last_id][-limit:]

    def all(self, limit=600):
        with self.lock:
            return list(self.events)[-limit:]


LOG = EventLog()


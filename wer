def check_port(ip, port, timeout=PORT_TIMEOUT):
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(timeout)
        r = s.connect_ex((ip, port))
        s.close()
        return r == 0
    except Exception:
        return False


def rtsp_probe(ip, port=554, timeout=RTSP_SOCK_TIMEOUT):
    """RTSP OPTIONS без авторизации — проверка живости + отпечаток Server."""
    out = {'ok': False, 'server': '', 'public': ''}
    try:
        s = socket.create_connection((ip, port), timeout=timeout)
        s.settimeout(timeout)
        req = (f'OPTIONS rtsp://{ip}:{port}/ RTSP/1.0\r\nCSeq: 1\r\n'
               f'User-Agent: TIE-VMS\r\n\r\n').encode('latin1')
        s.sendall(req)
        data = b''
        while b'\r\n\r\n' not in data and len(data) < 8192:
            chunk = s.recv(4096)
            if not chunk:
                break
            data += chunk
        s.close()
        resp = data.decode('latin1', errors='ignore')
        if resp.startswith('RTSP/'):
            out['ok'] = True
            m = re.search(r'(?i)^server\s*:\s*(.+)$', resp, re.M)
            if m:
                out['server'] = m.group(1).strip()
            m = re.search(r'(?i)^public\s*:\s*(.+)$', resp, re.M)
            if m:
                out['public'] = m.group(1).strip()
    except Exception:
        pass
    return out



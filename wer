/* ================== ПЛЕЕР АРХИВА (в стиле TRASSIR) ==================
   Суточная шкала: синие полосы — сегменты записи, зелёные — периоды,
   когда в кадре были люди, оранжевые штрихи — события движения.
   Клик по шкале/списку перематывает видео на выбранное время. */
const PL = {ip:null, day:null, data:null, day0:0, seg:null,
            pendingSeek:null, timer:null};
const plTodayStr = () => { const d = new Date();
    return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+
        '-'+String(d.getDate()).padStart(2,'0'); };
const plT = s => { s=Math.max(0,Math.floor(s));
    return String(Math.floor(s/3600)).padStart(2,'0')+':'+
        String(Math.floor(s%3600/60)).padStart(2,'0')+':'+
        String(s%60).padStart(2,'0'); };

function openPlayer(ip, dateS, seekTs){
    if (!ip) return;
    if ($('fs').classList.contains('active')) closeFs();
    PL.ip = ip;
    PL.seg = null;
    PL.pendingSeek = seekTs || null;
    const opts = Object.entries(S.cameras)
        .map(([i,c]) => `<option value="${i}"${i===ip?' selected':''}>` +
            `${esc(c.name||i)} · ${i}</option>`).join('');
    $('plCam').innerHTML = opts || `<option value="${ip}">${ip}</option>`;
    $('plDate').value = dateS || plTodayStr();
    $('plDate').max = plTodayStr();
    $('mPlayer').classList.add('active');
    plLoad();
}

function openPlayerAt(ip, ts){
    const d = new Date(ts*1000);
    const iso = d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+
        '-'+String(d.getDate()).padStart(2,'0');
    openPlayer(ip, iso, ts);
}

function closePlayer(){
    plStopVideo();
    PL.seg = null;
    if (PL.timer){ clearInterval(PL.timer); PL.timer = null; }
    $('mPlayer').classList.remove('active');
}

document.querySelectorAll('.modal-overlay').forEach(m =>
    m.addEventListener('click', e => {
        if (e.target !== m) return;
        if (m.id === 'mPlayer') closePlayer();
        else m.classList.remove('active');
    }));

function plStopVideo(){
    const v = $('plVideo');
    try { v.pause(); } catch(e){}
    v.removeAttribute('src');
    try { v.load(); } catch(e){}
    $('plTimecode').style.display = 'none';
    $('plPlayBtn').innerHTML = ic('play','f');
}

async function plLoad(){
    if (!PL.ip) return;
    const date = $('plDate').value || plTodayStr();
    try {
        const r = await fetch(`/api/archive/day?ip=${encodeURIComponent(PL.ip)}` +
            `&date=${date}`);
        const d = await r.json();
        if (d.status === 'error'){ toast(d.msg || 'Ошибка архива', 'err'); return; }
        PL.data = d;
        PL.day = date;
        PL.day0 = new Date(date + 'T00:00:00').getTime() / 1000;
        plRender();
    } catch(e){ toast('Ошибка архива: ' + e.message, 'err'); }
}

function plRender(){
    const d = PL.data;
    if (!d) return;
    $('plName').textContent = '— ' + (d.name || d.ip);
    $('plRecBadge').style.display = d.recording ? '' : 'none';
    $('plLgPres').textContent = d.zone ? 'люди в области' : 'люди в кадре';
    plRenderHours();
    plRenderTimeline();
    plRenderLists();
    plRenderSum();
    plUpdateEmpty();
    if (PL.timer) clearInterval(PL.timer);
    PL.timer = setInterval(() => {          // живой рост записи за сегодня
        if ($('mPlayer').classList.contains('active') && PL.day === plTodayStr())
            plLoad();
    }, 30000);
    if (PL.pendingSeek != null){            // автопереход из таблицы архива
        const t = PL.pendingSeek;
        PL.pendingSeek = null;
        const seg = (d.segments||[]).find(s => t >= s.start && t < s.start + s.dur);
        if (seg) plPlaySeg(seg, t - seg.start);
    }
}

function plRenderHours(){
    if ($('plHours').children.length === 24) return;
    let h = '';
    for (let i=0;i<24;i++)
        h += `<span>${String(i).padStart(2,'0')}</span>`;
    $('plHours').innerHTML = h;
}

function plRenderTimeline(){
    const d = PL.data;
    if (!d) return;
    const D = 86400;
    let html = '';
    for (let i=0;i<=24;i++)
        html += `<div class="pl-hourline" style="left:${(i/24*100).toFixed(3)}%"></div>`;
    (d.segments||[]).forEach(s => {                 // синее: запись
        const a = Math.max(0, s.start - PL.day0);
        const b = Math.min(D, s.start - PL.day0 + s.dur);
        if (b <= a) return;
        html += `<div class="pl-seg" style="left:${(a/D*100).toFixed(3)}%;` +
            `width:${((b-a)/D*100).toFixed(3)}%"></div>`;
    });
    (d.presence||[]).forEach(p => {                 // зелёное: люди
        const a = Math.max(0, p.start - PL.day0);
        const b = Math.min(D, (p.end || d.now) - PL.day0);
        if (b <= a) return;
        html += `<div class="pl-presence${p.end ? '' : ' open'}" ` +
            `style="left:${(a/D*100).toFixed(3)}%;width:${((b-a)/D*100).toFixed(3)}%"></div>`;
    });
    (d.motion||[]).forEach(t => {                   // оранжевые штрихи
        const a = t - PL.day0;
        if (a < 0 || a >= D) return;
        html += `<div class="pl-mot" style="left:${(a/D*100).toFixed(3)}%"></div>`;
    });
    if (PL.day === plTodayStr()){                   // маркер «сейчас»
        const n = (Date.now()/1000 - PL.day0) / D;
        if (n >= 0 && n <= 1)
            html += `<div class="pl-nowline" style="left:${(n*100).toFixed(3)}%">` +
                `<span>сейчас</span></div>`;
    }
    html += `<div class="pl-hoverline" id="plHoverLine"></div>
        <div class="pl-playhead" id="plPlayhead"><span id="plPlayheadLbl"></span></div>`;
    $('plTrack').innerHTML = html;
    plUpdatePlayhead();
}

function plRenderLists(){
    const d = PL.data;
    if (!d) return;
    const segs = d.segments || [];
    $('plSegCnt').textContent = segs.length;
    $('plSegs').innerHTML = segs.length ? segs.map((s,i) => `
        <div class="pl-row${PL.seg && PL.seg.file === s.file ? ' active' : ''}"
            data-file="${esc(s.file)}" onclick="plPlaySegIdx(${i})">
            <span class="t">${plT(s.start - PL.day0)}</span>
            <span class="arr">→</span>
            <span class="t">${plT(Math.min(86400, s.start - PL.day0 + s.dur))}</span>
            <span class="d">${fmtDur(s.dur)} · ${fmtSize(s.size)}</span>
        </div>`).join('')
        : `<div class="pl-none">За этот день записей нет.<br>
            <small>Включите запись кнопкой на плитке камеры — сегменты
            по 10 минут появятся на шкале автоматически.</small></div>`;
    const pres = d.presence || [];
    $('plPresCnt').textContent = pres.length;
    $('plPres').innerHTML = pres.length ? pres.map(p => `
        <div class="pl-row pres" onclick="plSeekDaySec(${(p.start - PL.day0 + 1).toFixed(1)})">
            <span class="pmk"></span>
            <span class="t">${plT(Math.max(0, p.start - PL.day0))}</span>
            <span class="arr">→</span>
            <span class="t">${p.end ? plT(p.end - PL.day0)
                : '<b class="pl-open">сейчас</b>'}</span>
            <span class="d">${fmtDur(p.dur)}</span>
        </div>`).join('')
        : `<div class="pl-none">Людей в кадре за этот день не зафиксировано</div>`;
}

function plRenderSum(){
    const t = (PL.data && PL.data.totals) || {};
    $('plSum').innerHTML = `Архив: <b>${fmtDur(t.archive_sec || 0)}</b>` +
        ` · люди: <b>${fmtDur(t.presence_sec || 0)}</b> в <b>${t.sessions || 0}</b>` +
        ` сесс. · движение: <b>${t.motions || 0}</b>`;
}

function plUpdateEmpty(){
    const d = PL.data;
    if (!d) return;
    if (PL.seg){
        $('plEmpty').style.display = 'none';
        return;
    }
    $('plEmpty').style.display = '';
    $('plEmpty').innerHTML = (d.segments||[]).length
        ? ic('play') + `<div>Кликните по шкале суток или выберите сегмент в списке</div>`
        : ic('folder') + `<div><b>За ${esc(d.date)} записей этой камеры нет</b><br>` +
          (d.recording
              ? 'Запись идёт прямо сейчас — первые сегменты появятся на шкале в течение 10 минут.'
              : 'Включите запись кнопкой на плитке камеры или в полном экране.') +
          `</div>`;
}

function plUpdatePlayhead(){
    const ph = $('plPlayhead'), lbl = $('plPlayheadLbl');
    if (!ph || !lbl || !PL.data) return;
    let sec = null;
    if (PL.seg)
        sec = PL.seg.start - PL.day0 + $('plVideo').currentTime;
    else if (PL.day === plTodayStr())
        sec = PL.data.now - PL.day0;      // курсор «сейчас» на живом дне
    if (sec === null || sec < 0 || sec > 86400){ ph.style.display = 'none'; return; }
    ph.style.display = '';
    ph.style.left = (sec/86400*100).toFixed(3) + '%';
    lbl.textContent = plT(sec);
    if (PL.seg){
        $('plTimecode').style.display = '';
        $('plTimecode').textContent = plT(sec) + ' · ' + (PL.data.name || PL.data.ip);
    }
}

function plCurSec(){
    if (PL.seg) return PL.seg.start - PL.day0 + $('plVideo').currentTime;
    if (PL.data && PL.day === plTodayStr())
        return Math.max(0, PL.data.now - PL.day0);
    return 0;
}

function plSeekDaySec(sec){
    const d = PL.data;
    if (!d || sec < 0 || sec >= 86400) return;
    const t = PL.day0 + sec;
    const seg = (d.segments||[]).find(s => t >= s.start && t < s.start + s.dur);
    if (seg){ plPlaySeg(seg, t - seg.start); return; }
    const next = (d.segments||[]).find(s => s.start > t);
    const prev = [...(d.segments||[])].reverse().find(s => s.start + s.dur < t);
    let msg = 'В ' + plT(sec) + ' записи нет';
    if (next) msg += ' · ближайшая запись в ' + plT(next.start - PL.day0);
    else if (prev) msg += ' · последняя запись была до ' +
        plT(prev.start + prev.dur - PL.day0);
    toast(msg, 'warn', 5000);
}

function plPlaySegIdx(i){
    const s = PL.data && PL.data.segments && PL.data.segments[i];
    if (s) plPlaySeg(s, 0);
}

function plPlaySeg(seg, offset){
    if (!seg) return;
    const v = $('plVideo');
    PL.seg = seg;
    $('plEmpty').style.display = 'none';
    v.src = '/archive/' + encodeURIComponent(seg.file) + '?play=1';
    v.playbackRate = parseFloat($('plSpeed').value) || 1;
    const onMeta = () => {
        v.removeEventListener('loadedmetadata', onMeta);
        if (offset && offset > 0)
            try { v.currentTime = Math.min(offset,
                Math.max(0, (v.duration || 1e9) - 0.5)); } catch(e){}
        v.play().catch(()=>{});
    };
    v.addEventListener('loadedmetadata', onMeta);
    v.play().catch(()=>{});
    document.querySelectorAll('#plSegs .pl-row').forEach(r =>
        r.classList.toggle('active', r.dataset.file === seg.file));
}

function plJumpPres(dir){
    const d = PL.data;
    if (!d) return;
    const pres = d.presence || [];
    const cur = plCurSec();
    if (dir > 0){
        const p = pres.find(x => x.start - PL.day0 > cur + 1);
        if (!p){ toast('Позже ' + plT(cur) + ' людей в кадре не было', 'info'); return; }
        plSeekDaySec(p.start - PL.day0 + 1);
    } else {
        const p = [...pres].reverse()
            .find(x => (x.end || d.now) - PL.day0 < cur - 1);
        if (!p){ toast('Раньше ' + plT(cur) + ' людей в кадре не было', 'info'); return; }
        plSeekDaySec(p.start - PL.day0 + 1);
    }
}

function plJumpSeg(dir){
    const d = PL.data;
    if (!d) return;
    const segs = d.segments || [];
    const cur = plCurSec();
    if (dir > 0){
        const s = segs.find(x => x.start - PL.day0 > cur + 1);
        if (!s){ toast('Записей позже ' + plT(cur) + ' нет', 'info'); return; }
        plPlaySeg(s, 0);
    } else {
        const s = [...segs].reverse().find(x => x.start + x.dur - PL.day0 < cur - 1);
        if (!s){ toast('Записей раньше ' + plT(cur) + ' нет', 'info'); return; }
        plPlaySeg(s, 0);
    }
}

function plToggle(){
    const v = $('plVideo');
    if (!PL.seg){
        const s = PL.data && PL.data.segments && PL.data.segments[0];
        if (s) plPlaySeg(s, 0);
        else toast('Нет записей за этот день', 'info');
        return;
    }
    if (v.paused) v.play().catch(()=>{});
    else v.pause();
}

function plSetSpeed(val){
    try { $('plVideo').playbackRate = parseFloat(val) || 1; } catch(e){}
}

function plDownload(){
    if (!PL.seg){ toast('Сначала выберите сегмент на шкале или в списке', 'info'); return; }
    window.location.href = '/archive/' + encodeURIComponent(PL.seg.file);
}

function plShiftDay(dd){
    const dt = new Date(($('plDate').value || plTodayStr()) + 'T12:00:00');
    dt.setDate(dt.getDate() + dd);
    const iso = dt.getFullYear()+'-'+String(dt.getMonth()+1).padStart(2,'0')+
        '-'+String(dt.getDate()).padStart(2,'0');
    $('plDate').value = iso;
    plDateChanged();
}

function plToday(){
    $('plDate').value = plTodayStr();
    plDateChanged();
}

function plDateChanged(){
    PL.seg = null;
    PL.pendingSeek = null;
    plStopVideo();
    plLoad();
}

function plCamChanged(){
    PL.ip = $('plCam').value;
    PL.seg = null;
    PL.pendingSeek = null;
    plStopVideo();
    plLoad();
}

/* события видео и шкалы (навешиваются один раз) */
(function plInit(){
    const v = $('plVideo');
    v.addEventListener('timeupdate', plUpdatePlayhead);
    v.addEventListener('play', () => { $('plPlayBtn').innerHTML = ic('pause','f'); });
    v.addEventListener('pause', () => { $('plPlayBtn').innerHTML = ic('play','f'); });
    v.addEventListener('ended', () => {      // непрерывная запись — дальше сами
        const d = PL.data;
        if (!d || !PL.seg) return;
        const i = (d.segments||[]).findIndex(s => s.file === PL.seg.file);
        const nx = d.segments[i+1];
        if (nx && nx.start - (PL.seg.start + PL.seg.dur) < 20)
            plPlaySeg(nx, 0);
    });
    const tr = $('plTrack');
    tr.addEventListener('mousemove', e => {
        const r = tr.getBoundingClientRect();
        const x = Math.min(Math.max(0, e.clientX - r.left), r.width);
        const hl = $('plHoverLine');
        if (hl){ hl.style.display = ''; hl.style.left = (x - 0.5) + 'px'; }
    });
    tr.addEventListener('mouseleave', () => {
        const hl = $('plHoverLine');
        if (hl) hl.style.display = 'none';
    });
    tr.addEventListener('click', e => {
        const r = tr.getBoundingClientRect();
        plSeekDaySec((e.clientX - r.left) / r.width * 86400);
    });
})();


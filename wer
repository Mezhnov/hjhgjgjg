/* цифровой зум просмотра */
function applyZoom(){
    const img = $('fsImg');
    img.style.transform = `translate(${fsPanX}px, ${fsPanY}px) scale(${fsZoom})`;
    $('fsZoomInd').textContent = Math.round(fsZoom * 100) + '%';
    $('fsZoomInd').style.display = fsZoom > 1 ? '' : 'none';
    fsZoneSync();
}

/* цифровой зум + управление камерой мышью (перенос из self60):
   если открыта панель PTZ и камера поворотная — колесо = зум камеры,
   перетаскивание кадра = поворот, короткий клик = повернуть камеру
   к точке; иначе — обычный цифровой зум просмотра */
function ptzMouseMode(){
    const p = $('ptzPanel');
    return !!(p && p.style.display !== 'none' && fsIp &&
        S.cameras[fsIp] && S.cameras[fsIp].ptz);
}
let _ptzVecLast = 0, _ptzZoomTimer = null;
function ptzVec(pan, tilt, zoom){
    if (!fsIp) return;
    const now = Date.now();
    if (now - _ptzVecLast < 130) return;
    _ptzVecLast = now;
    const speed = (parseInt($('ptzSpeed').value) || 50) / 100;
    fetch('/api/ptz/' + fsIp, {method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({cmd:'move', speed, pan, tilt, zoom})})
        .catch(()=>{});
}
function fsCursor(){
    const img = $('fsImg');
    if (img) img.style.cursor = ptzMouseMode() ? 'crosshair' : '';
}
$('fsStage').addEventListener('wheel', e => {
    if (!fsIp) return;
    e.preventDefault();
    if (ptzMouseMode()){
        ptzVec(0, 0, e.deltaY < 0 ? 0.9 : -0.9);
        clearTimeout(_ptzZoomTimer);
        _ptzZoomTimer = setTimeout(() => ptzCmd('stop'), 500);
        return;
    }
    const old = fsZoom;
    fsZoom = Math.min(8, Math.max(1, fsZoom * (e.deltaY < 0 ? 1.15 : 0.87)));
    if (fsZoom === 1){ fsPanX = 0; fsPanY = 0; }
    else {
        const k = fsZoom / old;
        fsPanX *= k; fsPanY *= k;
    }
    applyZoom();
}, {passive:false});
let dragOn = false, dragX = 0, dragY = 0;
let ptzDrag = null;      // перетаскивание кадра для поворота камеры
$('fsImg').addEventListener('mousedown', e => {
    if (ptzMouseMode()){
        ptzDrag = {x: e.clientX, y: e.clientY, moved: 0};
        e.preventDefault();
        return;
    }
    if (fsZoom <= 1) return;
    dragOn = true; dragX = e.clientX - fsPanX; dragY = e.clientY - fsPanY;
    $('fsImg').classList.add('dragging');
    e.preventDefault();
});
window.addEventListener('mousemove', e => {
    if (ptzDrag){
        const dx = e.clientX - ptzDrag.x, dy = e.clientY - ptzDrag.y;
        ptzDrag.moved += Math.abs(dx) + Math.abs(dy);
        ptzDrag.x = e.clientX; ptzDrag.y = e.clientY;
        if (ptzDrag.moved > 6){
            const r = $('fsImg').getBoundingClientRect();
            const pan = Math.max(-1, Math.min(1,
                -dx / Math.max(80, r.width) * 2.2));
            const tilt = Math.max(-1, Math.min(1,
                dy / Math.max(60, r.height) * 2.2));
            if (Math.abs(pan) > 0.04 || Math.abs(tilt) > 0.04)
                ptzVec(pan, tilt, 0);
        }
        return;
    }
    if (!dragOn) return;
    fsPanX = e.clientX - dragX; fsPanY = e.clientY - dragY;
    applyZoom();
});
window.addEventListener('mouseup', e => {
    if (ptzDrag){
        const wasDrag = ptzDrag.moved > 6;
        ptzDrag = null;
        if (wasDrag){ ptzStop(); return; }
        // короткий клик без движения — повернуть камеру к этой точке
        const r = $('fsImg').getBoundingClientRect();
        if (r.width > 10 && e.clientX >= r.left && e.clientX <= r.right &&
                e.clientY >= r.top && e.clientY <= r.bottom){
            const nx = (e.clientX - r.left) / r.width - 0.5;
            const ny = (e.clientY - r.top) / r.height - 0.5;
            ptzVec(Math.max(-1, Math.min(1, nx * 2 * 1.2)),
                   Math.max(-1, Math.min(1, -ny * 2 * 1.2)), 0);
            setTimeout(() => ptzCmd('stop'), 600);
        }
        return;
    }
    dragOn = false;
    $('fsImg') && $('fsImg').classList.remove('dragging');
});


@app.route('/api/wall')
def api_wall():
    """SSE-мультиплексор видеостены: ОДИН канал на все камеры.
    Обходит лимит браузера на 6 соединений и гарантирует мгновенное
    переключение камер (ffmpeg на камеру остаётся один и тот же)."""
    def generate():
        subs = {}          # ip -> (CameraStream, last_frame_id, last_emit_ts)
        last_cam_set = None
        heartbeat = time.time()
        try:
            # сразу отдаём заголовки браузеру (EventSource не ждёт)
            yield ': hello\n\n'
            while True:
                # 1) синхронизируем список камер
                with STATE.lock:
                    cams = {ip: c for ip, c in STATE.cameras.items()
                            if c.get('rtsp_view') or c.get('rtsp_main')}
                cam_set = frozenset(cams.keys())
                if cam_set != last_cam_set:
                    # отписаться от ушедших
                    for ip in list(subs.keys()):
                        if ip not in cams:
                            st, _, _ = subs.pop(ip)
                            try:
                                st.unsubscribe()
                            except Exception:
                                pass
                    # подписаться на новых
                    for ip in cams:
                        if ip not in subs:
                            st = hub_get(ip)
                            if st:
                                st.subscribe()
                                subs[ip] = [st, -1, 0.0]
                    last_cam_set = cam_set
                # 2) определяем частоту кадров на камеру по числу подписчиков.
                n = len(subs)
                if n == 0:
                    min_iv = 1.0
                elif n <= 4:
                    min_iv = 0.07    # ~14 fps — плавнее плитки 2×2
                elif n <= 9:
                    min_iv = 0.12    # ~8 fps
                elif n <= 16:
                    min_iv = 0.2     # ~5 fps
                else:
                    min_iv = 0.33    # ~3 fps
                # 3) собираем готовые кадры (без блокировки)
                now = time.time()
                out = []
                any_ready = False
                next_due = 1.0
                for ip, (st, last_id, last_emit) in subs.items():
                    dt = now - last_emit
                    if dt < min_iv:
                        # когда следующий кадр этой камеры будет готов к отправке
                        next_due = min(next_due, min_iv - dt)
                        continue
                    with st.lock:
                        fid = st.frame_id
                        frame = st.frame
                    if frame and fid > last_id:
                        subs[ip][1] = fid
                        subs[ip][2] = now
                        out.append((ip, frame))
                        any_ready = True
                    else:
                        # нет нового кадра: подождём появления (st.cond.notify)
                        next_due = min(next_due, 0.05)
                # 4) отправка
                if out:
                    parts = []
                    for ip, frame in out:
                        # Бинарный SSE через base64 — единственный формат,
                        # который работает в EventSource. Кодируем один раз,
                        # без json.dumps (он медленный на больших payload'ах).
                        b64 = base64.b64encode(frame).decode('ascii')
                        parts.append('data: {"ip":"')
                        parts.append(ip)
                        parts.append('","f":"')
                        parts.append(b64)
                        parts.append('"}\n\n')
                    yield ''.join(parts)
                elif now - heartbeat > 12:
                    yield ': ping\n\n'
                    heartbeat = now
                # Спим до следующего готового кадра, но не дольше 50 мс.
                # Если есть данные — отдаём без задержки (минимизируем latency).
                if not any_ready:
                    time.sleep(min(0.05, max(0.005, next_due)))
        except GeneratorExit:
            pass
        except Exception as e:
            LOG.add('error', f'Видеостена SSE: {e}')
        finally:
            for ip, (st, _, _) in subs.items():
                try:
                    st.unsubscribe()
                except Exception:
                    pass

    return Response(generate(), mimetype='text/event-stream',
                    headers={'Cache-Control': 'no-cache', 'X-Accel-Buffering': 'no'})



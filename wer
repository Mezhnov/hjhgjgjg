@app.route('/api/add_camera', methods=['POST'])
def api_add_camera():
    """Ручное добавление камеры: IP + порт + логин + пароль (без сканирования).
    Создаёт синтетическую запись в STATE.devices[ip], затем запускает
    стандартный цикл connect_camera_core()."""
    data = request.get_json(silent=True) or {}
    ip = (data.get('ip') or '').strip()
    port = int(data.get('port', 80) or 80)
    user = (data.get('user') or '').strip()
    passwd = (data.get('pass') or '').strip()
    auth_type = data.get('auth_type', 'digest')
    remember = bool(data.get('remember', False))
    if not ip:
        return jsonify({'status': 'error', 'msg': 'Укажите IP-адрес камеры'})
    if not user or not passwd:
        return jsonify({'status': 'error', 'msg': 'Введите логин и пароль'})
    # Простая валидация IPv4 (без поддержки имён/RTSP URL здесь)
    try:
        ipaddress.ip_address(ip)
    except ValueError:
        return jsonify({'status': 'error',
                        'msg': f'Неверный IP-адрес: {ip}'})
    # Регистрируем синтетическую запись устройства, если ещё нет
    with STATE.lock:
        if ip not in STATE.devices:
            STATE.devices[ip] = {
                'ip': ip, 'vendor_key': 'generic',
                'vendor': 'Ручное добавление',
                'model': '', 'fw': '', 'serial': '',
                'ports': [port, 554], 'onvif': port != 554,
                'rtsp_server': '', 'http_server': '',
                'title': '', 'score': 50,
                'evidence': 'Добавлено вручную',
                'discovered_at': time.time(),
            }
    # Запуск подключения в фоне — UI модалки сам обновится по /api/state
    def _bg():
        r = connect_camera_core(ip, user, passwd, auth_type, remember, deep=True)
        if r.get('status') == 'ok':
            LOG.add('success', f'Камера добавлена вручную: {ip}', ip)
        else:
            LOG.add('error', f'Не удалось подключиться к {ip}: '
                              f'{r.get("msg","")}', ip)
    threading.Thread(target=_bg, daemon=True,
                     name=f'add-cam-{ip}').start()
    return jsonify({'status': 'ok',
                    'msg': 'Подключение запущено — ожидайте появления потока',
                    'ip': ip})



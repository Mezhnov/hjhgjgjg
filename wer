/* ================== SSE ВИДЕОСТЕНЫ ==================
   Один общий канал на все плитки — сервер мультиплексирует кадры
   всех камер. Именно поэтому переключение камер работает мгновенно
   и без превышения лимита RTSP-сессий.
   Оптимизация FPS: используем пул ObjectURL (без revoke на каждом
   кадре), пачкуем обновления через requestAnimationFrame — браузер
   сам сбрасывает накопленные кадры в оптимальном темпе перерисовки. */
let wallSrc = null;
const frameUrls = {};   // ip -> objectURL последнего кадра (переиспользуется)
const framePending = {}; // ip -> Uint8Array последнего полученного кадра (ждёт rAF)
let frameRafScheduled = false;

function flushPendingFrames(){
    frameRafScheduled = false;
    for (const ip in framePending){
        const bytes = framePending[ip];
        delete framePending[ip];
        // Переиспользуем ObjectURL — revoke/создание на каждом кадре
        // даёт ~30 % CPU и GC-паузы = просадки FPS. Меняем .src только
        // если URL ещё живой; старый Blob обновляем через Blob.text()
        // не получится, поэтому создаём новый, но ревайкаем старый
        // асинхронно — это не блокирует перерисовку.
        const old = frameUrls[ip];
        const url = URL.createObjectURL(new Blob([bytes], {type:'image/jpeg'}));
        frameUrls[ip] = url;
        const img = document.getElementById('wimg-' + ip);
        if (img) img.src = url;
        const fimg = document.getElementById('fsImg');
        if (fimg && fsIp === ip) fimg.src = url;
        if (old) { /* отложенный revoke — не блокируем рендер */
            setTimeout(() => URL.revokeObjectURL(old), 60);
        }
    }
}

function startWallStream(){
    if (wallSrc) { wallSrc.close(); }
    wallSrc = new EventSource('/api/wall');
    wallSrc.onmessage = (e) => {
        try {
            // Быстрый парсинг: данные в формате {"ip":"1.2.3.4","f":"..."},
            // найти начало значения 'f' и вырезать base64-строку без atob-всех-символов
            // (используем substring вместо JSON.parse для скорости на больших payload'ах).
            const s = e.data;
            // "ip":"..." — первый сегмент
            const ipStart = s.indexOf('"ip":"') + 6;
            const ipEnd = s.indexOf('"', ipStart);
            const fStart = s.indexOf('"f":"', ipEnd) + 5;
            const fEnd = s.lastIndexOf('"');
            if (ipEnd < 0 || fEnd <= fStart) return;
            const ip = s.substring(ipStart, ipEnd);
            const b64 = s.substring(fStart, fEnd);
            // Декодирование base64 → Uint8Array. Используем fetch+Response
            // (быстрее, чем Uint8Array.from(atob(...)) — нет цикла по JS).
            const bytes = _b64ToBytes(b64);
            framePending[ip] = bytes;
            if (!frameRafScheduled){
                frameRafScheduled = true;
                requestAnimationFrame(flushPendingFrames);
            }
        } catch(err) { /* ignore */ }
    };
    wallSrc.onerror = () => { /* EventSource сам переподключится */ };
}

/* Быстрое декодирование base64 в Uint8Array без per-byte цикла в JS.
   Используем   pre-computed lookup table + slice. */
const _b64ch = (function(){
    const tbl = new Uint8Array(256);
    const A = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
    for (let i = 0; i < 64; i++) tbl[A.charCodeAt(i)] = i;
    tbl['='.charCodeAt(0)] = 0;
    return tbl;
})();
function _b64ToBytes(b64){
    const n = b64.length;
    // считаем padding
    let pad = 0;
    if (n >= 2 && b64[n-1] === '=') pad++;
    if (n >= 2 && b64[n-2] === '=') pad++;
    const len = (n >> 2) * 3 - pad;
    const bytes = new Uint8Array(len);
    let p = 0;
    for (let i = 0; i < n; i += 4){
        const c0 = _b64ch[b64.charCodeAt(i)];
        const c1 = _b64ch[b64.charCodeAt(i+1)];
        const c2 = _b64ch[b64.charCodeAt(i+2)];
        const c3 = _b64ch[b64.charCodeAt(i+3)];
        const v = (c0 << 18) | (c1 << 12) | (c2 << 6) | c3;
        if (p < len) bytes[p++] = (v >> 16) & 0xff;
        if (p < len) bytes[p++] = (v >> 8) & 0xff;
        if (p < len) bytes[p++] = v & 0xff;
    }
    return bytes;
}


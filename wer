_YOLO_STATE = {'model': None, 'lock': threading.Lock(), 'tried': False}


def _yolo_weights_path():
    """Найти локальные веса YOLO: переменная VMS_YOLO_MODEL, файл рядом
    со скриптом или в models/. Сеть не используется — только локальные файлы."""
    env = os.environ.get('VMS_YOLO_MODEL', '').strip()
    if env and os.path.isfile(env):
        return env
    names = ['yolov8s.pt', 'yolov8n.pt', 'yolov8m.pt']
    dirs = [BASE_DIR, os.path.join(BASE_DIR, 'models'), os.getcwd()]
    for d in dirs:
        for n in names:
            p = os.path.join(d, n)
            if os.path.isfile(p):
                return p
    return None


def _yolo_model():
    """Ленивая загрузка модели YOLO (один раз на процесс, потокобезопасно)."""
    with _YOLO_STATE['lock']:
        if _YOLO_STATE['tried']:
            return _YOLO_STATE['model']
        _YOLO_STATE['tried'] = True
        try:
            from ultralytics import YOLO          # локальная установка
            w = _yolo_weights_path()
            if not w:
                DETECT_INFO['mode'] = 'hog'
                DETECT_INFO['error'] = ('веса YOLO не найдены — положите '
                                         'yolov8s.pt рядом со скриптом')
                return None
            _YOLO_STATE['model'] = YOLO(w)
            DETECT_INFO['mode'] = 'yolo'
            DETECT_INFO['model'] = os.path.basename(w)
            DETECT_INFO['error'] = ''
        except Exception as e:
            DETECT_INFO['mode'] = 'hog'
            DETECT_INFO['error'] = f'ultralytics недоступна: {e}'
        return _YOLO_STATE['model']


def detect_people_full(frame, prefer='auto'):
    """Детекция людей и машин в JPEG-кадре.
    Возвращает (детекции, (W, H)) или None, если детекторы недоступны.
    Детекция: {'bbox': (x, y, w, h), 'cls': 'person'|'car'|..., 'conf': 0..1}.
    prefer: 'auto' (YOLO, при недоступности HOG) | 'yolo' | 'hog'."""
    model = None
    if prefer in ('auto', 'yolo'):
        model = _yolo_model()
    if model is None and prefer == 'yolo':
        return None
    if model is not None:
        try:
            arr = np.frombuffer(frame, np.uint8)
            img = cv2.imdecode(arr, cv2.IMREAD_COLOR)
            if img is None:
                return None
            h0, w0 = img.shape[:2]
            k = min(1.0, 1280.0 / max(w0, h0))    # деталь не режем сильнее
            if k < 1.0:                            # 1280 — она нужна сети
                img = cv2.resize(img, (int(w0 * k), int(h0 * k)),
                                 interpolation=cv2.INTER_AREA)
            # мелкие кадры не апскейлим — пользы нет, только время
            isz = DETECT_IMGSZ if max(w0, h0) > 640 else 640
            res = model.predict(img, conf=0.20, iou=0.45, imgsz=isz,
                                verbose=False)
            dets = []
            inv = 1.0 / max(k, 1e-6)
            for r in res:
                for box in r.boxes:
                    cid = int(box.cls.item())
                    name = YOLO_CLASS_MAP.get(cid)
                    if name is None:
                        continue
                    conf = float(box.conf.item())
                    thr = (DETECT_CONF['person'] if name == 'person'
                           else DETECT_CONF['vehicle'])
                    if conf < thr:
                        continue
                    x1, y1, x2, y2 = box.xyxy[0].cpu().numpy().astype(int)
                    dets.append({'bbox': (int(x1 * inv), int(y1 * inv),
                                          int((x2 - x1) * inv),
                                          int((y2 - y1) * inv)),
                                 'cls': name, 'conf': round(conf, 2)})
            return dets, (w0, h0)
        except Exception:
            return None
    # --- фолбэк: HOG+SVM (только люди) ---
    res = people_detect(frame)
    if res is None:
        return None
    boxes, fsize = res
    return ([{'bbox': b, 'cls': 'person', 'conf': 0.6} for b in boxes],
            fsize)


# ---------------------------- ТРЕКЕР ----------------------------------------
class TrackObj:
    """Один сопровождаемый объект (человек/машина). Координаты — пиксели
    кадра, время — wall clock. Хранит скорость для предсказания позиции
    между детекциями (коастинг), чтобы человека не терять."""
    _next_id = 1

    __slots__ = ('id', 'box', 'cls', 'conf', 'vx', 'vy', 'hits', 'last_seen',
                 'born', '_coast', 'size')

    def __init__(self, box, cls, conf, now):
        self.id = TrackObj._next_id
        TrackObj._next_id += 1
        self.box = box            # (x1, y1, x2, y2)
        self.cls = cls
        self.conf = conf
        self.vx = self.vy = 0.0
        self.hits = 1
        self.last_seen = now
        self.born = now
        self._coast = 0.0         # сколько секунд двигался вслепую
        x1, y1, x2, y2 = box
        self.size = (x2 - x1) * (y2 - y1)

    def center(self):
        x1, y1, x2, y2 = self.box
        return ((x1 + x2) / 2.0, (y1 + y2) / 2.0)

    def xywh(self):
        x1, y1, x2, y2 = self.box
        return (x1, y1, x2 - x1, y2 - y1)


def _boxes_iou(a, b):
    ax1, ay1, ax2, ay2 = a
    bx1, by1, bx2, by2 = b
    ix = max(0, min(ax2, bx2) - max(ax1, bx1))
    iy = max(0, min(ay2, by2) - max(ay1, by1))
    inter = ix * iy
    uni = ((ax2 - ax1) * (ay2 - ay1) + (bx2 - bx1) * (by2 - by1) - inter)
    return inter / uni if uni > 0 else 0.0


class NeuroTracker:
    """Трекер из self60, переработанный под реальное время VMS:
      * рамки связываются по IoU + близости центров + классу + размеру;
      * между детекциями позиция предсказывается по скорости с затуханием
        (2.5 с активного коастинга, дальше — заморозка рамки);
      * трек живёт people_hold секунд после последней детекции — счёт людей
        не мигает и не обнуляется на ровном месте;
      * после «смерти» трек ещё 5 с ждёт re-id: человек пропал и появился
        рядом — получает ТОТ ЖЕ id (как будто и не терялся)."""

    MATCH_GATE = 0.15
    DIST_PX = 240.0
    REID_KEEP = 5.0
    COAST_MOVE = 2.5
    SPEED_DAMP = 0.90
    SMOOTH_BOX = 0.65     # вес НОВОЙ детекции в рамке (EMA): рваные рамки
                          # детектора не дёргают рамку на видео
    CONFIRM_ONE = 0.62    # одиночный кадр ниже этой уверенности не
                          # показывается — ждём второго (меньше ложных)

    def __init__(self):
        self.tracks = []          # живые TrackObj
        self.dead = []            # [(expire_ts, TrackObj)] — ждут re-id
        self._last_coast = 0.0

    def reset(self):
        self.tracks = []
        self.dead = []
        self._last_coast = 0.0

    # ------------------------------------------------------------------
    def coast(self, now):
        """Предсказать позиции на момент now (между детекциями)."""
        dt = max(0.0, now - self._last_coast)
        self._last_coast = now
        if dt <= 0:
            return
        for t in self.tracks:
            if t._coast >= self.COAST_MOVE:
                continue
            step = min(dt, self.COAST_MOVE - t._coast)
            k = self.SPEED_DAMP ** (dt * 3.0)
            x1, y1, x2, y2 = t.box
            t.box = (x1 + t.vx * step, y1 + t.vy * step,
                     x2 + t.vx * step, y2 + t.vy * step)
            t.vx *= k
            t.vy *= k
            t._coast += dt

    # ------------------------------------------------------------------
    def update(self, dets, now):
        """Новый кадр детекций: связать с треками, создать новые,
        умершие убрать в re-id пул. dets — от detect_people_full."""
        self.coast(now)
        pairs = []
        cand = list(self.tracks) + [d[1] for d in self.dead]
        for di, det in enumerate(dets):
            dx1, dy1, dw, dh = det['bbox']
            dbox = (dx1, dy1, dx1 + dw, dy1 + dh)
            dsize = max(1.0, float(dw * dh))
            dcx, dcy = dx1 + dw / 2.0, dy1 + dh / 2.0
            for ti, trk in enumerate(cand):
                iou = _boxes_iou(dbox, trk.box)
                tcx, tcy = trk.center()
                dist = math.hypot(dcx - tcx, dcy - tcy)
                prox = max(0.0, 1.0 - dist / self.DIST_PX)
                size_sim = 1.0 - min(1.0, abs(trk.size - dsize) /
                                     max(trk.size, dsize))
                score = iou * 2.0 + prox + size_sim * 0.4
                if det['cls'] == trk.cls:
                    score += 0.5
                elif {det['cls'], trk.cls} <= VEHICLE_CLASSES | {'person'}:
                    score -= 0.25
                if score > self.MATCH_GATE:
                    pairs.append((score, di, ti))
        pairs.sort(key=lambda p: -p[0])
        used_d, used_t = set(), set()
        revived = set()
        for score, di, ti in pairs:
            if di in used_d or ti in used_t:
                continue
            det = dets[di]
            trk = cand[ti]
            dx1, dy1, dw, dh = det['bbox']
            nbox = (dx1, dy1, dx1 + dw, dy1 + dh)
            ocx, ocy = trk.center()
            ncx, ncy = dx1 + dw / 2.0, dy1 + dh / 2.0
            # скорость сглаживаем (EMA), чтобы не прыгала от рваных рамок
            trk.vx = trk.vx * 0.35 + (ncx - ocx) * 0.65
            trk.vy = trk.vy * 0.35 + (ncy - ocy) * 0.65
            # рамку тоже сглаживаем: 65 % новой детекции + 35 % прошлой —
            # рамка не дёргается от шума детектора, но остаётся на объекте
            a = self.SMOOTH_BOX
            ox1, oy1, ox2, oy2 = trk.box
            trk.box = (ox1 + (nbox[0] - ox1) * a,
                       oy1 + (nbox[1] - oy1) * a,
                       ox2 + (nbox[2] - ox2) * a,
                       oy2 + (nbox[3] - oy2) * a)
            trk.cls = det['cls']
            trk.conf = det['conf']
            trk.hits += 1
            trk.last_seen = now
            trk._coast = 0.0
            trk.size = max(1.0, float(dw * dh))
            used_d.add(di)
            used_t.add(ti)
            if ti >= len(self.tracks):        # оживлённый из dead-пула
                revived.add(ti)
        if revived:
            base = len(self.tracks)
            self.dead = [d for i, d in enumerate(self.dead)
                         if base + i not in revived]
            self.tracks.extend(cand[ti] for ti in sorted(revived))
        for di, det in enumerate(dets):
            if di not in used_d:
                dx1, dy1, dw, dh = det['bbox']
                self.tracks.append(TrackObj((dx1, dy1, dx1 + dw, dy1 + dh),
                                            det['cls'], det['conf'], now))
        return [t for t in self.tracks if t.hits >= 1]

    # ------------------------------------------------------------------
    def alive(self, now, hold, cls=None):
        """Живые треки: подтверждённые (hits >= 2 или высокая уверенность)
        и виденные не позже hold секунд назад."""
        out = []
        for t in self.tracks:
            if cls and t.cls != cls:
                continue
            if now - t.last_seen > hold:
                continue
            if t.hits < 2 and t.conf < self.CONFIRM_ONE:
                continue
            out.append(t)
        return out

    def alive_count(self, now, hold, cls='person'):
        return len(self.alive(now, hold, cls))

    def cull(self, now, hold):
        """Убрать окончательно потерянные треки: сначала в re-id пул,
        через REID_KEEP секунд — насовсем."""
        still, gone = [], []
        for t in self.tracks:
            if now - t.last_seen > hold:
                gone.append(t)
            else:
                still.append(t)
        self.tracks = still
        self.dead = [d for d in self.dead if d[0] > now]
        for t in gone:
            self.dead.append((now + self.REID_KEEP, t))
        self.dead = [d for d in self.dead if d[0] > now]
        return len(gone)


class AnalyticsEngine:
    """Анализатор одной камеры: подписывается на StreamHub и детектирует
    движение, затемнение/засветку, смену сцены, расфокус, потерю сигнала."""

    def __init__(self, ip):
        self.ip = ip
        self._stop = threading.Event()
        self.prev = None            # предыдущий полутоновый кадр
        self.last_analysis = 0.0
        self.motion_until = 0.0     # до какого времени показывать индикатор
        self.last_event = {}        # type -> ts последнего события
        self.dark_since = None
        self.bright_since = None
        self.blur_since = None
        self.no_frame_since = None
        self.sub_stream = None
        self.person_since = None    # ts начала непрерывного присутствия
        self.person_last = 0.0      # ts последнего кадра с движением
        self.people_now = 0         # людей сейчас (детектор+трекер; 0 = не видно)
        self.vehicles_now = 0       # машин сейчас (YOLO: car/truck/bus/moto)
        self.people_ok = False      # True после первого успешного прогона детектора
        self.people_last = 0.0      # ts последнего прогона детектора
        self.tracker = NeuroTracker()   # трекер: человека не теряем между кадрами
        self.people_boxes = []      # рамки людей (x,y,w,h) для зон/отладки
        self.det_boxes = []        # рамки людей И машин (нормированные 0..1)
                                   # для наложения на видео в интерфейсе
        self._fsize = None         # (W, H) последнего кадра детектора
        self.person_present_until = 0.0   # до какого ts в кадре есть человек
        self.detector_mode = '—'   # yolo | hog | —
        self.motion_nopeople_since = None   # движение есть, человек не подтверждён
        self.session_max_people = 0  # максимум людей за сессию присутствия
        self.stats = {'motion': 0, 'scene': 0, 'tamper': 0, 'signal': 0,
                      'last_motion': 0.0, 'started': time.time(),
                      'visits': 0, 'presence_time': 0.0, 'last_left': 0.0}

    # ------------------------------------------------------------------
    def config(self):
        cfg = dict(ANALYTICS_DEFAULTS)
        with STATE.lock:
            cam = STATE.cameras.get(self.ip) or {}
            cfg.update(cam.get('analytics') or {})
        return cfg

    def stop(self):
        self._stop.set()

    # ------------------------------------------------------------------
    def run(self):
        if ANALYTICS_BACKEND == 'off':
            return
        st = None
        last_id = -1
        while not self._stop.is_set():
            try:
                if self.ip not in STATE.cameras:
                    break
                st_now = hub_get(self.ip)   # создать при необходимости:
                                             # аналитика сама держит поток
                if st_now is None:
                    # поток не создан (нет RTSP URL) — потеря сигнала
                    self._check_signal_loss()
                    time.sleep(1.0)
                    continue
                if st_now is not st:
                    # поток пересоздан (watchdog/переподключение)
                    if st is not None:
                        try:
                            st.unsubscribe()
                        except Exception:
                            pass
                    st = st_now
                    last_id = -1
                    self.prev = None
                    self.sub_stream = st
                    st.subscribe()
                frame, last_id = st.wait_frame(last_id, timeout=5)
                if frame is None:
                    self._check_signal_loss()
                    self.det_boxes = []   # кадров нет — рамки не висят в воздухе
                    continue
                self.no_frame_since = None
                now = time.time()
                cfg = self.config()
                if not cfg.get('enabled'):
                    # аналитику выключили — корректно закрываем сессию
                    self._close_presence(now, reason='аналитика отключена')
                    self.det_boxes = []
                    time.sleep(1.0)
                    continue
                if now - self.last_analysis < 1.0 / max(1, int(cfg.get('analysis_fps', 3))):
                    continue
                self.last_analysis = now
                self._process(frame, cfg, now)
            except Exception as e:
                LOG.add('error', f'Аналитика {self.ip}: {e}', self.ip)
                time.sleep(2)
        if st is not None:
            try:
                st.unsubscribe()
            except Exception:
                pass
        # движок останавливается — не теряем незакрытую сессию присутствия
        self._close_presence(time.time(), reason='аналитика остановлена')

    # ------------------------------------------------------------------
    def _check_signal_loss(self):
        now = time.time()
        if self.no_frame_since is None:
            self.no_frame_since = now
            return
        cfg = self.config()
        if cfg.get('enabled') and now - self.no_frame_since > 30:
            self._emit('signal_loss', cfg, now, note='нет кадров более 30 с')
            self._close_presence(now, reason='нет сигнала')
            # следующая проверка не раньше чем через 5 минут
            self.no_frame_since = now + 300

    # ------------------------------------------------------------------
    def _process(self, frame, cfg, now):
        gray = analytics_decode_gray(frame)
        if gray is None:
            return
        lum = float(gray.mean())
        sharp = analytics_sharpness(gray)
        ratio = 0.0          # доля изменений в области контроля (или в кадре)
        ratio_full = 0.0     # доля изменений по всему кадру (для смены сцены)
        zpts = _zone_points(cfg)
        if self.prev is not None and self.prev.shape == gray.shape:
            diff = np.abs(gray.astype(np.int16) - self.prev.astype(np.int16))
            mask = diff > 26                       # порог пиксельного шума
            ratio_full = float(mask.mean())
            if zpts is not None:
                # область контроля: считаем изменения только внутри полигона
                # (доля нормируется на площадь области — чувствительность
                # из настройки остаётся осмысленной при любой зоне)
                zm = _zone_mask(zpts, gray.shape)
                area = float(zm.sum())
                if area >= 8:
                    ratio = float((mask & zm).sum()) / area
                else:                # зона выродилась в линию — весь кадр
                    ratio = ratio_full
            else:
                ratio = ratio_full
        self.prev = gray

        # --- движение / смена сцены ---
        motion = ratio >= float(cfg.get('sensitivity', 0.10))

        # --- детектор людей (YOLO локально / HOG) + трекер из self60:
        #     подтверждает, что движется именно человек, считает людей и
        #     проверяет область по точке «ступней».
        #     ГЛАВНОЕ: детектор работает не только при движении — пока трекер
        #     держит человека (people_hold), поиск продолжается каждый кадр,
        #     между детекциями позиция предсказывается по скорости. Человек
        #     не теряется из-за одного плохого кадра. ---
        hold = min(30.0, max(2.0, float(cfg.get('people_hold', 6))))
        if cfg.get('person_detect', True):
            pfps = min(3, max(1, int(cfg.get('person_fps', 2))))
            tracking = self.tracker.alive_count(now, hold) > 0
            if (motion or tracking) and now - self.people_last >= 1.0 / pfps:
                self.people_last = now
                res = detect_people_full(frame,
                                         prefer=cfg.get('detector', 'auto'))
                if res is None:
                    self.people_ok = False      # детектор недоступен
                else:
                    self.people_ok = True
                    dets, fsize = res
                    self._fsize = fsize
                    self.detector_mode = DETECT_INFO.get('mode', '—')
                    self.tracker.update(dets, now)
            self.tracker.cull(now, hold)
            self.tracker.coast(now)
            persons = [t for t in self.tracker.alive(now, hold, 'person')]
            vehicles = [t for t in self.tracker.alive(now, hold)
                        if t.cls in VEHICLE_CLASSES]
            self.people_boxes = [t.xywh() for t in persons]
            self.vehicles_now = len(vehicles)
            self.people_now = (_zone_person_inside(zpts, self._fsize,
                                                   self.people_boxes)
                               if zpts is not None and self._fsize
                               else len(persons))
            # нормированные рамки всех сопровождаемых объектов — фронтенд
            # рисует их поверх видео (люди — сплошные красные, машины —
            # жёлтые пунктирные, как «умная парковка»)
            if self._fsize:
                fw, fh = self._fsize

                def _norm_box(t):
                    x, y, w, h = t.xywh()
                    return {'c': t.cls, 'i': t.id,
                            'b': [max(0., round(x / fw, 4)),
                                  max(0., round(y / fh, 4)),
                                  min(1., round(w / fw, 4)),
                                  min(1., round(h / fh, 4))]}
                self.det_boxes = [_norm_box(t)
                                  for t in (persons + vehicles)][:24]
            else:
                self.det_boxes = []
        else:
            self.people_now = 0
            self.vehicles_now = 0
            self.det_boxes = []
            if self.tracker.tracks:
                self.tracker.reset()
        if self.people_now > 0:
            # человек в кадре: индикация плиток/полного экрана (красное)
            self.person_present_until = now + 5.0

        if motion:
            self.motion_until = now + 10
            if ratio_full < 0.75:
                note = ''
                if zpts is not None:
                    note = (f'человек в области: {self.people_now}'
                            if self.people_now else 'в области контроля')
                elif self.people_now:
                    note = f'человек: {self.people_now}'
                if self.vehicles_now:
                    note += f' · машин: {self.vehicles_now}'
                self._emit('motion', cfg, now, ratio=ratio, note=note,
                           people=self.people_now)
            else:
                self._emit('scene', cfg, now, ratio=ratio_full,
                           note='кадр изменился почти полностью')

        # --- приход / уход: время присутствия ---
        # сессия открывается подтверждённым появлением человека; если
        # детектор недоступен/не видел человека — фолбэк на движение,
        # но с задержкой 6 с (животное/тень/качание веток не пишутся)
        detector_armed = bool(cfg.get('person_detect', True)) and self.people_ok
        if cfg.get('presence', True):
            if motion:
                if detector_armed and self.people_now == 0:
                    if self.motion_nopeople_since is None:
                        self.motion_nopeople_since = now
                else:
                    self.motion_nopeople_since = None
                confirmed = (self.people_now > 0 or not detector_armed or
                             (self.motion_nopeople_since is not None and
                              now - self.motion_nopeople_since > 6))
                if confirmed:
                    if self.person_since is None:
                        self.person_since = now
                        self.session_max_people = self.people_now
                        note = 'появление движения в кадре'
                        if detector_armed and self.people_now:
                            note = (f'человек в области контроля: '
                                    f'{self.people_now}'
                                    if zpts is not None
                                    else f'человек в кадре: {self.people_now}')
                        elif zpts is not None:
                            note = 'появление в области контроля'
                        self._emit('person_enter', cfg, now, ratio=ratio,
                                   note=note, cooldown=3,
                                   people=self.people_now or None)
                        self._zone_record_update(now, present=True)
                    elif self.people_now > self.session_max_people:
                        self.session_max_people = self.people_now
                    self.person_last = now
            else:
                self.motion_nopeople_since = None
                if (self.person_since is not None and
                        now - self.person_last >=
                        float(cfg.get('presence_gap', 12))):
                    self._close_presence(now)

        # --- перекрытие объектива (затемнение) ---
        if cfg.get('tamper_dark', True):
            if lum < 22:
                if self.dark_since is None:
                    self.dark_since = now
                elif now - self.dark_since > 8:
                    self._emit('tamper_dark', cfg, now,
                               note='изображение почти чёрное')
                    self.dark_since = now + 120   # кулдаун типа
            else:
                self.dark_since = None

        # --- засветка ---
        if cfg.get('tamper_bright', True):
            if lum > 243:
                if self.bright_since is None:
                    self.bright_since = now
                elif now - self.bright_since > 8:
                    self._emit('tamper_bright', cfg, now,
                               note='изображение пересвечено')
                    self.bright_since = now + 120
            else:
                self.bright_since = None

        # --- расфокус ---
        if cfg.get('defocus', False):
            if sharp < 4.0:
                if self.blur_since is None:
                    self.blur_since = now
                elif now - self.blur_since > 12:
                    self._emit('defocus', cfg, now, note='низкая резкость')
                    self.blur_since = now + 300
            else:
                self.blur_since = None

    # ------------------------------------------------------------------
    def _close_presence(self, now, reason=''):
        """Зафиксировать уход: закрыть сессию присутствия событием
        person_left (время ухода = последний кадр с движением)."""
        if self.person_since is None:
            return
        cfg = self.config()
        dur = max(0.0, self.person_last - self.person_since)
        note = 'присутствие ' + _fmt_duration(dur)
        if self.session_max_people > 1:
            note += f' · до {self.session_max_people} чел.'
        if reason:
            note += ' · ' + reason
        self._emit('person_left', cfg, now, note=note, cooldown=3,
                   dur=round(dur, 1), since=self.person_since,
                   until=self.person_last,
                   people=self.session_max_people or None)
        # сессия уходит в суточный журнал присутствия (архивный плеер
        # показывает «когда были люди» даже после перезапуска сервера)
        presence_log_append(self.ip, self.person_since,
                            self.person_last, dur)
        self.person_since = None
        self.people_now = 0
        self.vehicles_now = 0
        self.det_boxes = []
        self.person_present_until = 0.0
        self.tracker.reset()
        self.session_max_people = 0
        self._zone_record_update(now, present=False)

    # ------------------------------------------------------------------
    def _zone_record_update(self, now, present):
        """Запись по области (как у TRASSIR): человек появился в области —
        включить запись архива; ушёл — остановить через zone_hold секунд.
        Работает только когда задана область и включён режим zone_record."""
        try:
            cfg = self.config()
            if not (_zone_points(cfg) and cfg.get('zone_record')):
                return
            if not FFMPEG_AVAILABLE:
                return
            with REC_LOCK:
                rec = STATE.recordings.get(self.ip)
            if present:
                if rec is None:
                    r = start_recording_core(self.ip)
                    if r.get('status') == 'ok':
                        with REC_LOCK:
                            rec = STATE.recordings.get(self.ip)
                            if rec is not None:
                                rec['zone'] = True
                                rec['zone_stop_after'] = None
                        LOG.add('success',
                                'Человек в области контроля — запись включена',
                                self.ip)
            elif rec is not None and rec.get('zone'):
                hold = min(300, max(5, int(cfg.get('zone_hold', 15))))
                with REC_LOCK:
                    if STATE.recordings.get(self.ip) is rec:
                        rec['zone_stop_after'] = now + hold
                LOG.add('info', 'Область покинута — запись остановится '
                                f'через {hold} с', self.ip)
        except Exception as e:
            LOG.add('error', f'Запись по области {self.ip}: {e}', self.ip)

    # ------------------------------------------------------------------
    def _emit(self, etype, cfg, now, ratio=0.0, note='', cooldown=None,
              dur=None, since=None, until=None, people=None):
        cd = int(cfg.get('min_interval', 20)) if cooldown is None else cooldown
        if now - self.last_event.get(etype, 0) < cd:
            # движение продолжается: продлеваем индикацию без нового события
            if etype == 'motion':
                self.stats['last_motion'] = now
                self.motion_until = max(self.motion_until, now + 6)
            return
        self.last_event[etype] = now
        snap = None
        if cfg.get('snapshots', True):
            st = self.sub_stream or hub_get(self.ip, create=False)
            if st:
                fr = st.latest_frame()
                if fr:
                    snap = (f'an_{_safe_ip(self.ip)}_'
                            f'{datetime.now().strftime("%Y%m%d_%H%M%S")}.jpg')
                    try:
                        with open(os.path.join(SNAPSHOT_DIR, snap), 'wb') as f:
                            f.write(fr)
                    except Exception:
                        snap = None
        with ANALYTICS_LOCK:
            ev = {'id': _an_ev_id[0], 'ts': now, 'ip': self.ip,
                  'type': etype, 'ratio': round(ratio, 3),
                  'snap': snap, 'note': note}
            if people:
                ev['people'] = int(people)
            if dur is not None:
                ev['dur'] = dur
                ev['since'] = round(since or now, 1)
                ev['until'] = round(until or now, 1)
            _an_ev_id[0] += 1
            ANALYTICS_EVENTS.append(ev)
        key = {'tamper_dark': 'tamper', 'tamper_bright': 'tamper'}.get(etype, etype)
        if key in self.stats:
            self.stats[key] += 1
        if etype == 'motion':
            self.stats['last_motion'] = now
        if etype == 'person_enter':
            self.stats['visits'] += 1
        if etype == 'person_left':
            self.stats['last_left'] = now
            self.stats['presence_time'] += float(dur or 0.0)
        msg = ANALYTICS_LABELS.get(etype, etype)
        if note:
            msg += f' ({note})'
        if ratio:
            msg += f' — интенсивность {ratio * 100:.0f}%'
        lvl = {'motion': 'success', 'scene': 'warn', 'tamper_dark': 'error',
               'tamper_bright': 'error', 'defocus': 'warn',
               'signal_loss': 'error', 'person_enter': 'success',
               'person_left': 'info'}.get(etype, 'info')
        LOG.add(lvl, 'Аналитика: ' + msg, self.ip)


def analytics_supervisor():
    """Запуск/остановка движков аналитики в зависимости от настроек камер."""
    while True:
        try:
            with STATE.lock:
                cams = {ip: bool((c.get('analytics') or {}).get('enabled'))
                        for ip, c in STATE.cameras.items()}
            with ANALYTICS_LOCK:
                engines = dict(ANALYTICS_ENGINES)
            for ip, on in cams.items():
                eng = engines.get(ip)
                if on and eng is None and ANALYTICS_BACKEND != 'off':
                    e = AnalyticsEngine(ip)
                    with ANALYTICS_LOCK:
                        ANALYTICS_ENGINES[ip] = e
                    threading.Thread(target=e.run, daemon=True,
                                     name=f'analytics-{ip}').start()
                    LOG.add('info', 'Аналитика запущена', ip)
                elif not on and eng is not None:
                    eng.stop()
                    with ANALYTICS_LOCK:
                        ANALYTICS_ENGINES.pop(ip, None)
            for ip, eng in engines.items():
                if ip not in cams:
                    eng.stop()
                    with ANALYTICS_LOCK:
                        ANALYTICS_ENGINES.pop(ip, None)
        except Exception as e:
            LOG.add('error', f'Супервизор аналитики: {e}')
        time.sleep(4)


def _zone_rec_pass():
    """Один проход контроля записей, запущенных по области контроля:
    остановка после ухода человека (zone_hold с) или при выключении
    режима/удалении зоны. Обычные записи не трогает."""
    stops = []
    with STATE.lock:
        cams = {ip: (c.get('analytics') or {})
                for ip, c in STATE.cameras.items()}
    with REC_LOCK:
        zone_recs = [(ip, rec) for ip, rec in STATE.recordings.items()
                     if rec.get('zone')]
    for ip, rec in zone_recs:
        cfg = cams.get(ip) or {}
        stop, why = None, ''
        if not (_zone_points(cfg) and cfg.get('zone_record')):
            stop, why = True, 'режим записи по области выключен'
        elif (rec.get('zone_stop_after') and
                time.time() > rec['zone_stop_after']):
            stop, why = True, 'человек покинул область'
        if stop:
            stop_recording_core(ip)
            LOG.add('info', f'Запись по области остановлена: {why}', ip)
            stops.append((ip, why))
    return stops


def zone_rec_supervisor():
    """Супервизор записи по области контроля (периодический проход)."""
    while True:
        time.sleep(3)
        try:
            _zone_rec_pass()
        except Exception:
            pass


# ============================================================================
#  РАСПОЗНАВАНИЕ АВТОМОБИЛЬНЫХ НОМЕРОВ (ANPR / ALPR)
#  Конвейер из трёх стадий (как в профессиональных ALPR):
#    1) локализация: Haar-каскад + контуры по вертикальным градиентам
#       (Sobel) — ловит грязные/ночные/под углом номера, которые
#       пропускает каскад; кандидаты объединяются (NMS);
#    2) OCR: Tesseract по нескольким вариантам бинаризации кадра номера
#       (день/ночь/грязь) — побеждает лучшее чтение;
#    3) голосование кадров: номер объявляется, когда 2+ кадра согласились,
#       бонус к уверенности за совпадение с форматом российских номеров.
#  Подписывается на StreamHub — дополнительной RTSP-нагрузки на камеру нет.
# ============================================================================

ANPR_DEFAULTS = {
    'enabled': False,
    'analysis_fps': 2,         # частота детекции (1..5)
    'min_confidence': 60,      # мин. итоговая уверенность (0..99)
    'min_interval': 30,       # кулдаун на тот же номер, сек
    'save_snapshots': True,
}

ANPR_LABELS = {}

ANPR_LOCK = threading.RLock()
ANPR_EVENTS = deque(maxlen=1000)
ANPR_ENGINES = {}              # ip -> ANPREngine
ANPR_SEEN = {}                 # norm_plate -> last_ts (дедупликация)
_anpr_ev_id = [1]

# Поиск Haar-каскада для российских/европейских номеров
_ANPR_CASCADE_PATH = None
if _CV2:
    for _cand in [
        # Стандартные пути OpenCV data
        os.path.join(os.path.dirname(_cv2_mod.__file__), 'data',
                     'haarcascade_russian_plate_number.xml'),
        os.path.join(os.path.dirname(_cv2_mod.__file__), 'data',
                     'haarcascade_license_plate_rus_16stages.xml'),
        # Системные пути Linux
        '/usr/share/opencv4/haarcascades/haarcascade_russian_plate_number.xml',
        '/usr/share/opencv/haarcascades/haarcascade_russian_plate_number.xml',
        # Рядом со скриптом
        os.path.join(BASE_DIR, 'haarcascade_russian_plate_number.xml'),
    ]:
        if _cand and os.path.isfile(_cand):
            _ANPR_CASCADE_PATH = _cand
            break

# Инициализация Tesseract (через pytesseract)
try:
    import pytesseract as _pytesseract
    _PYTESSERACT = True
    # Проверяем, что сам tesseract бинарник доступен
    try:
        _pytesseract.get_tesseract_version()
    except Exception:
        _PYTESSERACT = False
except Exception:
    _PYTESSERACT = False

ANPR_BACKEND = ('cv2+tesseract' if (_CV2 and _PYTESSERACT)
                else ('cv2-detect' if _CV2 else 'off'))

# Форматы российских номеров (буквы — латинская транслитерация
# разрешённого алфавита АВЕКМНОРСТУХ)
_ANPR_RE_T1 = re.compile(r'^[ABEKMHOPCTYX]\d{3}[ABEKMHOPCTYX]{2}\d{2,3}$')
_ANPR_RE_T2 = re.compile(r'^[ABEKMHOPCTYX]{2}\d{6,7}$')
_ANPR_ALPHABET = 'ABEKMHOPCTYX0123456789'


def _anpr_normalize_plate(text):
    """Нормализация текста номера: только буквы/цифры, верхний регистр,
    латиница из кириллицы (для российских номеров часто путают О↔0, В↔8)."""
    if not text:
        return ''
    # Кириллица → латиница (российский стандарт: A В Е К М Н О Р С Т У Х)
    tr = str.maketrans('АВЕКМНОРСТУХавекмнорстух', 'ABEKMHOPCTYXabekmhopctyx')
    s = text.translate(tr)
    # Убираем всё кроме латиницы и цифр
    s = re.sub(r'[^A-Za-z0-9]', '', s).upper()
    return s


def _anpr_plate_score(norm, ocr_conf):
    """Итоговая уверенность чтения (0..99): уверенность OCR + бонус за
    совпадение с форматом российского номера. Проверка формата резко
    снижает путаницу похожих символов (В↔8, О↔0, Н↔11)."""
    if not norm:
        return 0
    if _ANPR_RE_T1.match(norm):
        bonus = 45                      # тип 1: А123ВС77 / 777
    elif _ANPR_RE_T2.match(norm):
        bonus = 35                      # прицеп/грузовой: АВ123477
    elif 8 <= len(norm) <= 9:
        bonus = 12                      # похоже на номер по длине
    elif 6 <= len(norm) <= 10:
        bonus = 5
    else:
        bonus = 0
    return int(min(99, ocr_conf // 2 + bonus))


def _anpr_similar(a, b):
    """Похожи ли два чтения настолько, что это один и тот же номер:
    совпадение, вхождение одного в другого или одна замена символа
    (типичные ошибки OCR: О↔0, В↔8, усечение последней пары цифр)."""
    if not a or not b:
        return False
    if a == b:
        return True
    if len(a) >= 5 and len(b) >= 5 and \
            (a.startswith(b) or b.startswith(a)):
        return True
    if len(a) == len(b):
        return sum(1 for x, y in zip(a, b) if x != y) <= 1
    return False


def _anpr_iou(a, b):
    """Пересечение по объединению двух рамок (x, y, w, h)."""
    ax, ay, aw, ah = a
    bx, by, bw, bh = b
    ix = max(0, min(ax + aw, bx + bw) - max(ax, bx))
    iy = max(0, min(ay + ah, by + bh) - max(ay, by))
    inter = ix * iy
    uni = aw * ah + bw * bh - inter
    return inter / uni if uni > 0 else 0.0


def _anpr_find_plates(img, cascade):
    """Поиск номеров: Haar-каскад + контурная локализация по вертикальным
    градиентам (Sobel + морфология). Кандидаты объединяются (NMS).
    Возвращает до 4 рамок (x, y, w, h), крупнейшие первыми."""
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    H, W = gray.shape
    cands = []
    if cascade is not None:
        try:
            rects = cascade.detectMultiScale(
                gray, scaleFactor=1.06, minNeighbors=4,
                minSize=(max(48, W // 24), 14),
                maxSize=(max(80, int(W * 0.9)), 400))
            cands = [tuple(int(v) for v in r) for r in rects]
        except Exception:
            pass
    # контуры: у номеров сильный отклик вертикальных градиентов
    # (тонкие чёрные символы на белом поле) и вытянутая форма ~4.5:1
    try:
        sx = cv2.convertScaleAbs(cv2.Sobel(gray, cv2.CV_16S, 1, 0, ksize=3))
        _, bwm = cv2.threshold(sx, 0, 255,
                               cv2.THRESH_BINARY + cv2.THRESH_OTSU)
        bwm = cv2.morphologyEx(
            bwm, cv2.MORPH_CLOSE,
            cv2.getStructuringElement(cv2.MORPH_RECT, (17, 5)))
        contours, _ = cv2.findContours(bwm, cv2.RETR_EXTERNAL,
                                       cv2.CHAIN_APPROX_SIMPLE)
        for cnt in contours:
            x, y, w, h = cv2.boundingRect(cnt)
            if w < max(48, W // 22) or h < 13 or h > W:
                continue
            ar = w / float(h)
            if not (1.7 <= ar <= 7.0):
                continue
            if cv2.contourArea(cnt) < 0.45 * w * h:
                continue
            cands.append((int(x), int(y), int(w), int(h)))
    except Exception:
        pass
    cands.sort(key=lambda b: -b[2] * b[3])
    out = []
    for c in cands:
        if all(_anpr_iou(c, k) < 0.3 for k in out):
            out.append(c)
    return out[:4]


def _anpr_preprocess_variants(plate_img):
    """Подготовка изображения номера к OCR: увеличение, билатеральный
    фильтр и несколько вариантов бинаризации (разные блоки/полярности).
    Номер бывает тёмным на белом (день) или белым на тёмном (нить/ночь) —
    Tesseract читает каждый вариант, побеждает лучшее чтение."""
    try:
        g = cv2.cvtColor(plate_img, cv2.COLOR_BGR2GRAY)
        h, w = g.shape
        if w < 320:
            k = 320.0 / max(1, w)
            g = cv2.resize(g, None, fx=k, fy=k,
                           interpolation=cv2.INTER_CUBIC)
        g = cv2.bilateralFilter(g, 7, 90, 90)
        out = []
        for block in (21, 31):
            for sign in (cv2.THRESH_BINARY, cv2.THRESH_BINARY_INV):
                out.append(cv2.adaptiveThreshold(
                    g, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C, sign, block, 3))
        _, otsu = cv2.threshold(g, 0, 255,
                                cv2.THRESH_BINARY + cv2.THRESH_OTSU)
        out.append(cv2.bitwise_not(otsu))
        return out[:5]
    except Exception:
        return []


def _anpr_ocr_variants(plate_img):
    """OCR номера по всем вариантам бинаризации.
    Возвращает [(нормализованный текст, уверенность), ...] по убыванию."""
    res = []
    for v in _anpr_preprocess_variants(plate_img):
        try:
            custom = ('--oem 3 --psm 7 -c tessedit_char_whitelist='
                      + _ANPR_ALPHABET)
            data = _pytesseract.image_to_data(
                v, config=custom, output_type=_pytesseract.Output.DICT,
                lang='eng')
            parts, confs = [], []
            for t, c in zip(data.get('text', []), data.get('conf', [])):
                t = (t or '').strip()
                if not t:
                    continue
                parts.append(t)
                try:
                    ci = int(float(c))
                    if ci >= 0:
                        confs.append(ci)
                except (TypeError, ValueError):
                    pass
            if not parts:
                continue
            norm = _anpr_normalize_plate(''.join(parts))
            if len(norm) < 5:
                continue
            ocr_conf = sum(confs) // len(confs) if confs else 0
            res.append((norm, _anpr_plate_score(norm, ocr_conf)))
        except Exception:
            continue
    res.sort(key=lambda r: -r[1])
    return res


class ANPREngine:
    """Распознаватель автомобильных номеров одной камеры."""

    def __init__(self, ip):
        self.ip = ip
        self._stop = threading.Event()
        self.cascade = None
        if _ANPR_CASCADE_PATH:
            try:
                self.cascade = cv2.CascadeClassifier(_ANPR_CASCADE_PATH)
            except Exception:
                self.cascade = None
        self.last_analysis = 0.0
        self.sub_stream = None
        self.tracks = {}          # id трека -> голоса OCR по тексту номера
        self._track_seq = 0
        self.stats = {'frames': 0, 'detected': 0, 'recognized': 0,
                      'started': time.time()}

    def config(self):
        cfg = dict(ANPR_DEFAULTS)
        with STATE.lock:
            cam = STATE.cameras.get(self.ip) or {}
            cfg.update(cam.get('anpr') or {})
        return cfg

    def stop(self):
        self._stop.set()

    def run(self):
        if ANPR_BACKEND == 'off':
            return
        st = None
        last_id = -1
        while not self._stop.is_set():
            try:
                if self.ip not in STATE.cameras:
                    break
                st_now = hub_get(self.ip)
                if st_now is None:
                    time.sleep(1.0)
                    continue
                if st_now is not st:
                    if st is not None:
                        try:
                            st.unsubscribe()
                        except Exception:
                            pass
                    st = st_now
                    last_id = -1
                    self.sub_stream = st
                    st.subscribe()
                frame, last_id = st.wait_frame(last_id, timeout=5)
                if frame is None:
                    continue
                now = time.time()
                cfg = self.config()
                if not cfg.get('enabled'):
                    time.sleep(1.0)
                    continue
                fps = max(1, int(cfg.get('analysis_fps', 2)))
                if now - self.last_analysis < 1.0 / fps:
                    continue
                self.last_analysis = now
                self.stats['frames'] += 1
                self._process(frame, cfg, now)
            except Exception as e:
                LOG.add('error', f'ANPR {self.ip}: {e}', self.ip)
                time.sleep(2)
        if st is not None:
            try:
                st.unsubscribe()
            except Exception:
                pass

    def _process(self, frame_bytes, cfg, now):
        """Кадр -> кандидаты в номера -> OCR по вариантам -> голосование
        треков -> событие (номер объявляется со 2-го согласного кадра)."""
        try:
            arr = np.frombuffer(frame_bytes, np.uint8)
            img = cv2.imdecode(arr, cv2.IMREAD_COLOR)
            if img is None:
                return
        except Exception:
            return
        if _PYTESSERACT:
            boxes = _anpr_find_plates(img, self.cascade)
        else:                        # без OCR треки не имеют смысла
            boxes = []
        if not boxes:
            return
        H, W = img.shape[:2]
        for (x, y, w, h) in boxes[:2]:      # не более 2 кандидатов на кадр
            self.stats['detected'] += 1
            # вырезаем область номера с небольшим запасом
            pad = max(3, int(0.05 * w))
            x0, y0 = max(0, x - pad), max(0, y - pad)
            x1 = min(W, x + w + pad)
            y1 = min(H, y + h + pad)
            plate_img = img[y0:y1, x0:x1]
            if plate_img.size == 0:
                continue
            reads = [r for r in _anpr_ocr_variants(plate_img) if r[1] >= 25]
            if not reads:
                continue
            best_norm, best_score = reads[0]
            # трек: тот же номер по тексту или по геометрии рамки
            tid = None
            for t, tr in list(self.tracks.items()):
                if now - tr['last'] > 8.0:      # трек протух — выбываем
                    del self.tracks[t]
                    continue
                if (best_norm in tr['votes'] or
                        _anpr_iou((x, y, w, h), tr['bbox']) > 0.25):
                    tid = t
                    break
            if tid is None:
                tid = self._track_seq
                self._track_seq += 1
                self.tracks[tid] = {'votes': {}, 'bbox': None, 'last': 0.0,
                                    'best': ('', 0), 'snap_box': None}
            tr = self.tracks[tid]
            tr['votes'][best_norm] = tr['votes'].get(best_norm, 0) + 1
            tr['bbox'] = (x, y, w, h)
            tr['last'] = now
            tr['snap_box'] = (x0, y0, x1, y1)
            if best_score > tr['best'][1]:
                tr['best'] = (best_norm, best_score)
            # номер объявляется, когда 2+ кадра согласились — это
            # убирает одиночные мусорные чтения (основной источник ошибок);
            # при равенстве голосов побеждает более длинное чтение
            total = sum(tr['votes'].values())
            top_norm, top_cnt = max(tr['votes'].items(),
                                     key=lambda kv: (kv[1], len(kv[0])))
            if top_cnt < 2 or total < 2:
                continue
            score = max(tr['best'][1], _anpr_plate_score(top_norm, 70))
            if score < int(cfg.get('min_confidence', 60)):
                continue
            # дедупликация: тот же (или похожий — OCR иногда читает номер
            # с усечением/заменой символа) номер в течение кулдауна — пропуск
            with ANPR_LOCK:
                cd = int(cfg.get('min_interval', 30))
                dup = any(now - v < cd and _anpr_similar(top_norm, k)
                          for k, v in ANPR_SEEN.items())
                if dup:
                    self.tracks.pop(tid, None)
                    continue
                ANPR_SEEN[top_norm] = now
                if len(ANPR_SEEN) > 800:   # не растём вечно
                    cut = now - 3600
                    for k in [k for k, v in ANPR_SEEN.items() if v < cut]:
                        del ANPR_SEEN[k]
            conf = int(min(99, score + 3 * (top_cnt - 2)))  # бонус согласия
            self.stats['recognized'] += 1
            snap_name = None
            if cfg.get('save_snapshots', True):
                snap_name = (f'anpr_{_safe_ip(self.ip)}_'
                             f'{datetime.now().strftime("%Y%m%d_%H%M%S")}_'
                             f'{top_norm}.jpg')
                try:
                    out_img = img.copy()
                    bx0, by0, bx1, by1 = tr['snap_box'] or (x0, y0, x1, y1)
                    cv2.rectangle(out_img, (bx0, by0), (bx1, by1),
                                  (0, 255, 80), 3)
                    cv2.putText(out_img, top_norm, (bx0, max(0, by0 - 8)),
                                cv2.FONT_HERSHEY_SIMPLEX, 1.0,
                                (0, 255, 80), 2, cv2.LINE_AA)
                    _, buf = cv2.imencode('.jpg', out_img,
                                          [cv2.IMWRITE_JPEG_QUALITY, 88])
                    with open(os.path.join(SNAPSHOT_DIR, snap_name), 'wb') as f:
                        f.write(buf.tobytes())
                except Exception:
                    snap_name = None
            with ANPR_LOCK:
                ev = {'id': _anpr_ev_id[0], 'ts': now, 'ip': self.ip,
                      'plate': top_norm, 'raw': best_norm, 'conf': conf,
                      'votes': int(top_cnt), 'snap': snap_name,
                      'bbox': [int(x), int(y), int(w), int(h)]}
                _anpr_ev_id[0] += 1
                ANPR_EVENTS.append(ev)
            LOG.add('success',
                    f'ANPR: распознан номер {top_norm} ({conf}%, '
                    f'{top_cnt} кадра)', self.ip)
            self.tracks.pop(tid, None)
            break       # один номер на кадр достаточно


def anpr_supervisor():
    """Запуск/остановка ANPR-движков по настройкам камер."""
    while True:
        try:
            with STATE.lock:
                cams = {ip: bool((c.get('anpr') or {}).get('enabled'))
                        for ip, c in STATE.cameras.items()}
            with ANPR_LOCK:
                engines = dict(ANPR_ENGINES)
            for ip, on in cams.items():
                eng = engines.get(ip)
                if on and eng is None and ANPR_BACKEND != 'off':
                    e = ANPREngine(ip)
                    with ANPR_LOCK:
                        ANPR_ENGINES[ip] = e
                    threading.Thread(target=e.run, daemon=True,
                                     name=f'anpr-{ip}').start()
                    LOG.add('info', 'ANPR запущен', ip)
                elif not on and eng is not None:
                    eng.stop()
                    with ANPR_LOCK:
                        ANPR_ENGINES.pop(ip, None)
            for ip, eng in engines.items():
                if ip not in cams:
                    eng.stop()
                    with ANPR_LOCK:
                        ANPR_ENGINES.pop(ip, None)
        except Exception as e:
            LOG.add('error', f'Супервизор ANPR: {e}')
        time.sleep(5)


def _anpr_public():
    today0 = datetime.now().replace(hour=0, minute=0, second=0,
                                    microsecond=0).timestamp()
    with ANPR_LOCK:
        events = list(ANPR_EVENTS)
    today_events = [e for e in events if e['ts'] >= today0]
    configs = {}
    with STATE.lock:
        cams = dict(STATE.cameras)
    for ip, c in cams.items():
        cfg = dict(ANPR_DEFAULTS)
        cfg.update(c.get('anpr') or {})
        eng = ANPR_ENGINES.get(ip)
        cfg['running'] = eng is not None
        cfg['stats'] = dict(eng.stats) if eng else {}
        configs[ip] = cfg
    # Уникальные номера за всё время
    unique = set()
    for e in events:
        unique.add(e.get('plate', ''))
    return {'backend': ANPR_BACKEND,
            'cascade_found': _ANPR_CASCADE_PATH is not None,
            'tesseract_found': _PYTESSERACT,
            'events_today': len(today_events),
            'unique_plates': len([u for u in unique if u]),
            'configs': configs,
            'recent': events[-50:][::-1]}



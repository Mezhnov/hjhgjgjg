})();

/* Пресеты: загружаем с камеры список ONVIF-пресетов (сохранённые позиции),
   показываем кнопками. Клик = переход. */
async function loadPtzPresets(){
    if (!fsIp){
        $('ptzPresetList').innerHTML =
            '<div class="ptz-empty">Сначала откройте камеру</div>';
        return;
    }
    $('ptzPresetList').innerHTML =
        '<div class="ptz-empty"><span class="spin sm"></span> Загрузка…</div>';
    try {
        const r = await fetch('/api/ptz/presets/' + fsIp);
        const d = await r.json();
        const presets = d.presets || [];
        if (!presets.length){
            $('ptzPresetList').innerHTML =
                '<div class="ptz-empty">Нет сохранённых пресетов — нажмите «Сохр.» чтобы добавить</div>';
            return;
        }
        $('ptzPresetList').innerHTML = presets.map((p, i) => {
            const name = p.name ? esc(p.name) : ('Preset ' + (i + 1));
            return `<button class="ptz-preset"
                onclick="ptzGotoPreset('${esc(p.token || '')}')">${name}</button>`;
        }).join('');
    } catch(e){
        $('ptzPresetList').innerHTML =
            '<div class="ptz-empty">Ошибка: ' + esc(e.message) + '</div>';
    }
}
async function ptzGotoPreset(token){
    if (!fsIp || !token) return;
    await ptzCmd('preset_go', {preset: token});
    toast('Переход к пресету', 'info');
}

/* Сохранить текущее положение как новый пресет. Имя запрашиваем prompt'ом. */
async function ptzSavePreset(){
    if (!fsIp) return;
    const name = window.prompt('Имя нового пресета:',
        'Preset ' + (new Date().toLocaleTimeString('ru-RU').slice(0,5)));
    if (!name) return;
    await ptzCmd('preset_set', {preset: name});
    toast('Пресет сохранён: ' + name, 'ok');
    setTimeout(loadPtzPresets, 800);
}


def match_vendor(*, mfr=None, server=None, title=None, scopes=None):
    """Сопоставление отпечатков с вендором. Возвращает key или None."""
    # --- по ONVIF Manufacturer / WS-Discovery scopes ---
    for field in (mfr, scopes):
        if not field:
            continue
        f = field.lower()
        for key, v in VENDORS.items():
            if any(p in f for p in v['mfr']):
                return key
    # --- по заголовку Server ---
    if server:
        s = server.lower()
        for key, v in VENDORS.items():
            if any(p in s for p in v['headers']):
                return key
    # --- по <title> страницы ---
    if title:
        t = title.lower()
        for key, v in VENDORS.items():
            if any(p in t for p in v['titles']) and key != 'generic':
                return key
    if title:
        t = title.lower()
        if any(p in t for p in VENDORS['generic']['titles']):
            return 'generic'
    return None



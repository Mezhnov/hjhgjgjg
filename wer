async function doConnect(){
    const user = $('mcUser').value.trim();
    const pass = $('mcPass').value;
    const auth = $('mcAuth').value;
    const remember = $('mcRemember').checked;
    if (!user || !pass){
        $('mcErr').textContent = 'Введите имя пользователя и пароль';
        $('mcErr').classList.add('show'); return;
    }
    $('mcBtn').disabled = true;
    $('mcInfo').innerHTML = '<span class="spin sm"></span>Подключение: ONVIF → фирменные RTSP-пути → перебор. До ~60 сек…';
    $('mcInfo').classList.add('show');
    $('mcOk').classList.remove('show'); $('mcErr').classList.remove('show');
    try {
        const r = await fetch('/api/connect/' + connectIp, {
            method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({user, pass, auth_type: auth, remember})
        });
        const d = await r.json();
        $('mcInfo').classList.remove('show');
        if (d.status === 'ok'){
            $('mcOk').innerHTML = ic('check-c') + ' ' + esc(d.msg || 'Подключено') +
                esc(d.vendor ? ' (' + d.vendor + ')' : '') + '. Загрузка потока…';
            $('mcOk').classList.add('show');
            setTimeout(() => { closeModal('mConnect'); poll(); }, 700);
        } else {
            $('mcErr').textContent = d.msg || 'Не удалось подключиться';
            $('mcErr').classList.add('show');
            $('mcBtn').disabled = false;
        }
    } catch(e){
        $('mcInfo').classList.remove('show');
        $('mcErr').textContent = 'Ошибка сети: ' + e.message;
        $('mcErr').classList.add('show');
        $('mcBtn').disabled = false;
    }
}

async function doDisconnect(){

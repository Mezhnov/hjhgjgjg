REC_LOCK = threading.Lock()


def _safe_ip(ip):
    return ip.replace('.', '_')


def start_recording_core(ip):
    with REC_LOCK:
        if ip in STATE.recordings:
            return {'status': 'error', 'msg': 'Запись уже идёт'}
    cam = STATE.cameras.get(ip)
    if not cam:
        return {'status': 'error', 'msg': 'Камера не подключена'}
    if not FFMPEG_AVAILABLE:
        return {'status': 'error', 'msg': 'FFmpeg недоступен'}
    rec_url = cam.get('rtsp_main') or cam.get('rtsp_view')
    pattern = os.path.join(ARCHIVE_DIR,
                           f'rec_{_safe_ip(ip)}_%Y%m%d_%H%M%S.mp4')
    cmd = [FFMPEG_PATH, '-hide_banner', '-loglevel', 'error',
           '-rtsp_transport', STATE.settings.get('transport', 'tcp'),
           TIMEOUT_FLAG[0], TIMEOUT_FLAG[1],
           '-i', rec_url, '-c', 'copy',
           '-f', 'segment', '-segment_time', '600',
           '-reset_timestamps', '1', '-strftime', '1', pattern]
    try:
        # stdin нужен для мягкой остановки ('q' -> корректный футер mp4),
        # stderr — для журналирования ошибок записи
        proc = subprocess.Popen(cmd, stdin=subprocess.PIPE,
                                stdout=subprocess.DEVNULL,
                                stderr=subprocess.PIPE,
                                creationflags=CREATE_NO_WINDOW)
    except Exception as e:
        return {'status': 'error', 'msg': str(e)}
    with REC_LOCK:
        STATE.recordings[ip] = {'proc': proc, 'started': time.time(),
                                'pattern': pattern}

    def _drain_err():
        """Ошибки ffmpeg записи -> журнал событий (видно в интерфейсе)."""
        try:
            for line in iter(proc.stderr.readline, b''):
                msg = line.decode('utf-8', 'ignore').strip()
                if msg:
                    LOG.add('error', f'Запись {ip}: {msg}', ip)
        except Exception:
            pass
        finally:
            try:
                proc.stderr.close()
            except Exception:
                pass

    threading.Thread(target=_drain_err, daemon=True,
                     name=f'rec-err-{ip}').start()
    LOG.add('success', f'Запись архива начата: {ip}', ip)
    return {'status': 'ok'}


def stop_recording_core(ip):
    with REC_LOCK:
        rec = STATE.recordings.pop(ip, None)
    if not rec:
        return {'status': 'error', 'msg': 'Запись не ведётся'}
    proc = rec['proc']
    # Мягкая остановка: 'q' -> ffmpeg корректно финализирует mp4
    # (без этого файл остаётся без moov-атомя и не воспроизводится)
    try:
        proc.stdin.write(b'q')
        proc.stdin.flush()
        try:
            proc.stdin.close()
        except Exception:
            pass
    except Exception:
        pass
    try:
        proc.wait(timeout=7)
    except Exception:
        for sig in ('terminate', 'kill'):
            try:
                getattr(proc, sig)()
                proc.wait(timeout=3)
                break
            except Exception:
                continue
    LOG.add('info', f'Запись архива остановлена: {ip}', ip)
    return {'status': 'ok'}


def list_archive():
    """Список файлов архива (начало и длительность — из имени файла)."""
    out = []
    try:
        for fn in sorted(os.listdir(ARCHIVE_DIR)):
            if not fn.endswith('.mp4'):
                continue
            fp = os.path.join(ARCHIVE_DIR, fn)
            stt = os.stat(fp)
            m = re.match(r'rec_(\d+_\d+_\d+_\d+)_(\d{8})_(\d{6})\.mp4', fn)
            ip = m.group(1).replace('_', '.') if m else ''
            ts_start = stt.st_mtime
            if m:
                try:
                    ts_start = datetime.strptime(
                        m.group(2) + m.group(3), '%Y%m%d%H%M%S').timestamp()
                except Exception:
                    pass
            out.append({'file': fn, 'ip': ip, 'size': stt.st_size,
                        'ts': ts_start,
                        'dur': max(0, stt.st_mtime - ts_start)})
    except Exception:
        pass
    return out[::-1][:200]



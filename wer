            ips = list(STATE.devices.keys())
        creds = {}
        with STATE.lock:
            for ip, c in STATE.cameras.items():
                if c.get('user'):
                    creds[(c['user'], c.get('pass', ''), c.get('auth', 'digest'))] = True
        if not creds:
            LOG.add('warn', 'Нет сохранённых учётных данных для массового '
                            'подключения')
            return
        for ip in ips:
            if ip in STATE.cameras and STATE.cameras[ip].get('rtsp_main'):
                continue
            for (u, p, a) in creds:
                r = connect_camera_core(ip, u, p, a, remember=False, deep=False)
                if r.get('status') == 'ok':
                    break
            time.sleep(0.5)
    threading.Thread(target=worker, daemon=True).start()
    return jsonify({'status': 'ok', 'msg': 'Массовое подключение запущено'})



document.addEventListener('keydown', e => {
    if ($('fs').classList.contains('active')){
        if (e.key === 'Escape') return closeFs();
        if (e.key === 'ArrowLeft'){
            if ($('ptzPanel').style.display !== 'none' && fsIp){
                e.preventDefault(); ptzHold('left'); return;
            }
            return fsNav(-1);
        }
        if (e.key === 'ArrowRight'){
            if ($('ptzPanel').style.display !== 'none' && fsIp){
                e.preventDefault(); ptzHold('right'); return;
            }
            return fsNav(1);
        }
        if (e.key === 'ArrowUp' && $('ptzPanel').style.display !== 'none' && fsIp){
            e.preventDefault(); ptzHold('up'); return;
        }
        if (e.key === 'ArrowDown' && $('ptzPanel').style.display !== 'none' && fsIp){
            e.preventDefault(); ptzHold('down'); return;
        }
        if ((e.key === '+' || e.key === '=')){
            if ($('ptzPanel').style.display !== 'none' && fsIp){
                e.preventDefault(); ptzHold('zoomin'); return;
            }
            // иначе — цифровой зум изображения
            fsZoom = Math.min(8, fsZoom*1.25); applyZoom(); return;
        }
        if ((e.key === '-' || e.key === '_')){
            if ($('ptzPanel').style.display !== 'none' && fsIp){
                e.preventDefault(); ptzHold('zoomout'); return;
            }
            fsZoom = Math.max(1, fsZoom*0.8);
            if (fsZoom === 1){fsPanX=0;fsPanY=0;} applyZoom(); return;
        }
        if (e.key === '0' && $('ptzPanel').style.display !== 'none' && fsIp){
            e.preventDefault(); ptzStop(); return;
        }
        return;
    }
    const anyModal = document.querySelector('.modal-overlay.active');
    if (e.key === 'Escape' && anyModal){
        if ($('mPlayer').classList.contains('active')) closePlayer();
        else anyModal.classList.remove('active');
        return; }
    if (anyModal){
        if (e.key === ' ' && $('mPlayer').classList.contains('active')){
            e.preventDefault(); plToggle(); return; }
        if (e.key === 'Enter' && $('mConnect').classList.contains('active')) doConnect();
        if (e.key === 'Enter' && $('mAddCam').classList.contains('active')) doAddCam();
        return;
    }
    if (e.key === 'f' || e.key === 'F' || e.key === 'а' || e.key === 'А'){
        if (selectedIp) openFs(selectedIp); return; }
    if (e.key === 'ArrowLeft' || e.key === 'ArrowRight'){
        const cams = connectedIps();
        if (!cams.length) return;
        let i = cams.indexOf(selectedIp);
        i = e.key === 'ArrowLeft' ? Math.max(0, i-1)
            : Math.min(cams.length-1, i+1);
        selectCam(cams[i]); return; }
});


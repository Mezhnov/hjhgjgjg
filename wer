ANALYTICS_FIELDS = {'enabled', 'sensitivity', 'min_interval', 'analysis_fps',
                    'snapshots', 'tamper_dark', 'tamper_bright', 'defocus',
                    'presence', 'presence_gap',
                    'zone', 'zone_record', 'zone_hold',

            <div class="cam-meta">
                <div class="cam-name">${esc((S.cameras[ip] && S.cameras[ip].name) || ip)}
                    ${c.motion_active?'<span class="rec-dot"></span>':''}</div>
                <div class="cam-ip">${ip}${c.running?'':' — движок остановлен'}
                    ${c.zone ? ' · <span style="color:#17994e;font-weight:700">область '
                        + c.zone.length + ' точек</span>' : ''}
                    ${c.zone && c.zone_record
                        ? ' · <span style="color:#a33030;font-weight:700">запись по области</span>'
                        : ''}</div>
            </div>
            <button class="icon-btn an-zone-btn${c.zone ? ' on' : ''}"
                onclick="openZone('${ip}')">${ic('zone')}</button>
            <div>
                <div class="an-col-lab">Чувствит.</div>
                <select onchange="anCfg('${ip}','sensitivity',this.value)">
                    <option value="0.22" ${c.sensitivity>0.16?'selected':''}>Низкая</option>
                    <option value="0.10" ${c.sensitivity<=0.16 && c.sensitivity>0.06?'selected':''}>Средняя</option>
                    <option value="0.04" ${c.sensitivity<=0.06?'selected':''}>Высокая</option>
                </select>
            </div>
            <div>
                <div class="an-col-lab">Пауза, с</div>
                <input type="number" min="5" max="3600" value="${c.min_interval||20}"
                    onchange="anCfg('${ip}','min_interval',this.value)">
            </div>
            <div>
                <div class="an-col-lab">Уход через, с</div>
                <input type="number" min="5" max="300" value="${c.presence_gap||12}"
                    onchange="anCfg('${ip}','presence_gap',this.value)">
            </div>
            <div>
                <div class="an-col-lab">Удержание, с</div>
                <input type="number" min="2" max="30" value="${c.people_hold||6}"
                    onchange="anCfg('${ip}','people_hold',this.value)">
            </div>
            <div class="an-stats">
                ${c.stats && c.stats.motion ? `<b>${c.stats.motion}</b> движений<br>` : ''}
                ${c.stats && c.stats.visits ? `<b>${c.stats.visits}</b> приходов<br>` : ''}
                ${c.people_now ? `<b>${c.people_now}</b> сейчас в кадре<br>` : ''}
                ${c.stats && c.stats.last_motion
                    ? 'посл. ' + fmtTs(c.stats.last_motion) : 'нет событий'}
                ${c.presence_active && c.presence_since
                    ? '<br>в кадре с ' + fmtTs(c.presence_since)
                    : (c.stats && c.stats.last_left
                        ? '<br>уход в ' + fmtTs(c.stats.last_left) : '')}
            </div>
        </div>`).join('')
        : '<div style="color:var(--dim2);padding:10px 0;font-size:12px">Нет подключённых камер</div>';
    // гистограмма за 24 часа (новый дизайн: сетка, подписи каждые 3 ч,
    // маркер «сейчас», значения над столбиками, диапазон дат)
    const hist = d.histogram || [];
    const mx = Math.max(1, ...hist);
    const now = new Date();
    const total = hist.reduce((a, b) => a + b, 0);
    const p2 = n => String(n).padStart(2, '0');
    const hm = t => p2(t.getHours()) + ':' + p2(t.getMinutes());
    const dmy = t => t.toLocaleDateString('ru-RU',
        {day:'numeric', month:'short'}).replace('.', '');
    // статистика справа от заголовка
    let peakI = -1;
    hist.forEach((v, i) => { if (v > 0 && (peakI < 0 || v > hist[peakI])) peakI = i; });
    const peakTxt = peakI >= 0
        ? ' · пик <b>' + hist[peakI] + '</b> в ' +
          p2(new Date(now - (hist.length-1-peakI)*3600*1000).getHours()) + ':00'
        : '';
    $('anHistStat').innerHTML = '<span class="live-dot"></span>сейчас <b>' +
        hm(now) + '</b> · всего за сутки <b>' + total + '</b>' + peakTxt;
    let bars = '', labels = '';
    const lastI = hist.length - 1;
    for (let i = 0; i < hist.length; i++){
        const v = hist[i];
        const pct = Math.max(v ? 6 : 3, Math.round(v / mx * 100));
        const hourAgo = hist.length - 1 - i;
        const t = new Date(now - hourAgo*3600*1000);
        const hh = p2(t.getHours());
        const isNow = i === lastI;
        const cls = (v ? ' f' : '') + (isNow ? ' now' : '');
        bars += `<div class="an-hbar${cls}" style="height:${pct}%">` +
            (v ? `<span class="val">${v}</span>` : '') + `</div>`;
        const lab = t.getHours() % 3 === 0;
        labels += `<span${lab ? ' class="lab"' : ''}>${lab ? hh + ':00' : ''}</span>`;
        if (lab && i < lastI)
            bars += `<div class="an-hgrid" style="left:calc(14px + ` +
                `${(i + 0.5)} * (100% - 28px) / ${hist.length})"></div>`;
    }
    if (total === 0)
        bars += `<div class="an-hempty"><svg class="ic"><use href="#i-chart"/></svg>` +
            `Событий за последние 24 часа не было</div>`;
    bars += `<div class="an-hnow">сейчас ${hm(now)}</div>`;
    $('anHist').innerHTML = bars;
    $('anHistLabels').innerHTML = labels;
    $('anHistRange').innerHTML =
        `<span>период: с <b>${hm(new Date(now - 23*3600*1000))}</b> ${dmy(new Date(now - 23*3600*1000))}</span>` +
        `<span>по <b>${hm(now)}</b> ${dmy(now)} — сейчас</span>`;
    // таблица приход/уход по времени (сессии присутствия)
    const sess = d.sessions || [];
    $('anSessCount').textContent = sess.length;
    $('anSessions').innerHTML = sess.length
        ? '<table><thead><tr><th>Камера</th><th>Пришёл</th><th>Ушёл</th>' +
          '<th>Людей</th><th>Длительность</th></tr></thead><tbody>' +
          sess.map(s => {
            const nm = esc((S.cameras[s.ip] && S.cameras[s.ip].name) || s.ip);
            const left = s.end ? '<span class="mt">' + fmtTsFull(s.end) + '</span>'
                : (s.stale
                    ? '<span class="sess-none">не зафиксирован</span>'
                    : '<span class="sess-open"><span class="rec-dot"></span>сейчас в кадре</span>');
            const dur = s.dur != null ? s.dur
                : ((s.end || Date.now()/1000) - s.start);
            return `<tr><td class="sess-cam">${nm}</td>` +
                `<td class="mt">${fmtTsFull(s.start)}</td><td>${left}</td>` +
                `<td>${s.people ? s.people : '—'}</td>` +
                `<td class="dur">${fmtPresence(dur)}</td></tr>`;
        }).join('') + '</tbody></table>'
        : '<div class="sess-empty">Сегодня приходов не зафиксировано — ' +
          'включите аналитику для камер выше</div>';
    // поминутная шкала присутствия (последний час, реальные метки времени)
    const tl = d.timeline || {};
    const tlIps = Object.keys(tl);
    const tlAxis = (() => {
        let a = '';
        for (let k = 6; k >= 0; k--){
            const t = new Date(Date.now() - k * 600000);
            a += `<span${k === 0 ? ' class="now-lab"' : ''}>` +
                (k === 0 ? 'сейчас ' + hm(t) : hm(t)) + `</span>`;
        }
        return `<div class="tl-axis">${a}</div>`;
    })();
    $('anTimeline').innerHTML = tlIps.length
        ? tlIps.map(ip => {
            const row = tl[ip] || [];
            const total = row.reduce((a, b) => a + b, 0);
            let cells = '';
            for (let m = 0; m < 60; m++)
                cells += `<span class="tl-cell${row[m] ? ' on' : ''}"></span>`;
            return `<div class="tl-row">` +
                `<div class="tl-name">${esc((S.cameras[ip] && S.cameras[ip].name) || ip)}</div>` +
                `<div class="tl-cells">${cells}</div>` +
                `<div class="tl-sum">${total} мин</div></div>`;
        }).join('') + tlAxis
        : '<div class="sess-empty">За последний час присутствие не зафиксировано</div>';
    // галерея последних событий
    const evs = d.recent || [];
    $('anEvCount').textContent = evs.length;
    $('anEvents').innerHTML = evs.length ? evs.map(e => {
        const m = EV_META[e.type] || {label:e.type, color:'#8b95a3', ico:'•'};
        const snap = e.snap ? `/snapshots/${encodeURIComponent(e.snap)}` : null;
        return `<div class="aev" ${snap
            ? `onclick="window.open('${snap}','_blank')"` : ''}>
            ${snap ? `<img src="${snap}" loading="lazy" alt="">`
                : `<div class="noimg" style="color:${m.color}">${ic(m.ico)}</div>`}
            <div class="aev-meta">
                <span class="aev-type" style="color:${m.color}">${m.label}</span>
                <span class="aev-ts">${fmtTs(e.ts)} <span class="ago">· ${fmtAgo(e.ts)}</span></span>
            </div>
            <div class="aev-sub">${e.ip}${e.ratio
                ? ' · ' + Math.round(e.ratio*100) + '%' : ''}</div>
        </div>`;
    }).join('') : '<div style="color:var(--dim2);font-size:12px;padding:8px 0">Событий пока нет — включите аналитику для камер выше</div>';
}


PTZ_NS = 'http://www.onvif.org/ver20/ptz/wsdl'
TT_NS = 'http://www.onvif.org/ver10/schema'


def _onvif_ptz_post(ip, service_path, inner_body, user, passwd, timeout=5):
    url = f'http://{ip}{service_path}'
    headers = {'Content-Type': 'application/soap+xml; charset=utf-8'}
    body = _soap(f'<s:Body>{inner_body}</s:Body>')
    try:
        r = requests.post(url, data=body, headers=headers,
                          auth=HTTPDigestAuth(user, passwd), timeout=timeout)
        if r.status_code in (401, 403) or b'NotAuthorized' in r.content:
            body2 = _soap(f'{_wsse_header(user, passwd)}<s:Body>{inner_body}</s:Body>')
            r = requests.post(url, data=body2, headers=headers, timeout=timeout)
        return r
    except Exception:
        return None


def _ptz_profile_token(ip, user, passwd):
    _, _, profiles = onvif_get_profiles(ip, user, passwd)
    for p in profiles:
        if p['ptz']:
            return p['token']
    return profiles[0]['token'] if profiles else None


def ptz_get_presets(ip, user, passwd):
    """Возвращает список сохранённых пресетов ONVIF PTZ
    (name + token) для первого PTZ-профиля камеры."""
    token = _ptz_profile_token(ip, user, passwd)
    if not token:
        return []
    inner = (f'<GetPresets xmlns="{PTZ_NS}">'
             f'<ProfileToken>{token}</ProfileToken></GetPresets>')
    r = _onvif_ptz_post(ip, '/onvif/ptz_service', inner, user, passwd, timeout=4)
    if r is None or r.status_code != 200:
        return []
    try:
        root = ET.fromstring(r.content)
        presets = []
        # PTZ Preset лежит в tns1:Preset элементе с подэлементами Name и token
        for p in root.iter():
            tag = p.tag.split('}')[-1]
            if tag == 'Preset':
                name_el = p.find(f'{{{TT_NS}}}Name')
                ptoken = p.attrib.get('token') or ''
                pname = (name_el.text if name_el is not None and name_el.text
                         else ptoken)
                if ptoken:
                    presets.append({'token': ptoken, 'name': pname})
        return presets
    except Exception:
        return []


def ptz_command(ip, cmd, speed=0.5, preset=None, pan=0.0, tilt=0.0,
               zoom=0.0):
    """Управление поворотом/зумом. cmd: up/down/left/right/zoomin/zoomout/
    stop/home/preset_set/preset_go/move. move — векторное управление мышью
    с кадра (клик = центр, drag = поворот, колесо = зум): pan/tilt/zoom
    в диапазоне -1..1."""
    cam = STATE.cameras.get(ip)
    if not cam:
        return {'status': 'error', 'msg': 'Камера не подключена'}
    user, passwd = cam['user'], cam['pass']
    token = _ptz_profile_token(ip, user, passwd)
    if not token:
        return {'status': 'error', 'msg': 'PTZ-профиль ONVIF не найден'}

    def _c(v):
        return max(-1.0, min(1.0, float(v)))

    s = max(0.1, min(1.0, float(speed)))
    inner = None
    if cmd in ('up', 'down', 'left', 'right'):
        x, y = 0, 0
        if cmd == 'up':
            y = s
        elif cmd == 'down':
            y = -s
        elif cmd == 'left':
            x = -s
        elif cmd == 'right':
            x = s
        inner = (f'<ContinuousMove xmlns="{PTZ_NS}">'
                 f'<ProfileToken>{token}</ProfileToken>'
                 f'<Velocity><PanTilt x="{x}" y="{y}" space='
                 f'"http://www.onvif.org/ver10/schema/ContinuousPanTiltVelocitySpace"/>'
                 f'</Velocity></ContinuousMove>')
    elif cmd == 'zoomin':
        inner = (f'<ContinuousMove xmlns="{PTZ_NS}">'
                 f'<ProfileToken>{token}</ProfileToken>'
                 f'<Velocity><Zoom x="{s}" space='
                 f'"http://www.onvif.org/ver10/schema/ContinuousZoomVelocitySpace"/>'
                 f'</Velocity></ContinuousMove>')
    elif cmd == 'zoomout':
        inner = (f'<ContinuousMove xmlns="{PTZ_NS}">'
                 f'<ProfileToken>{token}</ProfileToken>'
                 f'<Velocity><Zoom x="{-s}" space='
                 f'"http://www.onvif.org/ver10/schema/ContinuousZoomVelocitySpace"/>'
                 f'</Velocity></ContinuousMove>')
    elif cmd == 'move':
        # векторное управление мышью (как в self60): pan/tilt/zoom -1..1,
        # скорость — общий множитель (слайдер «Скорость» в панели PTZ)
        x, y, z = _c(pan) * s, _c(tilt) * s, _c(zoom) * s
        zoom_xml = (f'<Zoom x="{z:.3f}" space='
                    f'"http://www.onvif.org/ver10/schema/'
                    f'ContinuousZoomVelocitySpace"/>'
                    if abs(z) > 0.005 else '')
        inner = (f'<ContinuousMove xmlns="{PTZ_NS}">'
                 f'<ProfileToken>{token}</ProfileToken>'
                 f'<Velocity><PanTilt x="{x:.3f}" y="{y:.3f}" space='
                 f'"http://www.onvif.org/ver10/schema/ContinuousPanTiltVelocitySpace"/>'
                 f'{zoom_xml}</Velocity></ContinuousMove>')
    elif cmd == 'stop':
        inner = (f'<Stop xmlns="{PTZ_NS}">'
                 f'<ProfileToken>{token}</ProfileToken>'
                 f'<PanTilt>true</PanTilt><Zoom>true</Zoom></Stop>')
    elif cmd == 'home':
        inner = (f'<GotoHomePosition xmlns="{PTZ_NS}">'
                 f'<ProfileToken>{token}</ProfileToken></GotoHomePosition>')
    elif cmd == 'preset_go' and preset is not None:
        inner = (f'<GotoPreset xmlns="{PTZ_NS}">'
                 f'<ProfileToken>{token}</ProfileToken>'
                 f'<PresetToken>{preset}</PresetToken></GotoPreset>')
    elif cmd == 'preset_set' and preset is not None:
        inner = (f'<SetPreset xmlns="{PTZ_NS}">'
                 f'<ProfileToken>{token}</ProfileToken>'
                 f'<PresetName>{preset}</PresetName></SetPreset>')
    if not inner:
        return {'status': 'error', 'msg': f'Неизвестная команда PTZ: {cmd}'}

    r = _onvif_ptz_post(ip, '/onvif/ptz_service', inner, user, passwd)
    if r is not None and r.status_code == 200:
        return {'status': 'ok'}
    return {'status': 'error',
            'msg': f'PTZ отклонён ({r.status_code if r is not None else "нет связи"})'}



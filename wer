def connect_camera_core(ip, user, passwd, auth_type='digest',
                        remember=False, deep=True):
    """Полный цикл подключения: ONVIF-инфо -> вендор -> RTSP -> телеметрия."""
    if ip in STATE.connecting:
        return {'status': 'error', 'msg': 'Подключение уже выполняется'}
    STATE.connecting.add(ip)
    LOG.add('info', f'Подключение: {ip} ({user}, {auth_type})', ip)
    try:
        with STATE.lock:
            dev = dict(STATE.devices.get(ip) or {})
        vendor_key = dev.get('vendor_key', 'generic')

        # 1) Информация об устройстве (уточняет вендор/модель)
        onvif_info, onvif_err = onvif_get_device_info(ip, user, passwd, auth_type)
        if onvif_info:
            mfr = onvif_info.get('manufacturer', '')
            vk = match_vendor(mfr=mfr)
            if vk:
                vendor_key = vk
            LOG.add('success',
                    f'ONVIF: {mfr} {onvif_info.get("model", "")} '
                    f'fw {onvif_info.get("fw", "")}', ip)
        else:
            # Hikvision ISAPI — уточнение
            isapi = hikvision_isapi_probe(ip, user, passwd)
            if isapi.get('info'):
                vendor_key = 'hikvision' if not match_vendor(mfr='') else vendor_key
                onvif_info = {'manufacturer': 'Hikvision',
                              'model': isapi['info'].get('model', ''),
                              'fw': isapi['info'].get('fw', ''),
                              'serial': isapi['info'].get('serial', '')}
            elif onvif_err:
                LOG.add('warn', onvif_err, ip)

        # 2) Поиск RTSP-потока
        found = find_rtsp(ip, user, passwd, vendor_key, deep=deep)
        if not found:
            LOG.add('error', f'RTSP-поток не найден: {ip}', ip)
            return {'status': 'error',
                    'msg': 'Рабочий RTSP-поток не найден. Проверьте логин/пароль '
                           'или откройте диагностику.'}

        main_url = found['main']
        sub_url = found.get('sub')
        with STATE.lock:
            settings = dict(STATE.settings)
        prefer_sub = settings.get('prefer_sub', True)
        view_url = sub_url if (prefer_sub and sub_url) else main_url

        # 3) Телеметрия
        tel = ffprobe_info(main_url) or ffprobe_info(view_url)

        # 4) Сохраняем камеру
        with STATE.lock:
            old = STATE.cameras.get(ip, {})
            v = VENDORS.get(vendor_key, VENDORS['generic'])
            STATE.cameras[ip] = {
                'user': user, 'pass': passwd, 'auth': auth_type,
                'name': old.get('name') or (onvif_info or {}).get('model')
                        or f'{v["name"]} {ip.split(".")[-1]}',
                'vendor_key': vendor_key, 'vendor': v['name'],
                'model': (onvif_info or {}).get('model', dev.get('model', '')),
                'fw': (onvif_info or {}).get('fw', ''),
                'serial': (onvif_info or {}).get('serial', ''),
                'rtsp_main': main_url, 'rtsp_sub': sub_url,
                'rtsp_view': view_url,
                'via': found.get('via', ''),
                'ptz': bool(found.get('ptz')),
                'remember': remember,
                'state': 'connecting',
                'connected_at': time.time(),
                'stats': tel,
            }
        # сброс старого потока, если URL изменился
        hub_drop(ip)
        LOG.add('success',
                f'Подключено ({found.get("via", "")}): '
                f'{mask_creds(main_url)}', ip)

        # автозапись в архив (режим Intellect: подключили камеру -> пишем).
        # если включена запись по области — непрерывная автозапись не нужна:
        # архив начнёт писаться сам при появлении человека в области.
        if settings.get('auto_record', True):
            def _autorec():
                time.sleep(4)          # даём потоку стабилизироваться
                with STATE.lock:
                    still_connected = ip in STATE.cameras
                    an_cfg = ((STATE.cameras.get(ip) or {}).get('analytics')
                              or {})
                if (still_connected and ip not in STATE.recordings
                        and not (_zone_points(an_cfg)
                                 and an_cfg.get('zone_record'))):
                    r = start_recording_core(ip)
                    if r.get('status') != 'ok':
                        LOG.add('warn',
                                f'Автозапись не запущена: {r.get("msg", "")}',
                                ip)
            threading.Thread(target=_autorec, daemon=True,
                             name=f'autorec-{ip}').start()

        if remember:
            save_config()
        return {'status': 'ok', 'rtsp': mask_creds(main_url),
                'vendor': VENDORS.get(vendor_key, {}).get('name', ''),
                'ptz': found.get('ptz', False),
                'msg': 'Подключено!'}
    except Exception as e:
        LOG.add('error', f'Ошибка подключения {ip}: {e}', ip)
        return {'status': 'error', 'msg': str(e)}
    finally:
        STATE.connecting.discard(ip)


def mask_creds(url):
    """Маскирует пароль в RTSP URL для отображения."""
    if not url:
        return ''
    return re.sub(r'//([^:/@]+):([^@]+)@', r'//\1:***@', url)


def disconnect_camera_core(ip):
    hub_drop(ip)
    rec = STATE.recordings.get(ip)
    if rec:
        stop_recording_core(ip)
    with STATE.lock:
        cam = STATE.cameras.pop(ip, None)
    if cam:
        LOG.add('info', f'Отключено: {ip}', ip)
        if cam.get('remember'):
            # сохранить как offline для будущего автоподключения
            with STATE.lock:
                STATE.cameras[ip] = {**cam, 'state': 'offline'}
            save_config()
    return {'status': 'ok'}


def autoconnect_saved():
    """Фоновое автоподключение камер, сохранённых в конфигурации."""
    time.sleep(2)
    with STATE.lock:
        saved = [(ip, dict(c)) for ip, c in STATE.cameras.items()
                 if c.get('remember') and c.get('user')]
    for ip, c in saved:
        LOG.add('info', f'Автоподключение: {ip}', ip)
        connect_camera_core(ip, c['user'], c['pass'], c.get('auth', 'digest'),
                            remember=True, deep=False)
        time.sleep(1.5)



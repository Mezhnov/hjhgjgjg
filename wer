@app.route('/api/archive/day')
def api_archive_day():
    """Суточный архив одной камеры (для плеера в стиле TRASSIR):
    сегменты записей + сессии присутствия людей + тики движения
    + список дат, по которым вообще есть данные."""
    ip = request.args.get('ip', '')
    date_s = request.args.get('date') or datetime.now().strftime('%Y-%m-%d')
    try:
        day0 = datetime.strptime(date_s, '%Y-%m-%d').timestamp()
    except ValueError:
        return jsonify({'status': 'error', 'msg': 'Неверный формат даты'}), 400
    day1 = day0 + 86400
    now = time.time()

    # --- сегменты mp4 за сутки (срез по границам дня) ---
    segs = []
    try:
        for fn in os.listdir(ARCHIVE_DIR):
            m = re.match(r'rec_(\d+_\d+_\d+_\d+)_(\d{8})_(\d{6})\.mp4$', fn)
            if not m or m.group(1).replace('_', '.') != ip:
                continue
            try:
                ts = datetime.strptime(m.group(2) + m.group(3),
                                       '%Y%m%d%H%M%S').timestamp()
            except ValueError:
                continue
            fp = os.path.join(ARCHIVE_DIR, fn)
            try:
                stt = os.stat(fp)
            except OSError:
                continue
            dur = max(0.0, stt.st_mtime - ts)
            if ts >= day1 or ts + dur <= day0:
                continue
            segs.append({'file': fn, 'start': ts, 'dur': dur,
                         'size': stt.st_size})
    except Exception:
        pass
    segs.sort(key=lambda s: s['start'])

    # --- сессии присутствия: события в памяти + суточный журнал ---
    with ANALYTICS_LOCK:
        events = [e for e in ANALYTICS_EVENTS if e.get('ip') == ip]
        eng = ANALYTICS_ENGINES.get(ip)
    sessions, _open = _presence_sessions(events)
    if eng is not None and eng.person_since is not None:  # открытая сессия
        sessions.append({'ip': ip, 'start': eng.person_since, 'end': None,
                         'dur': round(max(0.0, now - eng.person_since), 1)})
    presence, seen = [], set()
    for s in sessions:
        end = s.get('end') or now
        if s['start'] >= day1 or end <= day0:
            continue
        seen.add((round(s['start'], 1), round(end, 1)))
        presence.append({'start': round(s['start'], 1), 'end': round(end, 1),
                         'dur': round(end - s['start'], 1)})
    for rec in presence_log_load(date_s):     # после перезапуска — из файла
        if rec.get('ip') != ip:
            continue
        end = rec.get('end') or rec['start']
        key = (round(rec['start'], 1), round(end, 1))
        if key in seen or rec['start'] >= day1 or end <= day0:
            continue
        seen.add(key)
        presence.append({'start': rec['start'], 'end': end,
                         'dur': rec.get('dur') or round(end - rec['start'], 1)})
    presence.sort(key=lambda p: p['start'])

    # --- тики движения за сутки (из событий в памяти) ---
    motion = sorted(round(e['ts'], 1) for e in events
                    if e.get('type') == 'motion' and day0 <= e['ts'] < day1)

    with STATE.lock:
        cam = STATE.cameras.get(ip) or {}
    with REC_LOCK:
        recording = ip in STATE.recordings
    return jsonify({
        'ip': ip,
        'name': cam.get('name') or ip,
        'date': date_s,
        'recording': recording,
        'now': now,
        'zone': bool(_zone_points(cam.get('analytics') or {})),
        'segments': segs,
        'presence': presence,
        'motion': motion,
        'dates': sorted(archive_dates(ip) | presence_log_dates(ip)),
        'totals': {
            'archive_sec': round(sum(s['dur'] for s in segs), 1),
            'presence_sec': round(sum(p['dur'] for p in presence), 1),
            'sessions': len(presence),
            'motions': len(motion),
        },
    })


@app.route('/archive/<fn>')
def archive_file(fn):
    """Раздача mp4 из архива. ?play=1 — инлайн (для <video>), иначе —
    скачивание. Поддержаны Range-запросы (206) — без них браузер
    не умеет перематывать видео по шкале."""
    if '/' in fn or '\\' in fn or '..' in fn:
        return Response(status=400)
    fp = os.path.join(ARCHIVE_DIR, fn)
    if not os.path.isfile(fp):
        return Response(status=404)
    size = os.path.getsize(fp)
    inline = request.args.get('play') == '1'
    disp = ('inline' if inline else
            f'attachment; filename="{fn}"')

    rng = request.headers.get('Range', '')
    m = re.match(r'bytes=(\d*)-(\d*)', rng.strip())
    start = end = None
    if rng and m:
        if m.group(1):
            start = int(m.group(1))
            end = min(int(m.group(2)) if m.group(2) else size - 1,
                      size - 1)
        elif m.group(2):                    # bytes=-N: последние N байт
            start = max(0, size - int(m.group(2)))
            end = size - 1
    if rng and m and (m.group(1) or m.group(2)) and \
            start is not None and start >= size:      # диапазон вне файла
        resp = Response(status=416)
        resp.headers['Content-Range'] = f'bytes */{size}'
        return resp
    if start is not None and start <= end and start < size:
        length = end - start + 1

        def gen_range():
            with open(fp, 'rb') as f:
                f.seek(start)
                remaining = length
                while remaining > 0:
                    chunk = f.read(min(512 * 1024, remaining))
                    if not chunk:
                        break
                    remaining -= len(chunk)
                    yield chunk

        resp = Response(gen_range(), status=206, mimetype='video/mp4')
        resp.headers['Content-Range'] = f'bytes {start}-{end}/{size}'
        resp.headers['Content-Length'] = str(length)
    else:
        def gen_full():
            with open(fp, 'rb') as f:
                while True:
                    chunk = f.read(512 * 1024)
                    if not chunk:
                        break
                    yield chunk
        resp = Response(gen_full(), mimetype='video/mp4')
        resp.headers['Content-Length'] = str(size)
    resp.headers['Accept-Ranges'] = 'bytes'
    if not inline:
        resp.headers['Content-Disposition'] = disp
    return resp


@app.route('/api/archive/delete', methods=['POST'])
def api_archive_delete():
    data = request.get_json(silent=True) or {}
    fn = data.get('file', '')
    if '/' in fn or '\\' in fn or '..' in fn:
        return jsonify({'status': 'error'})
    fp = os.path.join(ARCHIVE_DIR, fn)
    try:
        os.remove(fp)
        LOG.add('info', f'Файл архива удалён: {fn}')
        return jsonify({'status': 'ok'})
    except Exception as e:
        return jsonify({'status': 'error', 'msg': str(e)})


@app.route('/api/ptz/<ip>', methods=['POST'])
def api_ptz(ip):
    data = request.get_json(silent=True) or {}
    return jsonify(ptz_command(ip, data.get('cmd', ''),
                               speed=data.get('speed', 0.5),
                               preset=data.get('preset'),
                               pan=data.get('pan', 0.0),
                               tilt=data.get('tilt', 0.0),
                               zoom=data.get('zoom', 0.0)))


@app.route('/api/ptz/presets/<ip>')
def api_ptz_presets(ip):
    cam = STATE.cameras.get(ip)
    if not cam:
        return jsonify({'profiles': [], 'presets': []})
    _, _, profiles = onvif_get_profiles(ip, cam['user'], cam['pass'])
    presets = ptz_get_presets(ip, cam['user'], cam['pass'])
    return jsonify({'profiles': profiles, 'presets': presets})


@app.route('/api/diag/<ip>')
def api_diag(ip):
    """Диагностика камеры: последние ошибки ffmpeg потока."""
    st = hub_get(ip, create=False)
    cam = STATE.cameras.get(ip)
    out = {'ip': ip}
    if cam:
        out.update({'vendor': cam.get('vendor'), 'model': cam.get('model'),
                    'via': cam.get('via'),
                    'rtsp': mask_creds(cam.get('rtsp_main', '')),
                    'rtsp_view': mask_creds(cam.get('rtsp_view', ''))})
    if st:
        out.update({'stats': st.stats, 'stderr': st.error_tail()})
    return jsonify(out)


@app.route('/api/stream_error')
def api_stream_error():
    return jsonify({'status': 'error', 'msg': 'FFmpeg не найден на сервере'})



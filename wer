@app.route('/api/analytics/<ip>', methods=['POST'])
def api_analytics_config(ip):
    data = request.get_json(silent=True) or {}
    with STATE.lock:
        cam = STATE.cameras.get(ip)
        if not cam:
            return jsonify({'status': 'error', 'msg': 'Камера не подключена'})
        cfg = dict(cam.get('analytics') or {})
        for k, v in data.items():
            if k not in ANALYTICS_FIELDS:
                continue
            try:
                if k == 'sensitivity':
                    cfg[k] = round(min(0.5, max(0.02, float(v))), 3)
                elif k == 'min_interval':
                    cfg[k] = min(3600, max(5, int(v)))
                elif k == 'analysis_fps':
                    cfg[k] = min(5, max(1, int(v)))
                elif k == 'presence_gap':
                    cfg[k] = min(300, max(5, int(v)))
                elif k == 'zone_hold':
                    cfg[k] = min(300, max(5, int(v)))
                elif k == 'person_fps':
                    cfg[k] = min(3, max(1, int(v)))
                elif k == 'people_hold':
                    cfg[k] = min(30, max(2, int(v)))
                elif k == 'detector':
                    cfg[k] = v if v in ('auto', 'yolo', 'hog') else 'auto'
                elif k == 'zone':
                    # полигон области контроля: [[x, y], ...] в долях 0..1;
                    # меньше 3 точек или None — сброс (детекция по всему кадру)
                    if v in (None, '', [], 0):
                        cfg[k] = None
                    elif isinstance(v, (list, tuple)):
                        pts = []
                        for p in v:
                            if not isinstance(p, (list, tuple)) or len(p) < 2:
                                continue
                            pts.append([round(min(1.0, max(0.0, float(p[0]))), 4),
                                        round(min(1.0, max(0.0, float(p[1]))), 4)])
                        cfg[k] = pts if len(pts) >= 3 else None
                    else:
                        continue
                else:
                    cfg[k] = bool(v)
            except (TypeError, ValueError):
                continue
        cam['analytics'] = cfg
    save_config()
    return jsonify({'status': 'ok', 'config': cfg})



def analytics_histogram(events, ip=None, hours=24):
    """Часовые корзины событий за последние N часов (для графика).
    События прихода/ухода не учитываются — они производные от движения."""
    now = time.time()
    buckets = [0] * hours
    for ev in events:
        if ip and ev.get('ip') != ip:
            continue
        if ev.get('type') in ('person_enter', 'person_left'):
            continue
        age = now - ev['ts']
        if age < 0 or age >= hours * 3600:
            continue
        buckets[hours - 1 - int(age // 3600)] += 1
    return buckets


def _presence_sessions(events):
    """Восстановить сессии присутствия из пар событий
    person_enter / person_left. Возвращает (сессии, открытые входы)."""
    open_by_ip = {}
    sessions = []
    for ev in events:
        t = ev.get('type')
        if t == 'person_enter':
            open_by_ip[ev['ip']] = ev
        elif t == 'person_left':
            enter = open_by_ip.pop(ev['ip'], None)
            start = enter['ts'] if enter else ev.get('since')
            if start is None:
                continue
            end = ev.get('until') or ev['ts']
            sessions.append({'ip': ev['ip'], 'start': start, 'end': end,
                             'dur': ev.get('dur') or round(end - start, 1),
                             'people': max(int(ev.get('people') or 0),
                                           int((enter or {}).get('people') or 0))})
    return sessions, open_by_ip


def _analytics_public():
    today0 = datetime.now().replace(hour=0, minute=0, second=0,
                                    microsecond=0).timestamp()
    with ANALYTICS_LOCK:
        events = list(ANALYTICS_EVENTS)
        engines = dict(ANALYTICS_ENGINES)
    today_events = [e for e in events if e['ts'] >= today0]
    visits_today = sum(1 for e in today_events if e.get('type') == 'person_enter')
    configs = {}
    with STATE.lock:
        cams = dict(STATE.cameras)
    for ip, c in cams.items():
        cfg = dict(ANALYTICS_DEFAULTS)
        cfg.update(c.get('analytics') or {})
        eng = engines.get(ip)
        cfg['running'] = eng is not None
        cfg['motion_active'] = bool(eng and eng.motion_until > time.time())
        cfg['presence_active'] = bool(eng and eng.person_since is not None)
        cfg['presence_since'] = (round(eng.person_since, 1)
                                  if eng and eng.person_since else None)
        cfg['people_now'] = int(eng.people_now) if eng else 0
        cfg['people_detector'] = bool(eng and eng.people_ok)
        cfg['stats'] = dict(eng.stats) if eng else {}
        configs[ip] = cfg
    # сессии присутствия за сегодня (приход/уход по времени)
    now = time.time()
    sessions, open_evs = _presence_sessions(events)
    for ip, eng in engines.items():           # открытая сессия живого движка
        if eng.person_since is not None:
            sessions.append({'ip': ip, 'start': eng.person_since, 'end': None,
                             'dur': round(max(0.0, now - eng.person_since), 1),
                             'people': max(eng.session_max_people,
                                           eng.people_now)})
    for ip, ev in open_evs.items():           # вход без зафиксированного ухода
        if not (engines.get(ip) and engines[ip].person_since is not None):
            sessions.append({'ip': ip, 'start': ev['ts'], 'end': None,
                             'dur': round(now - ev['ts'], 1), 'stale': True})
    # поминутная шкала присутствия за последний час (по камерам):
    # минута помечается, если в этот момент была открыта сессия
    hour_ago = now - 3600
    timeline = {}
    for s in sessions:
        if (s.get('end') or now) < hour_ago:
            continue
        row = timeline.setdefault(s['ip'], [0] * 60)
        a = max(s['start'], hour_ago)
        b = min(s.get('end') or now, now)
        if b <= a:
            continue
        for m in range(int((a - hour_ago) // 60),
                       int((b - hour_ago) // 60) + 1):
            if 0 <= m < 60:
                row[m] = 1
    sessions = [s for s in sessions if (s['end'] or now) >= today0]
    sessions.sort(key=lambda s: s['start'], reverse=True)
    return {'backend': ANALYTICS_BACKEND,
            'detector': {'mode': DETECT_INFO.get('mode', 'off'),
                         'model': DETECT_INFO.get('model', ''),
                         'error': DETECT_INFO.get('error', '')},
            'events_today': len(today_events),
            'visits_today': visits_today,
            'configs': configs,
            'histogram': analytics_histogram(events),
            'timeline': timeline,
            'sessions': sessions[:60],
            'recent': events[-30:][::-1]}



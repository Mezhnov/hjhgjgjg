/* ================== ОБЛАСТЬ КОНТРОЛЯ (как у TRASSIR) ==================
   Клик по кадру добавляет точку полигона, точки перетаскиваются,
   клик по точке (без перетаскивания) удаляет её. Сохранение — кнопка. */
const ZN = {ip:null, pts:[], saved:'[]', timer:null, act:null};

function zonePolyStr(pts){
    return pts.map(p => p[0] + ',' + p[1]).join(' ');
}

async function openZone(ip){
    if (!ip) return;
    if ($('fs').classList.contains('active')) closeFs();
    ZN.ip = ip;
    const opts = Object.entries(S.cameras)
        .map(([i,c]) => `<option value="${i}"${i===ip?' selected':''}>` +
            `${esc(c.name||i)} · ${i}</option>`).join('');
    $('zoneCam').innerHTML = opts || `<option value="${ip}">${ip}</option>`;
    $('zoneName').textContent = '— ' + ((S.cameras[ip] &&
        S.cameras[ip].name) || ip);
    $('mZone').classList.add('active');
    // текущая область и настройки из API аналитики
    ZN.pts = [];
    try {
        const d = await fetchAnalytics();
        const c = d && d.configs && d.configs[ip];
        if (c && Array.isArray(c.zone))
            ZN.pts = c.zone.map(p => [+p[0], +p[1]]);
        $('zoneRec').checked = !!(c && c.zone_record);
        $('zoneHold').value = (c && c.zone_hold) || 15;
    } catch(e){ /* без конфигурации — рисуем с нуля */ }
    ZN.saved = JSON.stringify(ZN.pts);
    zoneLoadBg();
    zoneRender();

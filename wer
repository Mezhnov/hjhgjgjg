/* ================= РАМКИ ДЕТЕКЦИИ НА ВИДЕО =================
   Поверх живой картинки рисуются рамки сопровождаемых объектов:
   человек — сплошная красная рамка «ЧЕЛОВЕК · id»,
   машина — жёлтая пунктирная рамка (как «умная парковка»).
   Координаты приходят нормированными (0..1) от трекера. */
let DET = {};   // ip -> [{c:'person'|'car'..., i:id, b:[x,y,w,h]}]
const CLS_RU = {person:'Человек', car:'Машина', truck:'Грузовик',
    bus:'Автобус', motorcycle:'Мото', bicycle:'Вело'};

function plu(n, a, b, c){
    const m10 = n % 10, m100 = n % 100;
    if (m10 === 1 && m100 !== 11) return a;
    if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return b;
    return c;
}

async function pollDets(){

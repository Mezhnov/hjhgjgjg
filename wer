def _fmt_duration(sec):
    """Длительность присутствия в человекочитаемом виде."""
    sec = int(round(max(0, sec)))
    if sec < 60:
        return f'{sec} с'
    m, s = divmod(sec, 60)
    if m < 60:
        return f'{m} мин' + (f' {s:02d} с' if s else '')
    h, m = divmod(m, 60)
    return f'{h} ч ' + (f'{m:02d} мин' if m else '')


    $('acBtn').disabled = true;
    $('acInfo').innerHTML = '<span class="spin sm"></span>Подключение: ONVIF → фирменные RTSP-пути → перебор. До ~60 сек…';
    $('acInfo').classList.add('show');
    $('acOk').classList.remove('show'); $('acErr').classList.remove('show');
    try {
        const r = await fetch('/api/add_camera', {
            method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({ip, port, user, pass, auth_type: auth, remember})
        });
        const d = await r.json();
        $('acInfo').classList.remove('show');
        if (d.status === 'ok'){
            $('acOk').innerHTML = ic('check-c') + ' ' + esc(d.msg || 'Подключено') +
                esc(d.vendor ? ' (' + d.vendor + ')' : '') + '. Загрузка потока…';
            $('acOk').classList.add('show');
            setTimeout(() => { closeModal('mAddCam'); poll(); }, 700);
        } else {
            $('acErr').textContent = d.msg || 'Не удалось подключиться';
            $('acErr').classList.add('show');
            $('acBtn').disabled = false;
        }
    } catch(e){
        $('acInfo').classList.remove('show');
        $('acErr').textContent = 'Ошибка сети: ' + e.message;
        $('acErr').classList.add('show');
        $('acBtn').disabled = false;
    }
}


def analytics_decode_gray(frame, size=(160, 96)):
    """Декодирование кадра в уменьшенный полутоновый массив."""
    if ANALYTICS_BACKEND == 'cv2':
        try:
            arr = np.frombuffer(frame, np.uint8)
            img = cv2.imdecode(arr, cv2.IMREAD_GRAYSCALE)
            if img is None:
                return None
            return cv2.resize(img, size, interpolation=cv2.INTER_AREA)
        except Exception:
            return None
    if ANALYTICS_BACKEND == 'numpy':
        try:
            img = Image.open(io.BytesIO(frame)).convert('L')
            img = img.resize((size[0], size[1]))
            return np.asarray(img, np.uint8)
        except Exception:
            return None
    return None


def analytics_sharpness(gray):
    """Резкость кадра (энергия градиента). Низкая = размытие."""
    try:
        g = gray.astype(np.float32)
        gy, gx = np.gradient(g)
        return float((gx * gx + gy * gy).mean())
    except Exception:
        return 999.0


# ----------------------------------------------------------------------------
#  ОБЛАСТЬ КОНТРОЛЯ (как у TRASSIR): полигон поверх кадра, нарисованный
#  мышью. Движение засчитывается только внутри области; опционально
#  появление человека в области запускает запись архива.
# ----------------------------------------------------------------------------
_ZONE_MASK_CACHE = {}


def _zone_points(cfg):
    """Валидный список точек области [(x, y), ...] в долях кадра 0..1
    или None — область не задана (детекция по всему кадру)."""
    pts = (cfg or {}).get('zone')
    if not isinstance(pts, (list, tuple)) or len(pts) < 3:
        return None
    out = []
    for p in pts:
        try:
            x, y = float(p[0]), float(p[1])
        except (TypeError, ValueError, IndexError):
            return None
        out.append((min(1.0, max(0.0, x)), min(1.0, max(0.0, y))))
    return out if len(out) >= 3 else None


def _zone_mask(points, shape):
    """Булева маска полигона (h, w). Точки — (x, y) в долях 0..1."""
    key = (tuple(points), shape)
    cached = _ZONE_MASK_CACHE.get(key)
    if cached is not None:
        return cached
    h, w = int(shape[0]), int(shape[1])
    if _CV2:
        poly = np.array([[int(round(x * (w - 1))), int(round(y * (h - 1)))]
                         for x, y in points], np.int32)
        m = np.zeros((h, w), np.uint8)
        cv2.fillPoly(m, [poly], 1)
        mask = m.astype(bool)
    else:
        # растеризация построчно (even-odd rule) — работает без OpenCV
        mask = np.zeros((h, w), bool)
        n = len(points)
        for row in range(h):
            y = (row + 0.5) / h
            xs = []
            for i in range(n):
                x1, y1 = points[i]
                x2, y2 = points[(i + 1) % n]
                if (y1 <= y < y2) or (y2 <= y < y1):
                    xs.append(x1 + (y - y1) / (y2 - y1) * (x2 - x1))
            xs.sort()
            for a, b in zip(xs[::2], xs[1::2]):
                c0 = int(np.ceil(a * w - 0.5))
                c1 = int(np.floor(b * w - 0.5))
                if c1 >= c0:
                    mask[row, max(0, c0):min(w, c1 + 1)] = True
    if len(_ZONE_MASK_CACHE) > 64:
        _ZONE_MASK_CACHE.clear()
    _ZONE_MASK_CACHE[key] = mask
    return mask


# ----------------------------------------------------------------------------
#  ДЕТЕКТОР ЛЮДЕЙ (HOG + SVM, встроен в OpenCV — без внешних моделей).
#  Движение — дешёвый триггер; детектор подтверждает, что движется именно
#  человек, считает людей в кадре и проверяет попадание каждого в область
#  контроля по точке «ступней» (как в профессиональных VMS).
# ----------------------------------------------------------------------------
_PERSON_HOG = None
_PERSON_HOG_LOCK = threading.Lock()


def _people_hog():
    """Инициализированный HOG-детектор (лениво, один на процесс)."""
    global _PERSON_HOG
    with _PERSON_HOG_LOCK:
        if _PERSON_HOG is None:
            if not _CV2:
                _PERSON_HOG = False
            else:
                try:
                    h = cv2.HOGDescriptor()
                    h.setSVMDetector(
                        cv2.HOGDescriptor_getDefaultPeopleDetector())
                    _PERSON_HOG = h
                except Exception:
                    _PERSON_HOG = False
    return _PERSON_HOG or None


def _nms_rects(rects, weights, thr=0.25):
    """Non-maximum suppression: убрать дублирующиеся рамки одного человека."""
    order = sorted(range(len(rects)), key=lambda i: -weights[i])
    keep, dead = [], [False] * len(rects)
    for pos, i in enumerate(order):
        if dead[i]:
            continue
        x, y, w, h = (int(v) for v in rects[i])
        keep.append((x, y, w, h))
        for j in order[pos + 1:]:
            if dead[j]:
                continue
            xx, yy, ww, hh = (int(v) for v in rects[j])
            ix = max(0, min(x + w, xx + ww) - max(x, xx))
            iy = max(0, min(y + h, yy + hh) - max(y, yy))
            inter = ix * iy
            uni = w * h + ww * hh - inter
            if uni > 0 and inter / uni > thr:
                dead[j] = True
    return keep


def _point_in_poly(px, py, points):
    """Лучевый тест «точка внутри полигона» (без OpenCV)."""
    inside = False
    n = len(points)
    j = n - 1
    for i in range(n):
        xi, yi = points[i]
        xj, yj = points[j]
        if (yi > py) != (yj > py):
            xint = (xj - xi) * (py - yi) / (yj - yi + 1e-12) + xi
            if px < xint:
                inside = not inside
        j = i
    return inside


def _zone_person_inside(zpts, frame_size, boxes):
    """Сколько людей находятся в области контроля. Точка привязки —
    «ступни» человека (нижняя центральная точка рамки): человек считается
    вошедшим, когда переступил границу области. boxes — (x, y, w, h, ...)
    в пикселях исходного кадра; frame_size — (W, H)."""
    if not zpts:
        return len(boxes or [])
    W, H = frame_size
    cnt = 0
    for b in (boxes or []):
        x, y, w, h = b[:4]
        px = (x + w / 2.0) / max(1, W)
        py = min(1.0, (y + h) / max(1, H))
        if _point_in_poly(px, py, zpts):
            cnt += 1
    return cnt


def people_detect(frame_bytes, max_w=800, min_h=48):
    """Детекция людей в JPEG-кадре (HOG+SVM).
    Возвращает (рамки, (W, H)) — рамки (x, y, w, h) в координатах
    исходного кадра, или None — детектор недоступен (нет OpenCV)."""
    hog = _people_hog()
    if hog is None:
        return None
    try:
        arr = np.frombuffer(frame_bytes, np.uint8)
        img = cv2.imdecode(arr, cv2.IMREAD_GRAYSCALE)
        if img is None:
            return None
        h0, w0 = img.shape[:2]
        if w0 > max_w:
            k = max_w / float(w0)
            img = cv2.resize(img, (max(1, int(w0 * k)), max(1, int(h0 * k))),
                             interpolation=cv2.INTER_AREA)
        # выравнивание гистограммы — устойчивость ночью/в контровом свете
        img = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8)).apply(img)
        rects, weights = hog.detectMultiScale(
            img, winStride=(8, 8), padding=(8, 8), scale=1.06,
            hitThreshold=-0.35)
        H, W = img.shape[:2]
        kx = w0 / float(W)
        ky = h0 / float(H)
        boxes = []
        for (x, y, w, h) in _nms_rects(rects,
                                       [float(w[0]) for w in weights]):
            if h < min_h:            # слишком мелко — шум для 64x128 окна
                continue
            ar = h / float(max(1, w))
            if not (1.05 <= ar <= 6.5):    # пропорции фигуры человека
                continue
            boxes.append((int(x * kx), int(y * ky),
                          int(w * kx), int(h * ky)))
        return boxes, (w0, h0)
    except Exception:
        return None



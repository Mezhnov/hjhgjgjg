                'pass': c.get('pass', ''),
                'auth': c.get('auth', 'digest'),
                'name': c.get('name', ''),
                'vendor_key': c.get('vendor_key', ''),
                'rtsp_main': c.get('rtsp_main', ''),
                'rtsp_sub': c.get('rtsp_sub', ''),
                'remember': c.get('remember', False),
                'ptz': c.get('ptz', False),
                'analytics': c.get('analytics') or {},
            }
        cfg = {'subnets': STATE.subnets, 'settings': STATE.settings,
               'cameras': cams}
    tmp = CONFIG_FILE + '.tmp'
    try:
        with open(tmp, 'w', encoding='utf-8') as f:
            json.dump(cfg, f, ensure_ascii=False, indent=1)
        os.replace(tmp, CONFIG_FILE)
    except Exception as e:
        LOG.add('error', f'Не удалось сохранить конфигурацию: {e}')


def load_config():
    if not os.path.isfile(CONFIG_FILE):
        return
    try:
        with open(CONFIG_FILE, 'r', encoding='utf-8') as f:
            cfg = json.load(f)
        with STATE.lock:
            STATE.subnets = cfg.get('subnets') or [DEFAULT_SUBNET]
            STATE.settings.update(cfg.get('settings') or {})
            for ip, c in (cfg.get('cameras') or {}).items():
                STATE.cameras[ip] = {
                    'user': c.get('user', ''), 'pass': c.get('pass', ''),
                    'auth': c.get('auth', 'digest'), 'name': c.get('name', ''),
                    'vendor_key': c.get('vendor_key', ''),
                    'rtsp_main': c.get('rtsp_main', ''),
                    'rtsp_sub': c.get('rtsp_sub', ''),
                    'remember': c.get('remember', False),
                    'ptz': c.get('ptz', False),
                    'analytics': c.get('analytics') or {},
                    'state': 'offline', 'connected_at': 0,
                }
        LOG.add('info', f'Конфигурация загружена: камер сохранено '
                        f'{len(STATE.cameras)}')
    except Exception as e:
        LOG.add('error', f'Ошибка чтения конфигурации: {e}')



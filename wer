.lay-opt .grid{width:26px;height:19px;display:grid;gap:2px;flex-shrink:0}
.lay-opt .grid i{background:currentColor;border-radius:1.5px;opacity:.85;
    display:block}
.lay-opt .txt{display:flex;flex-direction:column;line-height:1.25}
.lay-opt .txt small{font-weight:500;color:var(--dim2);font-size:9.5px}
.layout-btn{min-width:38px;height:32px;border-radius:8px;border:1px solid var(--border2);
    background:#fff;color:var(--dim);cursor:pointer;font-size:11px;
    font-weight:700;font-family:inherit;transition:all .15s;display:flex;
    align-items:center;justify-content:center;gap:2px;box-shadow:var(--shadow-sm)}
.layout-btn:hover{color:var(--tie-orange-d);border-color:var(--tie-orange)}
.layout-btn.active{background:var(--tie-orange);color:#fff;border-color:var(--tie-orange);
    box-shadow:0 2px 8px rgba(252,79,1,.35)}
.wall{flex:1;overflow:auto;padding:12px;display:grid;gap:10px;
    grid-auto-rows:minmax(120px,1fr);min-height:0}
.wall.l1{grid-template-columns:1fr}
.wall.l4{grid-template-columns:1fr 1fr}
.wall.l6{grid-template-columns:1fr 1fr 1fr}
.wall.l9{grid-template-columns:1fr 1fr 1fr}
.wall.l16{grid-template-columns:1fr 1fr 1fr 1fr}
.tile{position:relative;background:#000;border:2px solid var(--border);
    border-radius:12px;overflow:hidden;cursor:pointer;transition:border-color .2s,
    box-shadow .2s,transform .2s;min-height:110px;box-shadow:var(--shadow-sm)}
.tile::after{content:'';position:absolute;inset:0;border-radius:10px;
    box-shadow:inset 0 0 60px rgba(0,0,0,.35);pointer-events:none;z-index:4}
.tile:hover{border-color:var(--border2);transform:translateY(-1px);
    box-shadow:var(--shadow-md)}
.tile.selected{border-color:var(--tie-orange);box-shadow:0 0 0 1px var(--tie-orange),
    0 4px 18px rgba(252,79,1,.2)}
.tile img{width:100%;height:100%;object-fit:contain;position:absolute;inset:0;
    background:#000}
.tile-top{position:absolute;top:0;left:0;right:0;z-index:5;display:flex;
    justify-content:space-between;padding:7px 9px;
    background:linear-gradient(180deg,rgba(0,0,0,.78),transparent);
    opacity:0;transition:opacity .2s}
.tile:hover .tile-top,.tile.selected .tile-top{opacity:1}
.tile-name{font-size:11px;font-weight:700;color:#fff;text-shadow:0 1px 3px #000;
    display:flex;align-items:center;gap:6px;min-width:0}
.tile-name span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:65%}
.tile-actions{display:flex;gap:4px}
.tile-actions .icon-btn{width:28px;height:28px;font-size:13px}
.tile-bottom{position:absolute;bottom:0;left:0;right:0;z-index:5;padding:14px 9px 7px;
    background:linear-gradient(0deg,rgba(0,0,0,.82),transparent);
    display:flex;justify-content:space-between;align-items:flex-end;
    font-size:10px;color:var(--dim);font-weight:600}
.tile-ip{color:var(--tie-orange-l);font-weight:700}
.tile-fps{background:rgba(0,0,0,.55);padding:2px 7px;border-radius:9px}
.tile-empty{position:absolute;inset:0;display:flex;flex-direction:column;
    align-items:center;justify-content:center;gap:7px;color:var(--dim2);
    background:#0d0f13}
.tile-empty .big{font-size:30px;opacity:.55}
.tile-empty .t{font-size:11.5px;opacity:.85}
.tile-empty.free-slot{background:rgba(255,255,255,.012);
    outline:1.5px dashed rgba(255,255,255,.09);outline-offset:-8px;
    border-radius:9px}
.rec-dot{width:9px;height:9px;border-radius:50%;background:var(--err);
    animation:pulse .9s infinite;flex-shrink:0}
.spin{width:22px;height:22px;border:3px solid rgba(252,79,1,.2);
    border-top-color:var(--tie-orange);border-radius:50%;
    animation:rot .8s linear infinite;margin:0 auto}
@keyframes rot{to{transform:rotate(360deg)}}

/* прогресс сканирования */
.scanbar{height:3px;background:var(--panel2);position:relative;overflow:hidden}
.scanbar .fill{position:absolute;inset:0;width:0%;background:linear-gradient(90deg,
    var(--tie-orange),var(--tie-orange-l));transition:width .4s;
    box-shadow:0 0 10px rgba(252,79,1,.5)}

/* ================= ЖУРНАЛ СОБЫТИЙ ================= */
.events-wrap{flex-shrink:0;border-top:1px solid var(--border);background:#fff;
    transition:height .25s;height:42px;overflow:hidden;display:flex;
    flex-direction:column;box-shadow:0 -1px 4px rgba(16,24,40,.04)}
.events-wrap.open{height:230px}
.events-head{height:42px;display:flex;align-items:center;gap:12px;
    padding:0 16px;cursor:pointer;user-select:none;flex-shrink:0}
.ev-title{display:inline-flex;align-items:center;gap:8px;font-size:10.5px;
    text-transform:uppercase;letter-spacing:1.6px;font-weight:800;
    color:var(--dim);cursor:pointer}
.ev-title .ic{width:14px;height:14px;color:var(--tie-orange)}
.ev-filters{display:flex;gap:6px;margin-left:10px}
.ev-filter{padding:5px 14px;border-radius:18px;font-size:10.5px;font-weight:700;
    border:1.5px solid var(--border2);color:var(--dim);cursor:pointer;
    text-transform:uppercase;letter-spacing:.5px;background:#fff;
    transition:all .15s;white-space:nowrap;line-height:1}
.ev-filter:hover{border-color:var(--tie-orange);color:var(--tie-orange-d)}
.ev-filter.active{color:#fff;border-color:var(--tie-orange);
    background:linear-gradient(180deg,var(--tie-orange-l) 0%,
    var(--tie-orange) 100%);box-shadow:0 2px 8px rgba(252,79,1,.35),
    inset 0 1px 0 rgba(255,255,255,.22)}
.ev-count{font-size:11px;font-weight:800;color:var(--dim);
    letter-spacing:.4px;white-space:nowrap;text-transform:uppercase}
.ev-count b{color:var(--tie-orange-d)}
.ev-toggle{display:flex;align-items:center;justify-content:center;width:26px;
    height:26px;border-radius:8px;color:var(--dim);border:1px solid var(--border);
    background:var(--panel2);transition:all .15s}
.events-head:hover .ev-toggle{border-color:var(--tie-orange);
    color:var(--tie-orange-d);background:#fff}
.events-list{flex:1;overflow-y:auto;font-size:12px;padding:0 16px 12px}
.ev-line{display:flex;gap:10px;padding:5px 0;border-bottom:1px solid
    var(--border);align-items:center}
.ev-line:last-child{border-bottom:none}
.ev-ts{color:var(--dim2);flex-shrink:0;font-family:'Consolas','Courier New',
    monospace;font-size:11px;font-variant-numeric:tabular-nums}
.ev-ico{flex-shrink:0;width:22px;height:22px;border-radius:7px;display:flex;
    align-items:center;justify-content:center;font-weight:700;color:#fff}
.ev-ico .ic{width:12px;height:12px}
.ev-info .ev-ico{background:linear-gradient(160deg,#3ba0dd,#0e6ea8)}
.ev-success .ev-ico{background:linear-gradient(160deg,#2ebd6e,#128a43)}
.ev-warn .ev-ico{background:linear-gradient(160deg,#f0a13c,#c06f00)}
.ev-error .ev-ico{background:linear-gradient(160deg,#ef6a6a,#c02f2f)}
.ev-msg{color:var(--text);word-break:break-word;flex:1;min-width:0}
.ev-ip{color:var(--tie-blue-l);flex-shrink:0;font-weight:700;
    background:#e6f1f9;border:1px solid #cfe2f0;padding:1px 8px;
    border-radius:9px;font-size:10.5px;font-variant-numeric:tabular-nums}
.ev-error .ev-msg{color:#b93737}

/* ================= ФУТЕР ================= */
.footer{flex-shrink:0;background:linear-gradient(180deg,#fbfcfd 0%,#f3f6f9 100%);
    border-top:1px solid var(--border);
    padding:10px 20px;display:flex;justify-content:space-between;align-items:center;
    flex-wrap:wrap;gap:10px;font-size:10.5px;color:var(--dim)}
.footer-left{display:flex;gap:20px;flex-wrap:wrap;align-items:center}
.f-item{display:inline-flex;align-items:center;gap:7px}
.f-item .ic{width:13px;height:13px;color:var(--tie-orange);flex-shrink:0}
.footer a{color:var(--text);text-decoration:none;font-weight:600;
    transition:color .15s}
.footer a:hover{color:var(--tie-orange-d);text-decoration:underline}
.f-sep{width:1px;height:14px;background:var(--border2);flex-shrink:0}
.f-copy{color:var(--dim2);font-size:10px;font-weight:600;letter-spacing:.3px}
.footer-slogan{display:inline-flex;align-items:center;gap:8px;
    color:var(--tie-orange-d);font-weight:800;letter-spacing:.6px;
    text-transform:uppercase;font-size:10.5px;
    background:linear-gradient(135deg,#fff4ee 0%,#ffe8dc 100%);
    border:1px solid #f6cdb4;padding:6px 14px;border-radius:20px}
.footer-slogan .ic{width:13px;height:13px}

/* тонкая разделительная линия над футером */
.footer{position:relative}
.footer::before{content:'';position:absolute;top:-1px;left:0;right:0;height:1px;
    background:linear-gradient(90deg,transparent 0%,var(--border2) 18%,
    var(--border2) 82%,transparent 100%);pointer-events:none}

/* ================= МОДАЛКИ ================= */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(23,32,43,.45);
    z-index:100;align-items:center;justify-content:center;backdrop-filter:blur(3px)}
.modal-overlay.active{display:flex}
.modal{background:#fff;border:1px solid var(--border);border-top:3px solid
    var(--tie-orange);border-radius:14px;width:430px;max-width:94vw;
    max-height:90vh;overflow-y:auto;padding:24px;box-shadow:var(--shadow-lg)}
.modal.wide{width:760px}
.modal h3{font-size:16px;font-weight:800;color:var(--text);display:flex;align-items:center;
    gap:9px;margin-bottom:4px}
.modal h3 .vendor-badge{width:30px;height:30px;font-size:9.5px;border-radius:7px}
.modal .sub{color:var(--dim);font-size:12px;margin-bottom:16px}
.modal label{display:block;font-size:10px;text-transform:uppercase;letter-spacing:1.3px;
    color:var(--dim);font-weight:700;margin:13px 0 5px}
.modal input,.modal select{width:100%;background:var(--panel2);border:1px solid var(--border2);
    border-radius:8px;color:var(--text);padding:11px 12px;font-size:14px;
    font-family:inherit;outline:none;transition:border-color .2s,box-shadow .2s}
.modal input:focus,.modal select:focus{border-color:var(--tie-orange);background:#fff;
    box-shadow:0 0 0 3px rgba(252,79,1,.1)}
.modal .check{display:flex;align-items:center;gap:9px;margin-top:14px;font-size:12.5px;
    color:var(--text);cursor:pointer;user-select:none}
.modal .check input{width:16px;height:16px;accent-color:var(--tie-orange)}
.m-btns{display:flex;gap:8px;margin-top:22px}
.m-btns .btn{flex:1;justify-content:center}
.btn.danger{background:var(--err)}.btn.danger:hover{background:#c0392b;
    box-shadow:0 5px 14px rgba(231,76,60,.35)}
.btn.gray{background:var(--panel2);color:var(--text);border:1px solid var(--border2)}
.btn.gray:hover{background:#e7ecf2}
.m-msg{display:none;margin-top:12px;padding:10px 12px;border-radius:7px;
    font-size:12.5px;font-weight:600}
.m-msg.show{display:block}
.m-msg.info{background:#e6f1f9;color:#0b5c94}
.m-msg.ok{background:#e7f6ed;color:#116b3a}
.m-msg.err{background:#fbe9e9;color:#a33030}
.hint-box{margin-top:14px;padding:10px 12px;border-radius:8px;font-size:11.5px;
    background:#eef6fc;border:1px solid #cfe2f0;color:#33586f}
.hint-box b{color:#14496b}
.subnet-row{display:flex;gap:7px;margin-bottom:7px;align-items:center}
.subnet-row input{flex:1}
.subnet-row .icon-btn{width:34px;height:38px;font-size:14px}
.settings-row{display:flex;justify-content:space-between;align-items:center;
    padding:11px 0;border-bottom:1px solid var(--border)}
.settings-row .lab{font-size:13px;font-weight:600}
.settings-row .desc{font-size:11px;color:var(--dim);margin-top:2px}
.settings-row select,.settings-row input[type=number]{width:170px}
table.arch{width:100%;border-collapse:collapse;font-size:12px}
table.arch th{text-align:left;color:var(--dim2);font-size:10px;text-transform:uppercase;
    letter-spacing:1px;padding:8px;border-bottom:2px solid var(--border2);
    font-weight:800;white-space:nowrap}
table.arch td{padding:9px 8px;border-bottom:1px solid var(--border);vertical-align:middle}
table.arch tr:hover td{background:var(--panel2)}
.arch-empty{display:flex;flex-direction:column;align-items:center;gap:8px;
    padding:26px 10px;color:var(--dim);text-align:center}
.arch-empty .ic.xl{opacity:.45}
.arch-empty b{color:var(--text)}
.arch-empty small{font-size:11px;line-height:1.6;max-width:420px}
.arch-rec{display:inline-flex;align-items:center;gap:6px;color:var(--ok);
    font-weight:800}

/* ================= ПОЛНЫЙ ЭКРАН ================= */
.fs{display:none;position:fixed;inset:0;background:#000;z-index:200;
    flex-direction:column}
.fs.active{display:flex}
.fs-head{height:52px;flex-shrink:0;display:flex;align-items:center;gap:14px;
    padding:0 18px;background:linear-gradient(180deg,rgba(12,14,17,.97),rgba(12,14,17,.82));
    border-bottom:2px solid var(--tie-orange);z-index:210}
.fs-title{font-size:14px;font-weight:700;color:#fff;white-space:nowrap;
    overflow:hidden;text-overflow:ellipsis}
.fs-title small{color:var(--dim);font-weight:500;margin-left:8px;font-size:11px}
.fs-stage{flex:1;position:relative;overflow:hidden;background:#000;
    display:flex;align-items:center;justify-content:center;min-height:0;
    transition:box-shadow .35s}
.fs-stage img{max-width:100%;max-height:100%;object-fit:contain;
    transition:transform .08s linear;will-change:transform;cursor:grab}
.fs-stage img.dragging{cursor:grabbing}
.fs-nav{position:absolute;top:50%;transform:translateY(-50%);z-index:205;
    width:52px;height:86px;background:rgba(10,12,15,.72);border:2px solid
    var(--tie-orange);color:var(--tie-orange);font-size:28px;cursor:pointer;
    display:flex;align-items:center;justify-content:center;border-radius:10px;
    transition:all .18s;backdrop-filter:blur(3px)}
.fs-nav:hover{background:var(--tie-orange);color:#fff}
.fs-prev{left:18px}.fs-next{right:18px}
.fs-strip{height:104px;flex-shrink:0;background:rgba(12,14,17,.95);
    border-top:1px solid var(--border2);display:flex;gap:8px;padding:9px 12px;
    overflow-x:auto;z-index:205}
.fs-thumb{flex-shrink:0;width:158px;height:86px;border:2px solid var(--border2);
    border-radius:7px;overflow:hidden;cursor:pointer;position:relative;
    background:#000;transition:all .15s}
.fs-thumb:hover{border-color:var(--tie-orange-l)}
.fs-thumb.active{border-color:var(--tie-orange);box-shadow:0 0 14px rgba(252,79,1,.5)}
.fs-thumb img{width:100%;height:100%;object-fit:cover}
.fs-thumb .lab{position:absolute;bottom:0;left:0;right:0;background:rgba(0,0,0,.8);
    font-size:9.5px;color:var(--tie-orange-l);font-weight:700;padding:2px 5px;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:center}
.fs-thumb .dot{position:absolute;top:5px;right:5px;width:8px;height:8px;
    border-radius:50%;background:var(--ok);box-shadow:0 0 6px var(--ok)}
.fs-zoom-ind{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);
    background:rgba(0,0,0,.6);border-radius:16px;padding:5px 14px;font-size:11.5px;
    color:var(--dim);z-index:204;pointer-events:none}
.fs-zone{position:absolute;pointer-events:none;z-index:203;overflow:visible}
.fs-zone polygon{fill:rgba(46,204,113,.15);stroke:#2ecc71;stroke-width:2;
    stroke-dasharray:7 5;vector-effect:non-scaling-stroke;
    filter:drop-shadow(0 0 8px rgba(46,204,113,.6))}
.fs-zone.zr polygon{stroke:#ff6b5e;fill:rgba(255,107,94,.12)}
/* ---- PTZ-панель: красивый джойстик ---- */
.ptz-panel{position:absolute;right:18px;top:64px;z-index:206;background:
    linear-gradient(180deg,rgba(20,25,33,.96),rgba(14,17,21,.96));
    border:1px solid rgba(252,79,1,.35);border-radius:16px;
    padding:16px 14px 12px;backdrop-filter:blur(10px);
    box-shadow:0 12px 38px rgba(0,0,0,.5),0 0 0 1px rgba(252,79,1,.06);
    width:236px;
    font-family:'Montserrat',sans-serif}
.ptz-title{font-size:10.5px;text-transform:uppercase;letter-spacing:2px;
    color:var(--tie-orange);font-weight:800;margin-bottom:10px;text-align:center;
    display:flex;align-items:center;justify-content:center;gap:6px}
.ptz-title .live-dot{display:inline-block;width:7px;height:7px;border-radius:50%;
    background:var(--ok);box-shadow:0 0 8px var(--ok);
    animation:ptz-live 1.4s ease-in-out infinite}
@keyframes ptz-live{0%,100%{opacity:.35}50%{opacity:1}}
/* центральный джойстик-контейнер */
.ptz-joy{position:relative;width:200px;height:200px;margin:4px auto 10px;
    background:radial-gradient(circle at 50% 50%,rgba(252,79,1,.10),rgba(0,0,0,.4) 65%);
    border-radius:50%;border:1px solid rgba(252,79,1,.28);
    box-shadow:inset 0 0 26px rgba(0,0,0,.55),0 4px 14px rgba(0,0,0,.35);
    cursor:grab;touch-action:none;user-select:none}
.ptz-joy.dragging{cursor:grabbing}
/* риски-оригентация */
.ptz-joy::before,.ptz-joy::after{content:"";position:absolute;background:
    rgba(252,79,1,.18);pointer-events:none}
.ptz-joy::before{top:50%;left:8%;right:8%;height:1px;transform:translateY(-.5px)}
.ptz-joy::after{left:50%;top:8%;bottom:8%;width:1px;transform:translateX(-.5px)}
.ptz-joy-ring{position:absolute;inset:18%;border-radius:50%;
    border:1px dashed rgba(255,255,255,.10);pointer-events:none}
.ptz-joy-ring2{position:absolute;inset:36%;border-radius:50%;
    border:1px dashed rgba(255,255,255,.06);pointer-events:none}
.ptz-joy-center{position:absolute;left:50%;top:50%;width:8px;height:8px;
    border-radius:50%;background:rgba(255,255,255,.18);
    transform:translate(-50%,-50%);pointer-events:none}
.ptz-knob{position:absolute;left:50%;top:50%;width:38px;height:38px;
    border-radius:50%;
    background:radial-gradient(circle at 35% 30%,var(--tie-orange-l),var(--tie-orange-d));
    border:2px solid rgba(255,255,255,.85);
    box-shadow:0 4px 12px rgba(0,0,0,.5),0 0 16px rgba(252,79,1,.45);
    transform:translate(-50%,-50%);
    transition:transform .08s ease-out,box-shadow .15s;pointer-events:none}
.ptz-panel.active .ptz-knob{box-shadow:0 4px 16px rgba(0,0,0,.55),
    0 0 22px rgba(252,79,1,.7)}
/* кнопки по краям джойстика */
.ptz-edge{position:absolute;width:26px;height:26px;border-radius:50%;
    background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.10);
    color:rgba(255,255,255,.85);cursor:pointer;
    display:flex;align-items:center;justify-content:center;
    transition:all .12s}
.ptz-edge:hover{background:rgba(252,79,1,.22);border-color:var(--tie-orange)}
.ptz-edge:active{background:var(--tie-orange);color:#fff;transform:scale(.94)}
.ptz-edge .ic{width:14px;height:14px}
.ptz-edge.n{top:4px;left:50%;transform:translateX(-50%)}
.ptz-edge.s{bottom:4px;left:50%;transform:translateX(-50%)}
.ptz-edge.w{left:4px;top:50%;transform:translateY(-50%)}
.ptz-edge.e{right:4px;top:50%;transform:translateY(-50%)}
.ptz-edge.n:hover,.ptz-edge.s:hover{transform:translateX(-50%) scale(1.08)}
.ptz-edge.w:hover,.ptz-edge.e:hover{transform:translateY(-50%) scale(1.08)}
.ptz-edge.n:active,.ptz-edge.s:active{transform:translateX(-50%) scale(.94)}
.ptz-edge.w:active,.ptz-edge.e:active{transform:translateY(-50%) scale(.94)}
/* зум-слайдер */
.ptz-zoom-wrap{display:flex;align-items:center;gap:8px;margin:6px 0 4px;
    padding:6px 8px;background:rgba(0,0,0,.32);border-radius:8px}
.ptz-zoom-wrap .lab{font-size:9.5px;text-transform:uppercase;letter-spacing:1px;
    color:var(--dim2);font-weight:700;min-width:36px}
.ptz-zoom-wrap .ptz-speed-val{min-width:28px}
.ptz-zoom{flex:1;height:6px;-webkit-appearance:none;appearance:none;
    background:linear-gradient(90deg,var(--tie-orange-d),var(--tie-orange-l));
    border-radius:6px;outline:none;cursor:pointer}
.ptz-zoom::-webkit-slider-thumb{-webkit-appearance:none;width:16px;height:16px;
    border-radius:50%;background:#fff;border:2px solid var(--tie-orange);
    box-shadow:0 2px 6px rgba(0,0,0,.4);cursor:grab}
.ptz-zoom::-moz-range-thumb{width:16px;height:16px;border-radius:50%;
    background:#fff;border:2px solid var(--tie-orange);cursor:grab}
/* ряд кнопок: home / stop / preset */
.ptz-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:5px;margin-top:8px}
.ptz-btn{height:30px;background:rgba(255,255,255,.05);
    border:1px solid rgba(255,255,255,.10);color:var(--text);border-radius:7px;
    cursor:pointer;font-size:11.5px;
    transition:all .12s;display:flex;align-items:center;justify-content:center;
    gap:4px;font-weight:600}
.ptz-btn .ic{width:13px;height:13px}
.ptz-btn:hover{border-color:var(--tie-orange);color:var(--tie-orange);
    background:rgba(252,79,1,.10)}
.ptz-btn:active{background:var(--tie-orange);color:#fff;transform:scale(.96)}
.ptz-btn.danger:hover{border-color:var(--err);color:var(--err);
    background:rgba(214,60,60,.10)}
.ptz-btn.danger:active{background:var(--err);color:#fff}
.ptz-speed-wrap{display:flex;align-items:center;gap:6px;margin-top:6px;
    font-size:10px;color:var(--dim2)}
.ptz-speed{flex:1;accent-color:var(--tie-orange);height:4px}
.ptz-speed-val{font-family:'Montserrat',monospace;font-weight:700;
    color:var(--tie-orange);min-width:32px;text-align:right}
/* пресеты */
.ptz-presets{margin-top:8px;border-top:1px solid rgba(255,255,255,.08);
    padding-top:8px;max-height:96px;overflow-y:auto}
.ptz-presets-title{font-size:9.5px;text-transform:uppercase;letter-spacing:1.4px;
    color:var(--dim2);font-weight:800;margin-bottom:6px;display:flex;
    align-items:center;justify-content:space-between}
.ptz-presets-list{display:flex;flex-wrap:wrap;gap:4px}
.ptz-preset{padding:4px 9px;font-size:10.5px;border-radius:5px;
    background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);
    color:var(--text);cursor:pointer;transition:all .12s}
.ptz-preset:hover{background:var(--tie-orange);color:#fff;border-color:var(--tie-orange)}
.ptz-empty{font-size:10.5px;color:var(--dim2);font-style:italic;padding:4px 0}
.ptz-hint{display:none}
.ptz-hint kbd{display:none}

/* ================= АНАЛИТИКА ================= */
.tile.motion{border-color:var(--warn);animation:motionpulse 1.2s infinite}
@keyframes motionpulse{0%,100%{box-shadow:0 0 0 1px var(--warn),
    0 0 8px rgba(243,156,18,.25)}50%{box-shadow:0 0 0 2px var(--warn),
    0 0 22px rgba(243,156,18,.6)}}
.tile-motion{position:absolute;top:8px;left:50%;transform:translateX(-50%);
    z-index:6;background:var(--warn);color:#1a1205;font-size:9.5px;
    font-weight:800;padding:3px 10px;border-radius:11px;letter-spacing:.8px;
    display:flex;align-items:center;gap:5px;box-shadow:0 2px 10px rgba(0,0,0,.5);
    pointer-events:none}
.tile-people{position:absolute;bottom:38px;left:8px;z-index:6;
    background:rgba(13,102,56,.92);color:#fff;font-size:9.5px;font-weight:800;
    padding:3px 10px;border-radius:11px;letter-spacing:.8px;
    display:flex;align-items:center;gap:5px;box-shadow:0 2px 10px rgba(0,0,0,.45);
    pointer-events:none}
.tile-people .ic{width:11px;height:11px}
/* ---- индикация присутствия человека: красное = человек, зелёное = пусто ---- */
.tile.p-red{border-color:#ff453a !important;animation:presence-red 1.25s infinite}
@keyframes presence-red{0%,100%{box-shadow:inset 0 0 0 3px rgba(255,69,58,.85),
    0 0 14px rgba(255,69,58,.30)}50%{box-shadow:inset 0 0 0 3px rgba(255,69,58,1),
    0 0 28px rgba(255,69,58,.60)}}
.tile.p-green{border-color:rgba(52,199,89,.62);box-shadow:inset 0 0 0 2px rgba(52,199,89,.38),
    0 0 10px rgba(52,199,89,.14)}
.tile.p-red .zone-ov polygon{fill:rgba(255,99,88,.16);stroke:#ff8d84}
.tile-people.red{background:rgba(196,32,24,.95);box-shadow:0 2px 14px rgba(255,69,58,.55)}
#fs.p-red .fs-stage{box-shadow:inset 0 0 0 4px rgba(255,69,58,.85),
    inset 0 0 70px rgba(255,69,58,.22)}
#fs.p-green .fs-stage{box-shadow:inset 0 0 0 3px rgba(52,199,89,.42)}
.badge.b-red{background:#c42018;color:#fff;box-shadow:0 0 14px rgba(255,69,58,.6)}
.cam-row .p-dot{display:inline-block;width:8px;height:8px;border-radius:50%;
    background:#ff453a;margin-right:5px;box-shadow:0 0 8px rgba(255,69,58,.8);
    animation:ptz-live 1.3s ease-in-out infinite;vertical-align:1px}
.an-switch{position:relative;width:40px;height:22px;flex-shrink:0;
    cursor:pointer;display:inline-block}
.an-switch input{opacity:0;width:0;height:0;position:absolute}
.an-switch .track{position:absolute;inset:0;background:var(--border2);
    border-radius:12px;transition:background .2s}
.an-switch .knob{position:absolute;top:3px;left:3px;width:16px;height:16px;
    background:#fff;border-radius:50%;transition:transform .2s}
.an-switch input:checked + .track{background:var(--ok)}
.an-switch input:checked + .track .knob{transform:translateX(18px)}
.an-cam-row{display:flex;align-items:center;gap:11px;padding:11px 4px;
    border-bottom:1px solid var(--border)}
.an-cam-row .cam-meta{flex:1;min-width:0}
.an-cam-row select,.an-cam-row input[type=number]{width:108px;padding:7px 8px;
    font-size:12px;background:var(--panel2);border:1px solid var(--border2);
    border-radius:6px;color:var(--text);font-family:inherit;outline:none}
.an-cam-row select:focus,.an-cam-row input:focus{border-color:var(--tie-orange)}
.an-col-lab{font-size:9px;color:var(--dim2);text-transform:uppercase;
    letter-spacing:1px;margin-bottom:3px;font-weight:700}
.an-stats{font-size:10.5px;color:var(--dim);text-align:right;line-height:1.5;
    min-width:88px;flex-shrink:0}
.an-stats b{color:var(--warn);font-size:12px}
.an-backend{display:flex;align-items:center;gap:8px;padding:9px 12px;
    border-radius:9px;font-size:12px;margin-bottom:12px;
    background:#eef6fc;border:1px solid #cfe2f0;color:#33586f}
.an-backend.err{background:#fbe9e9;border-color:#f0c4c4;color:#a33030}
/* --- Активность за 24 часа: новая гистограмма --- */
.an-hhead{display:flex;align-items:baseline;justify-content:space-between;
    gap:10px;margin-top:10px}
.an-hstat{font-size:11px;color:var(--dim);font-weight:600;white-space:nowrap}
.an-hstat b{color:var(--text);font-weight:800}
.an-hstat .live-dot{display:inline-block;width:7px;height:7px;border-radius:50%;
    background:var(--err);margin-right:5px;vertical-align:0px;
    animation:pulse 1.4s infinite}
.an-hchart{position:relative;display:flex;align-items:flex-end;height:118px;
    border:1px solid var(--border);border-radius:12px;background:#fff;
    box-shadow:var(--shadow-sm);margin:8px 0 0;padding:24px 14px 9px}
.an-hgrid{position:absolute;top:8px;bottom:8px;width:0;z-index:0;
    border-left:1px dashed #e2e9f1;pointer-events:none}
.an-hbar{flex:1;height:0;min-height:3px;margin:0 2px;border-radius:4px 4px 2px 2px;
    background:#edf1f6;position:relative;z-index:1;transition:height .4s ease}
.an-hbar.f{background:linear-gradient(180deg,#ffbe76 0%,#f08c00 100%);
    box-shadow:0 1px 2px rgba(240,140,0,.28)}
.an-hbar.f:hover{filter:brightness(1.08)}
.an-hbar.now{outline:2px solid var(--tie-orange);outline-offset:2px}
.an-hbar .val{position:absolute;top:-15px;left:50%;transform:translateX(-50%);
    font-size:9.5px;font-weight:800;color:#9a6200;white-space:nowrap;
    font-variant-numeric:tabular-nums}
.an-hnow{position:absolute;top:5px;right:9px;background:var(--tie-orange);
    color:#fff;font-size:9px;font-weight:800;letter-spacing:.6px;
    text-transform:uppercase;border-radius:6px;padding:2px 8px;
    box-shadow:0 1px 4px rgba(240,140,0,.4);font-variant-numeric:tabular-nums}
.an-hempty{position:absolute;inset:0;display:flex;align-items:center;
    justify-content:center;gap:9px;background:rgba(255,255,255,.78);
    color:var(--dim2);font-size:12.5px;font-weight:600;z-index:3;
    border-radius:12px}
.an-hempty .ic{width:20px;height:20px;opacity:.5;stroke-width:1.6}
.an-haxis{display:flex;padding:3px 14px 0}
.an-haxis span{flex:1;margin:0 2px;text-align:center;font-size:9.5px;
    color:var(--dim2);font-weight:700;white-space:nowrap;
    font-variant-numeric:tabular-nums}
.an-haxis span.lab{color:var(--dim)}
.an-hrange{display:flex;justify-content:space-between;padding:2px 14px 0;
    font-size:10px;color:var(--dim2);font-weight:600}
.an-hrange b{color:var(--dim);font-weight:800}
.an-events{display:grid;grid-template-columns:repeat(auto-fill,
    minmax(150px,1fr));gap:8px;margin-top:8px;max-height:330px;
    overflow-y:auto;padding-right:4px}
.aev{background:#fff;border:1px solid var(--border);border-radius:10px;
    overflow:hidden;cursor:pointer;transition:all .15s;box-shadow:var(--shadow-sm)}
.aev:hover{border-color:var(--warn);box-shadow:var(--shadow-md)}
.aev img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block;
    background:#000}
.aev .noimg{width:100%;aspect-ratio:16/9;display:flex;align-items:center;
    justify-content:center;color:var(--dim2);font-size:24px;
    background:var(--panel2)}
.aev-meta{padding:6px 8px 2px;font-size:10px;display:flex;
    justify-content:space-between;gap:6px;align-items:center}
.aev-type{font-weight:800;letter-spacing:.3px}
.aev-ts{color:var(--dim);font-variant-numeric:tabular-nums}
.aev-ts .ago{color:var(--dim2);font-size:9px;font-weight:600}
.aev-sub{padding:0 8px 7px;font-size:9.5px;color:var(--dim)}
.an-sess{border:1px solid var(--border);border-radius:10px;background:#fff;
    max-height:250px;overflow-y:auto;box-shadow:var(--shadow-sm)}
.an-sess table{width:100%;border-collapse:collapse;font-size:12px}
.an-sess th{position:sticky;top:0;background:var(--panel2);color:var(--dim2);
    font-size:9.5px;text-transform:uppercase;letter-spacing:.8px;text-align:left;
    padding:8px 10px;border-bottom:1px solid var(--border);z-index:2;
    white-space:nowrap;font-weight:700}
.an-sess td{padding:8px 10px;border-bottom:1px solid var(--border);
    vertical-align:middle;white-space:nowrap}
.an-sess tr:last-child td{border-bottom:none}
.an-sess .sess-cam{font-weight:600;max-width:180px;overflow:hidden;
    text-overflow:ellipsis}
.an-sess .sess-open{display:inline-flex;align-items:center;gap:6px;
    color:var(--ok);font-weight:700}
.an-sess .sess-open .rec-dot{background:var(--ok);animation:pulse 1.2s infinite}
.an-sess .sess-none{color:var(--dim2);font-style:italic}
.an-sess .dur{font-weight:800;color:var(--tie-orange)}
.an-sess .sess-empty{padding:12px;color:var(--dim2);font-size:12px}
.an-sess td.mt{font-family:'Consolas','Courier New',monospace;font-weight:700;
    font-size:11.5px;font-variant-numeric:tabular-nums}
.an-tl{border:1px solid var(--border);border-radius:10px;background:#fff;
    padding:9px 11px;box-shadow:var(--shadow-sm);max-height:190px;
    overflow-y:auto}
.tl-row{display:flex;align-items:center;gap:9px;padding:2.5px 0}
.tl-name{width:140px;flex-shrink:0;font-size:11px;font-weight:600;
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tl-cells{display:flex;gap:1.5px;flex:1;min-width:0}
/* --- Присутствие по минутам: новая шкала --- */
.tl-cell{flex:1;height:14px;border-radius:3px;background:#e8ecf2;min-width:2px;
    transition:background .2s}
.tl-cell.on{background:linear-gradient(180deg,#48d484,#1f9e5c)}
.tl-cell.on:last-child{background:linear-gradient(180deg,#ffbe76,#f08c00)}
.tl-sum{width:46px;flex-shrink:0;font-size:10px;color:var(--dim);text-align:right;
    font-weight:700;white-space:nowrap;font-variant-numeric:tabular-nums}
.tl-axis{display:flex;justify-content:space-between;font-size:9.5px;
    color:var(--dim2);margin-top:6px;padding-left:149px;padding-right:56px;
    font-weight:700;font-variant-numeric:tabular-nums}
.tl-axis .now-lab{color:var(--tie-orange);font-weight:800}

/* ================= РАМКИ ДЕТЕКЦИИ: ЛЮДИ / МАШИНЫ ================= */
.det-layer{position:absolute;pointer-events:none;z-index:3;overflow:visible}
#fs .det-layer{z-index:204}
.dbox{position:absolute;box-sizing:border-box;pointer-events:none;
    transition:left .55s linear,top .55s linear,width .55s linear,
    height .55s linear}
.dbox.p{border:2px dashed #ff5a4e;background:rgba(255,90,78,.10);
    border-radius:7px;box-shadow:0 0 12px rgba(255,69,58,.30)}
.dbox.v{border:2px dashed #ffd23f;background:rgba(255,210,63,.09);
    border-radius:7px;box-shadow:0 0 12px rgba(255,210,63,.22)}
.dbox .dlab{position:absolute;left:-2px;bottom:calc(100% + 3px);
    white-space:nowrap;font-size:9px;font-weight:800;letter-spacing:.6px;
    padding:2px 7px;border-radius:5px 5px 5px 0;color:#fff;
    text-transform:uppercase;font-variant-numeric:tabular-nums;
    text-shadow:0 1px 2px rgba(0,0,0,.45)}
.dbox.p .dlab{background:rgba(196,32,24,.94)}
.dbox.v .dlab{background:rgba(158,110,0,.94)}
.dbox.thin .dlab{bottom:auto;top:calc(100% + 3px);border-radius:5px 5px 0 5px}
.tile-people.veh{background:rgba(140,98,6,.94);left:auto;right:8px;
    box-shadow:0 2px 10px rgba(0,0,0,.45),0 0 10px rgba(255,210,63,.25)}
.badge.b-veh{background:#9a6b00;color:#fff;
    box-shadow:0 0 12px rgba(255,200,60,.35)}

/* ================= ОБЛАСТЬ КОНТРОЛЯ ================= */
.zone-ov{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;
    z-index:3;overflow:hidden}
.zone-ov polygon{fill:rgba(46,204,113,.13);stroke:#2ecc71;stroke-width:2;
    stroke-dasharray:6 4;vector-effect:non-scaling-stroke}
.zone-ov.zr polygon{stroke:#ff6b5e;fill:rgba(255,107,94,.10)}
.tile.motion .zone-ov polygon{fill:rgba(255,179,92,.24);stroke:#ffb35c;
    stroke-dasharray:none;animation:zoneglow 1.1s infinite}
@keyframes zoneglow{0%,100%{stroke-opacity:1;fill-opacity:1}
    50%{stroke-opacity:.45;fill-opacity:.6}}
.zr-chip{display:inline-block;background:#fdeeee;border:1px solid #f2c9c9;
    color:#a33030;font-size:8.5px;font-weight:800;letter-spacing:.6px;
    border-radius:8px;padding:1px 6px;text-transform:uppercase}
.an-zone-btn{width:32px;height:32px;flex-shrink:0}
.an-zone-btn.on{color:#17994e;border-color:#9bd8b6;background:#eefaf3}
.modal.zone-modal{width:880px}
.zone-top{display:flex;gap:12px;align-items:center;margin:12px 0;flex-wrap:wrap}
.zone-top select{flex:1;min-width:210px;padding:8px 10px;font-size:13px}
.zone-mode{display:flex;gap:11px;align-items:center;background:var(--panel2);
    border:1px solid var(--border);border-radius:10px;padding:7px 12px}
.zone-mode-txt b{font-size:11.5px;display:block;line-height:1.3}
.zone-mode-txt small{font-size:10px;color:var(--dim2);display:flex;gap:5px;
    align-items:center;margin-top:3px;white-space:nowrap}
.zone-mode-txt input{width:58px;padding:3px 6px;font-size:11px;
    border:1px solid var(--border2);border-radius:5px;background:#fff;
    color:var(--text);font-family:inherit;outline:none}
.zone-mode-txt input:focus{border-color:var(--tie-orange)}
.zone-stage{position:relative;background:#0b0f14;border:1px solid var(--border);
    border-radius:12px;overflow:hidden;aspect-ratio:16/9;user-select:none;
    touch-action:none;box-shadow:var(--shadow-sm);cursor:crosshair}
.zone-stage img{position:absolute;inset:0;width:100%;height:100%;object-fit:fill;
    pointer-events:none}
.zone-grid{position:absolute;inset:0;pointer-events:none;opacity:.55;
    background:linear-gradient(rgba(122,162,201,.13) 1px,transparent 1px),
        linear-gradient(90deg,rgba(122,162,201,.13) 1px,transparent 1px);
    background-size:44px 44px}
.zone-stage svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
.zone-stage svg polygon{fill:rgba(46,204,113,.17);stroke:#2ecc71;
    stroke-width:2;stroke-dasharray:7 5;vector-effect:non-scaling-stroke;
    filter:drop-shadow(0 0 7px rgba(46,204,113,.5))}
.zone-pts{position:absolute;inset:0;pointer-events:none}
.zone-pts .zp{position:absolute;width:13px;height:13px;border-radius:50%;
    background:#0b0f14;border:2px solid #2ecc71;transform:translate(-50%,-50%);
    cursor:grab;box-shadow:0 0 9px rgba(46,204,113,.8);pointer-events:auto;
    z-index:3}
.zone-pts .zp:hover{background:#2ecc71}
.zone-pts .zp:active{cursor:grabbing}
.zone-badge{position:absolute;top:10px;right:10px;font-size:9.5px;font-weight:800;
    letter-spacing:1px;padding:4px 11px;border-radius:12px;color:#d7f6e5;
    background:rgba(11,15,20,.72);border:1px solid rgba(46,204,113,.5);
    pointer-events:none;z-index:4}
.zone-badge.rec{color:#ffd9d5;border-color:rgba(255,107,94,.6)}
.zone-badge.full{color:#8fa1b5;border-color:rgba(255,255,255,.16)}
.zone-bar{display:flex;gap:8px;align-items:center;margin-top:12px;flex-wrap:wrap}
.zone-info{font-size:11.5px;color:var(--dim)}
.zone-info b{color:var(--ok)}

/* ================= ПЛЕЕР АРХИВА (в стиле TRASSIR) ================= */
.modal.pl-modal{width:920px}
.pl-h-name{color:var(--dim);font-weight:700;font-size:13px;margin-left:2px}
.pl-top{display:flex;gap:8px;align-items:center;margin:12px 0 12px;flex-wrap:wrap}
.pl-top select{width:auto;flex:1;min-width:190px;padding:8px 10px;font-size:13px}
.pl-date{display:flex;gap:5px;align-items:center}
.pl-date input[type=date]{width:148px;padding:8px 10px;font-size:13px}
.pl-date .icon-btn{width:36px;height:37px}
.pl-livebadge{display:inline-flex;align-items:center;gap:7px;height:33px;
    padding:0 12px;border-radius:17px;font-size:10.5px;font-weight:800;

let anTimer = null;

/* время с датой, если не сегодня */
const fmtTsFull = t => {
    const d = new Date(t*1000);
    const same = d.toDateString() === new Date().toDateString();
    return (same ? '' : d.toLocaleDateString('ru-RU') + ' ') +
        d.toLocaleTimeString('ru-RU');
};
/* длительность присутствия */
const fmtPresence = s => {
    s = Math.max(0, Math.round(s));
    if (s < 60) return s + ' с';
    const m = Math.floor(s/60), sec = s % 60;
    if (m < 60) return m + ' мин' + (sec ? ' ' + sec + ' с' : '');
    return Math.floor(m/60) + ' ч ' + (m % 60) + ' мин';
};
/* относительное время: «2 мин назад» */
const fmtAgo = t => {
    const s = Math.max(0, Math.floor(Date.now()/1000 - t));
    if (s < 45) return 'только что';
    if (s < 3600) return Math.max(1, Math.round(s/60)) + ' мин назад';
    const m = Math.floor(s/60);
    if (s < 86400) return Math.floor(m/60) + ' ч ' + (m % 60) + ' мин назад';
    return 'более суток назад';
};


<script>
/* ================== ДАННЫЕ ЗАГРУЗКИ ================== */
const BOOT = JSON.parse(document.getElementById('bootData').textContent);
const VENDORS = BOOT.vendors || {};
let S = {devices: [], cameras: {}, scan: {}, events: [], settings: {}};

/* ================== СОСТОЯНИЕ UI ================== */
let layout = 4, wallPage = 0, selectedIp = null;
let fsIp = null, fsZoom = 1, fsPanX = 0, fsPanY = 0;
let connectIp = null;
let evFilter = 'all', lastEvId = 0;
let stripTimer = null;

const $ = id => document.getElementById(id);
const ic = (name, cls='') => `<svg class="ic ${cls}"><use href="#i-${name}"/></svg>`;
const esc = s => String(s ?? '').replace(/[&<>"']/g,
    c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmtSize = b => b > 1048576 ? (b/1048576).toFixed(1)+' МБ'
    : b > 1024 ? (b/1024).toFixed(0)+' КБ' : b+' Б';
const fmtTs = t => new Date(t*1000).toLocaleTimeString('ru-RU');

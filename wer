def build_rtsp_url(ip, path, user, passwd):
    """Собирает RTSP URL с учётными данными (поддержка XM-путей)."""
    if '{user}' in path or '{pass}' in path:
        path = path.replace('{user}', user).replace('{pass}', passwd)
        return f'rtsp://{ip}:554{path}'
    return f'rtsp://{user}:{passwd}@{ip}:554{path}'


def probe_rtsp(rtsp_url, timeout=7):
    """Проверка RTSP-URL одним кадром через ffmpeg. True если поток живой."""
    if not FFMPEG_AVAILABLE:
        return False
    cmd = [FFMPEG_PATH, '-hide_banner', '-loglevel', 'error',
           '-rtsp_transport', 'tcp', TIMEOUT_FLAG[0], TIMEOUT_FLAG[1],
           '-i', rtsp_url, '-frames:v', '1', '-f', 'image2pipe',
           '-vcodec', 'mjpeg', 'pipe:1']
    try:
        proc = subprocess.run(cmd, capture_output=True, timeout=timeout,
                              creationflags=CREATE_NO_WINDOW)
        return (proc.returncode == 0 and len(proc.stdout) > 1500
                and proc.stdout[:2] == b'\xff\xd8')
    except subprocess.TimeoutExpired:
        return False
    except Exception:
        return False


def ffprobe_info(rtsp_url, timeout=12):
    """Телеметрия потока: кодек, разрешение, fps."""
    if not FFPROBE_PATH:
        return {}
    cmd = [FFPROBE_PATH, '-v', 'error', '-rtsp_transport', 'tcp',
           TIMEOUT_FLAG[0], TIMEOUT_FLAG[1], '-select_streams', 'v:0',
           '-show_entries', 'stream=codec_name,width,height,avg_frame_rate',
           '-of', 'json', rtsp_url]
    try:
        r = subprocess.run(cmd, capture_output=True, timeout=timeout,
                           creationflags=CREATE_NO_WINDOW)
        data = json.loads(r.stdout.decode(errors='ignore'))
        st = (data.get('streams') or [{}])[0]
        w, h = st.get('width'), st.get('height')
        fps = ''
        try:
            num, den = st.get('avg_frame_rate', '0/1').split('/')
            if int(den):
                fps = f'{int(num) / int(den):.0f}'
        except Exception:
            pass
        return {'codec': (st.get('codec_name') or '').upper(),
                'res': f'{w}x{h}' if w and h else '', 'fps': fps}
    except Exception:
        return {}


ONVIF_MEDIA_PATHS = ['/onvif/media_service', '/onvif/Media', '/onvif/media',
                     '/Media']


def onvif_get_profiles(ip, user, passwd, timeout=6):
    """GetProfiles + GetStreamUri. Возвращает (main_url, sub_url, profiles)."""
    headers = {'Content-Type': 'application/soap+xml; charset=utf-8'}
    prof_body = _soap(
        '<s:Body><GetProfiles xmlns="http://www.onvif.org/ver10/media/wsdl"/></s:Body>')

    for murl in [f'http://{ip}{p}' for p in ONVIF_MEDIA_PATHS]:
        try:
            resp = requests.post(murl, data=prof_body, headers=headers,
                                 auth=HTTPDigestAuth(user, passwd), timeout=timeout)
            used_wsse = False
            if resp.status_code in (401, 403) or b'NotAuthorized' in resp.content:
                wsse = _soap(f'{_wsse_header(user, passwd)}<s:Body><GetProfiles '
                             f'xmlns="http://www.onvif.org/ver10/media/wsdl"/>'
                             f'</s:Body>')
                resp = requests.post(murl, data=wsse, headers=headers, timeout=timeout)
                used_wsse = True
            if resp.status_code != 200 or b'GetProfilesResponse' not in resp.content:
                continue

            root = ET.fromstring(resp.content)
            profiles = root.findall(
                './/{http://www.onvif.org/ver10/media/wsdl}Profile')
            result = []
            for p in profiles[:4]:
                token = p.attrib.get('token', '')
                name_el = p.find('{http://www.onvif.org/ver10/schema}Name')
                pname = name_el.text if name_el is not None and name_el.text else token
                has_ptz = p.find('{http://www.onvif.org/ver10/schema}PTZConfiguration') is not None
                result.append({'token': token, 'name': pname, 'ptz': has_ptz})

            # GetStreamUri для первых двух профилей (main/sub)
            urls = []
            for prof in result[:2]:
                uri_body = _soap(
                    f'{_wsse_header(user, passwd) if used_wsse else ""}'
                    f'<s:Body><GetStreamUri xmlns="http://www.onvif.org/ver10/media/wsdl">'
                    f'<StreamSetup><Stream xmlns="http://www.onvif.org/ver10/schema">'
                    f'RTP-Unicast</Stream><Transport><Protocol xmlns='
                    f'"http://www.onvif.org/ver10/schema">RTSP</Protocol></Transport>'
                    f'</StreamSetup><ProfileToken>{prof["token"]}</ProfileToken>'
                    f'</GetStreamUri></s:Body>')
                try:
                    auth_kw = {} if used_wsse else {
                        'auth': HTTPDigestAuth(user, passwd)}
                    uresp = requests.post(murl, data=uri_body, headers=headers,
                                          timeout=timeout, **auth_kw)
                    if uresp.status_code == 200:
                        uroot = ET.fromstring(uresp.content)
                        uri_el = uroot.find(
                            './/{http://www.onvif.org/ver10/media/wsdl}Uri')
                        if uri_el is not None and uri_el.text:
                            url = uri_el.text.strip()
                            if url.startswith('rtsp://') and '@' not in url:
                                url = url.replace('rtsp://',
                                                  f'rtsp://{user}:{passwd}@', 1)
                            urls.append(url)
                except Exception:
                    continue
            main_url = urls[0] if len(urls) >= 1 else None
            sub_url = urls[1] if len(urls) >= 2 else None
            return main_url, sub_url, result
        except Exception:
            continue
    return None, None, []


def find_rtsp(ip, user, passwd, vendor_key, deep=True):
    """Интеллектуальный поиск рабочего RTSP URL.
    Порядок: ONVIF -> пути вендора -> общий список. Быстро и без тупого перебора."""
    # 1) ONVIF — точный адрес потока от самой камеры
    main_url, sub_url, profiles = onvif_get_profiles(ip, user, passwd)
    ptz = any(p['ptz'] for p in profiles)
    if main_url and probe_rtsp(main_url):
        return {'main': main_url, 'sub': sub_url if (sub_url and probe_rtsp(sub_url)) else None,
                'ptz': ptz, 'via': 'ONVIF'}

    # 2) Пути вендора — приоритетно
    vendor = VENDORS.get(vendor_key) or VENDORS['generic']
    for path in vendor['rtsp']:
        url = build_rtsp_url(ip, path, user, passwd)
        if probe_rtsp(url):
            return {'main': url, 'sub': None, 'ptz': ptz, 'via': vendor['name']}

    # 3) Общий список (глубокий перебор — только по запросу)
    if deep:
        for path in GENERIC_RTSP_PATHS:
            url = build_rtsp_url(ip, path, user, passwd)
            if probe_rtsp(url):
                return {'main': url, 'sub': None, 'ptz': ptz, 'via': 'перебор'}
    return None



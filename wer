.pl-playhead span{position:absolute;top:2px;left:50%;transform:translateX(-50%);
    background:var(--err);color:#fff;font-size:9px;font-weight:800;
    padding:1px 5px;border-radius:3px;white-space:nowrap;font-family:monospace}
.pl-hoverline{position:absolute;top:0;bottom:0;width:1px;
    background:rgba(27,36,48,.5);pointer-events:none;display:none;z-index:4}
.pl-nowline{position:absolute;top:0;bottom:0;width:0;z-index:4;pointer-events:none;
    border-left:2px dashed #e67e22}
.pl-nowline span{position:absolute;top:1px;left:50%;transform:translateX(-50%);
    background:#e67e22;color:#fff;font-size:8.5px;font-weight:800;
    letter-spacing:.5px;padding:1px 5px;border-radius:3px;white-space:nowrap}
.pl-legend{display:flex;gap:14px;align-items:center;margin-top:8px;
    font-size:11px;color:var(--dim);flex-wrap:wrap}
.pl-legend i{display:inline-block;width:20px;height:10px;border-radius:3px;
    margin-right:6px;vertical-align:-1px;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.4)}
.pl-legend .lg-seg{background:#5b96c8}
.pl-legend .lg-pres{background:#1f9e5c}
.pl-legend .lg-mot{background:var(--warn);width:4px}
.pl-sum{margin-left:auto;color:var(--dim2);font-weight:600;font-size:11px}
.pl-sum b{color:var(--text)}
.pl-ctrl{display:flex;gap:7px;align-items:center;margin-top:12px;flex-wrap:wrap}
.pl-ctrl .icon-btn{width:38px;height:38px}
.pl-ctrl select{width:auto;padding:8px 9px;font-size:12.5px}
.pl-ctrl .sp{flex:1}
.pl-lists{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}
.pl-rows{border:1px solid var(--border);border-radius:10px;background:#fff;
    max-height:172px;overflow-y:auto;box-shadow:var(--shadow-sm)}
.pl-row{display:flex;gap:7px;align-items:center;padding:7px 10px;
    border-bottom:1px solid var(--border);cursor:pointer;font-size:12px}
.pl-row:hover{background:var(--panel2)}
.pl-row:last-child{border-bottom:none}
.pl-row.active{background:#e6f1f9;box-shadow:inset 2px 0 0 var(--tie-blue)}
.pl-row .t{font-family:monospace;font-weight:700;font-size:11.5px}
.pl-row .arr{color:var(--dim2);font-size:10px}
.pl-row .d{margin-left:auto;color:var(--dim);font-size:11px;white-space:nowrap}
.pl-row .pmk{width:9px;height:9px;border-radius:2px;background:#1f9e5c;
    flex-shrink:0}
.pl-row.pres .t{color:#146b3f}
.pl-open{color:var(--warn);animation:pulse 1.4s infinite}
.pl-none{padding:14px 12px;color:var(--dim2);font-size:12px;line-height:1.6;
    text-align:center}
.pl-none small{font-size:11px}
.pl-row .dl{color:var(--dim2);width:15px;height:15px}
.pl-row .dl:hover{color:var(--tie-blue)}

/* ================= ТОСТЫ ================= */
.toasts{position:fixed;top:70px;right:16px;z-index:300;display:flex;
    flex-direction:column;gap:8px;max-width:360px}
.toast{background:#fff;border:1px solid var(--border);border-left:3px solid
    var(--tie-blue);border-radius:10px;padding:11px 14px;font-size:12.5px;
    box-shadow:var(--shadow-lg);animation:slidein .25s;display:flex;
    gap:9px;align-items:flex-start;color:var(--text)}
.toast.ok{border-left-color:var(--ok)}
.toast.err{border-left-color:var(--err)}
.toast.warn{border-left-color:var(--warn)}
@keyframes slidein{from{transform:translateX(30px);opacity:0}to{transform:none;opacity:1}}

.empty-state{grid-column:1/-1;display:flex;flex-direction:column;align-items:center;
    justify-content:center;gap:14px;color:var(--dim);padding:40px;grid-row:1/-1}
.empty-state .big{font-size:52px;opacity:.5}
.empty-state .big .ic.xl{width:72px;height:72px}
.empty-state h2{color:var(--tie-orange);font-size:20px;font-weight:800;
    letter-spacing:.4px}
.empty-state p{font-size:13px;max-width:420px;text-align:center;line-height:1.65;
    color:var(--dim)}
::-webkit-scrollbar{width:9px;height:9px}
::-webkit-scrollbar-track{background:var(--bg2)}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:5px}
::-webkit-scrollbar-thumb:hover{background:var(--tie-orange)}
@media(max-width:1100px){.sidebar{position:absolute;z-index:50;height:100%;
    box-shadow:8px 0 30px rgba(16,24,40,.2)}}
</style>
</head>

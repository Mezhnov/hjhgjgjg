def _cam_public(ip, c):
    """Публичное (безопасное) представление камеры для фронтенда."""
    st = HUB.get(ip)
    stats = dict(c.get('stats') or {})
    if st:
        stats.update({'fps': st.stats['fps'], 'frames': st.stats['frames'],
                      'restarts': st.stats['restarts'],
                      'uptime': max(0, time.time() - st.stats['started'])
                      if st.stats['started'] else 0,
                      'last_frame_age': max(0, time.time() - st.stats['last_frame'])
                      if st.stats['last_frame'] else -1})
        alive = st.running and (time.time() - (st.stats['last_frame'] or 0)) < 20 \
            and st.stats['frames'] > 0
        state = 'online' if alive else ('connecting' if st.running else 'offline')
    else:
        state = 'offline'
    eng = ANALYTICS_ENGINES.get(ip)
    an = c.get('analytics') or {}
    zone = _zone_points(an)

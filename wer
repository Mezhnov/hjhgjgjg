/* рисование: события вешаются один раз на сцену */
(function zoneInit(){
    const stage = $('zoneStage');
    stage.addEventListener('pointerdown', e => {
        if (e.button !== 0) return;
        const r = stage.getBoundingClientRect();
        const zp = e.target.closest ? e.target.closest('.zp') : null;
        let idx = zp ? +zp.dataset.i : -1;
        let added = false;
        if (idx < 0){
            if (ZN.pts.length >= 16) return;
            const x = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
            const y = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
            ZN.pts.push([+x.toFixed(4), +y.toFixed(4)]);
            idx = ZN.pts.length - 1;
            added = true;
            zoneRender();
        }
        ZN.act = {idx, added, moved:false, x0:e.clientX, y0:e.clientY};
        try { stage.setPointerCapture(e.pointerId); } catch(err){}
        e.preventDefault();
    });
    stage.addEventListener('pointermove', e => {
        if (!ZN.act) return;
        if (!ZN.act.moved &&
                Math.hypot(e.clientX - ZN.act.x0, e.clientY - ZN.act.y0) < 4)
            return;
        ZN.act.moved = true;
        const r = stage.getBoundingClientRect();
        const x = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
        const y = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
        ZN.pts[ZN.act.idx] = [+x.toFixed(4), +y.toFixed(4)];
        zoneRender();
    });
    const finish = () => {
        if (!ZN.act) return;
        if (!ZN.act.moved && !ZN.act.added){   // клик по точке — удалить
            ZN.pts.splice(ZN.act.idx, 1);
            zoneRender();
        }
        ZN.act = null;
    };
    stage.addEventListener('pointerup', finish);
    stage.addEventListener('pointercancel', () => { ZN.act = null; });
})();


/* Джойстик: тянем оранжевый knob — камера получает ContinuousMove
   с вектором (pan, tilt) = пропорционально смещению от центра. */
(function(){
    const joy = $('ptzJoy'); if (!joy) return;
    const knob = $('ptzKnob');
    let dragging = false;
    let R = 70;            // радиус возможного смещения knob
    let lastCmd = 0;
    let lastV = {x:0, y:0};
    const CMD_INTERVAL = 220;  // throttle ONVIF: раз в 220мс

    function recalcR(){
        const r = joy.getBoundingClientRect();
        R = Math.max(20, r.width / 2 - 22);
    }
    function setKnob(dx, dy){
        // ограничиваем кругом
        const d = Math.hypot(dx, dy);
        if (d > R){ dx = dx * R / d; dy = dy * R / d; }
        knob.style.transform = `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px))`;
    }
    function cmdFromVec(dx, dy){
        const now = Date.now();
        // нормализуем к -1..1
        const nx = dx / R, ny = -dy / R;  // y инвертируем: вверх = +
        const mag = Math.hypot(nx, ny);
        if (mag < 0.12){
            // дребезг ближе к центру -> стоп
            if (lastV.x || lastV.y){
                ptzStop(); lastV = {x:0, y:0};
            }
            return;
        }
        if (now - lastCmd < CMD_INTERVAL) return;
        lastCmd = now;
        lastV = {x:nx, y:ny};
        // Определяем доминирующее направление (4-секторное, как у ONVIF up/down/left/right)
        // Если |x|>|y| — horizontal, иначе vertical. Это даёт камере простойContinuousMove.
        if (Math.abs(nx) > Math.abs(ny)){
            ptzCmd(nx > 0 ? 'right' : 'left');
        } else {
            ptzCmd(ny > 0 ? 'up' : 'down');
        }
    }
    joy.addEventListener('pointerdown', e => {
        if (e.target.classList.contains('ptz-edge')) return; // клик по кнопке края
        dragging = true;
        joy.classList.add('dragging');
        joy.setPointerCapture(e.pointerId);
        recalcR();
        const r = joy.getBoundingClientRect();
        const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
        const dx = e.clientX - cx, dy = e.clientY - cy;
        setKnob(dx, dy);
        cmdFromVec(dx, dy);
    });
    joy.addEventListener('pointermove', e => {
        if (!dragging) return;
        const r = joy.getBoundingClientRect();
        const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
        const dx = e.clientX - cx, dy = e.clientY - cy;
        setKnob(dx, dy);
        cmdFromVec(dx, dy);
    });
    function endDrag(){
        if (!dragging) return;
        dragging = false;
        joy.classList.remove('dragging');
        setKnob(0, 0);
        ptzStop();
        lastV = {x:0, y:0};
    }
    joy.addEventListener('pointerup', endDrag);
    joy.addEventListener('pointercancel', endDrag);
    joy.addEventListener('pointerleave', endDrag);
    /* Кнопки по краям джойстика: hold для непрерывного движения */
    joy.querySelectorAll('.ptz-edge').forEach(btn => {
        const dir = btn.dataset.dir;
        let iv = null;
        const start = (e) => {
            e.preventDefault();
            ptzCmd(dir);
            iv = setInterval(() => ptzCmd(dir), 600);
        };
        const stop = () => {
            if (iv){ clearInterval(iv); iv = null; }
            ptzStop();
        };
        btn.addEventListener('pointerdown', start);
        btn.addEventListener('pointerup', stop);
        btn.addEventListener('pointerleave', stop);
        btn.addEventListener('pointercancel', stop);
    });
})();

/* Zoom slider: — значение <0 = zoomout, >0 = zoomin, 0 = стоп.
   Шлём команду раз в 350мс, пока слайдер не в нуле. */
(function(){
    const z = $('ptzZoom'); if (!z) return;
    let iv = null;
    function fire(){
        const v = parseInt(z.value, 10);
        if (v === 0){
            if (iv){ clearInterval(iv); iv = null; ptzStop(); }
            return;
        }
        ptzCmd(v > 0 ? 'zoomin' : 'zoomout');
    }
    z.addEventListener('input', () => {
        const v = parseInt(z.value, 10);
        const lbl = $('ptzZoomVal');
        if (lbl) lbl.textContent = (v > 0 ? '+' : '') + v;
        if (v !== 0 && !iv){
            fire();
            iv = setInterval(fire, 400);
        } else if (v === 0 && iv){
            clearInterval(iv); iv = null; ptzStop();
        }
    });
    z.addEventListener('pointerup', () => {
        z.value = 0;
        const lbl = $('ptzZoomVal');
        if (lbl) lbl.textContent = '0';
        if (iv){ clearInterval(iv); iv = null; }
        ptzStop();
    });
    // safety: если указатель ушёл с slider — сброс
    z.addEventListener('pointerleave', () => {
        if (parseInt(z.value, 10) !== 0){
            z.value = 0;
            const lbl = $('ptzZoomVal');
            if (lbl) lbl.textContent = '0';
            if (iv){ clearInterval(iv); iv = null; }
            ptzStop();
        }
    });
})();
(function(){
    const s = $('ptzSpeed'); if (!s) return;

async function doAddCam(){
    const ip = $('acIP').value.trim();
    const port = parseInt($('acPort').value, 10) || 80;
    const user = $('acUser').value.trim();
    const pass = $('acPass').value;
    const auth = $('acAuth').value;
    const remember = $('acRemember').checked;
    if (!ip){ $('acErr').textContent = 'Введите IP-адрес камеры';
        $('acErr').classList.add('show'); return; }
    if (!user || !pass){ $('acErr').textContent = 'Введите логин и пароль';
        $('acErr').classList.add('show'); return; }
    // простая валидация IP
    const parts = ip.split('.');
    const validIp = parts.length === 4 && parts.every(p => {
        const n = parseInt(p, 10);
        return !isNaN(n) && n >= 0 && n <= 255 && String(n) === p.trim();
    });
    if (!validIp && !ip.startsWith('rtsp://')){
        $('acErr').textContent = 'Неверный IP-адрес (формат: 192.168.1.108)';
        $('acErr').classList.add('show'); return;

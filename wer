/* вписать слой рамок ровно в отображаемую область видео
   (у плиток кадр вписан в прямоугольник — object-fit:contain) */
function fitDetLayer(layer, img){
    if (!layer || !img) return false;
    const nw = img.naturalWidth || 0, nh = img.naturalHeight || 0;
    if (!nw || !nh || !img.clientWidth || !img.clientHeight){
        layer.style.display = 'none';
        return false;
    }
    const k = Math.min(img.clientWidth / nw, img.clientHeight / nh);
    const dw = nw * k, dh = nh * k;
    layer.style.display = '';
    layer.style.left = (img.offsetLeft + (img.clientWidth - dw) / 2) + 'px';
    layer.style.top = (img.offsetTop + (img.clientHeight - dh) / 2) + 'px';
    layer.style.width = dw + 'px';
    layer.style.height = dh + 'px';
    return true;
}

/* обновить рамки в слое: существующие двигаем (CSS-transition делает
   движение плавным), новые создаём, пропавшие убираем */
function drawBoxes(layer, boxes){
    const seen = new Set();
    (boxes || []).forEach(b => {
        const id = b.c + b.i;
        seen.add(id);
        let el = layer.querySelector('[data-id="' + id + '"]');
        const x = b.b[0], y = b.b[1], w = b.b[2], h = b.b[3];
        if (!el){
            el = document.createElement('div');
            el.dataset.id = id;
            el.innerHTML = '<span class="dlab"></span>';
            el.style.transition = 'none';   // без анимации с первого кадра
            requestAnimationFrame(() => { el.style.transition = ''; });
            layer.appendChild(el);
        }
        el.className = 'dbox ' + (b.c === 'person' ? 'p' : 'v') +
            (y < 0.14 ? ' thin' : '');
        el.style.left = (x * 100).toFixed(2) + '%';
        el.style.top = (y * 100).toFixed(2) + '%';
        el.style.width = (w * 100).toFixed(2) + '%';
        el.style.height = (h * 100).toFixed(2) + '%';
        el.firstChild.textContent = (CLS_RU[b.c] || b.c) + ' · ' + b.i;
    });
    [...layer.children].forEach(el => {
        if (!seen.has(el.dataset.id)) el.remove();
    });
}

function renderDets(){
    // плитки текущей страницы стены
    document.querySelectorAll('.tile .det-layer').forEach(layer => {

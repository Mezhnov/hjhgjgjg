class CameraStream:
    """Живой MJPEG-поток камеры с подписчиками и авто-восстановлением."""

    def __init__(self, ip, rtsp_url, settings):
        self.ip = ip
        self.rtsp_url = rtsp_url
        self.settings = settings
        self.proc = None
        self.lock = threading.Lock()
        self.cond = threading.Condition(self.lock)
        self.frame = None
        self.frame_id = 0
        self.subs = 0
        self.stop_at = None
        self.running = False
        self.restarting = False
        self._restart_not_before = 0.0
        self._fps_times = deque(maxlen=24)
        self.stats = {'fps': 0, 'frames': 0, 'restarts': 0,
                      'started': 0, 'last_frame': 0, 'res': '', 'codec': '',
                      'error': ''}
        self._err_tail = deque(maxlen=30)

    # ---------------------------------------------------------------- api
    def subscribe(self):
        with self.lock:
            self.subs += 1
            self.stop_at = None
            if not self.running:
                self._start_locked()

    def unsubscribe(self):
        with self.lock:
            if self.subs > 0:
                self.subs -= 1
            if self.subs == 0:
                self.stop_at = time.time() + int(self.settings.get(
                    'keepalive', STREAM_KEEPALIVE))

    def wait_frame(self, last_id, timeout=15):
        """Блокирующее ожидание нового кадра. (frame, id) или (None, id)."""
        deadline = time.time() + timeout
        with self.cond:
            while self.frame_id <= last_id or self.frame is None:
                remaining = deadline - time.time()
                if remaining <= 0:
                    return None, last_id
                self.cond.wait(min(remaining, 2.0))
            return self.frame, self.frame_id

    def latest_frame(self):
        with self.lock:
            return self.frame

    def error_tail(self):
        with self.lock:
            return '\n'.join(list(self._err_tail)[-12:])

    # ------------------------------------------------------------ запуск
    def _cmd(self):
        q = QUALITY_PRESETS.get(self.settings.get('quality', 'balanced'),
                                QUALITY_PRESETS['balanced'])
        return [FFMPEG_PATH, '-hide_banner', '-loglevel', 'error',
                '-rtsp_transport', self.settings.get('transport', 'tcp'),
                '-fflags', '+genpts+discardcorrupt+nobuffer',
                '-flags', 'low_delay', TIMEOUT_FLAG[0], TIMEOUT_FLAG[1],
                '-i', self.rtsp_url, '-an', '-c:v', 'mjpeg',
                '-q:v', str(q['q']), '-r', str(q['fps']),
                '-s', q['size'], '-f', 'image2pipe', 'pipe:1']

    def _start_locked(self):
        if not FFMPEG_AVAILABLE:
            self.stats['error'] = 'FFmpeg не найден'
            return
        try:
            self.proc = subprocess.Popen(
                self._cmd(), stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                bufsize=0, creationflags=CREATE_NO_WINDOW)
        except Exception as e:
            self.stats['error'] = f'ffmpeg: {e}'
            return
        self.running = True
        self.stats['started'] = time.time()
        self.stats['restarts'] += 1
        self.stats['error'] = ''
        threading.Thread(target=self._reader, daemon=True,
                         name=f'reader-{self.ip}').start()
        threading.Thread(target=self._drain_err, daemon=True,
                         name=f'err-{self.ip}').start()

    def _drain_err(self):
        """Читаем stderr ffmpeg, чтобы не блокировать его, храним хвост."""
        proc = self.proc
        if proc is None:
            return
        try:
            for line in iter(proc.stderr.readline, b''):
                with self.lock:
                    self._err_tail.append(line.decode(errors='ignore').rstrip())
        except Exception:
            pass

    def _reader(self):
        """Поток чтения MJPEG-кадров из stdout ffmpeg."""
        buf = b''
        proc = self.proc
        if proc is None:
            return
        try:
            while self.running:
                chunk = proc.stdout.read(8192)
                if not chunk:
                    break
                buf += chunk
                while True:
                    soi = buf.find(b'\xff\xd8')
                    if soi == -1:
                        buf = b'' if len(buf) > 262144 else buf
                        break
                    eoi = buf.find(b'\xff\xd9', soi + 2)
                    if eoi == -1:
                        buf = buf[soi:]
                        if len(buf) > 1048576:
                            buf = b''
                        break
                    frame = buf[soi:eoi + 2]
                    buf = buf[eoi + 2:]
                    if len(frame) > 512:
                        now = time.time()
                        with self.cond:
                            self.frame = frame
                            self.frame_id += 1
                            self.stats['frames'] += 1
                            self.stats['last_frame'] = now
                            self._fps_times.append(now)
                            if len(self._fps_times) >= 2:
                                dt = self._fps_times[-1] - self._fps_times[0]
                                if dt > 0:
                                    self.stats['fps'] = round(
                                        (len(self._fps_times) - 1) / dt, 1)
                            self.cond.notify_all()
        except Exception as e:
            with self.lock:
                self.stats['error'] = str(e)
        finally:
            self._cleanup()

    def _cleanup(self):
        with self.lock:
            self.running = False
            self.proc = None
            self.cond.notify_all()
        LOG.add('warn', f'Поток остановлен: {self.ip}', self.ip)

    def stop(self):
        with self.lock:
            self.running = False
            proc, self.proc = self.proc, None
            self.cond.notify_all()
        if proc:
            try:
                proc.kill()
            except Exception:
                pass

    def maybe_restart(self):
        """Вызывается сторожевым псом. Перезапуск при необходимости."""
        with self.lock:
            if self.subs == 0:
                if self.stop_at and time.time() > self.stop_at:
                    return 'stop'
                return None
            if self.running:
                last = self.stats['last_frame'] or self.stats['started']
                if time.time() - last > FRAME_STALE_SEC and \
                        time.time() - self.stats['started'] > 10:
                    if time.time() > self._restart_not_before:
                        self._restart_not_before = time.time() + RESTART_BACKOFF
                        return 'restart'
                return None
            # не running: процесс умер
            if time.time() > self._restart_not_before:
                self._restart_not_before = time.time() + RESTART_BACKOFF
                return 'restart'
            return None

    def do_restart(self):
        with self.lock:
            if self.restarting:
                return
            self.restarting = True
            proc, self.proc = self.proc, None
            self.running = False
        if proc:
            try:
                proc.kill()
            except Exception:
                pass
        time.sleep(0.8)
        with self.lock:
            self.restarting = False
            self.subs = max(1, self.subs)  # форсируем запуск
            self._start_locked()
        LOG.add('warn', f'Перезапуск потока: {self.ip}', self.ip)


HUB = {}
HUB_LOCK = threading.Lock()


def hub_get(ip, create=True):
    """Получить (или создать) поток камеры. Один ffmpeg на камеру!"""
    cam = STATE.cameras.get(ip)
    if not cam:
        return None
    with HUB_LOCK:
        st = HUB.get(ip)
        if st is None and create:
            with STATE.lock:
                settings = dict(STATE.settings)
            view_url = cam.get('rtsp_view') or cam.get('rtsp_main')
            if not view_url:
                return None
            st = CameraStream(ip, view_url, settings)
            HUB[ip] = st
        return st


def hub_drop(ip):
    with HUB_LOCK:
        st = HUB.pop(ip, None)
    if st:
        st.stop()


def hub_watchdog():
    """Сторожевой поток: перезапуск мёртвых/зависших потоков, сборка мусора."""
    while True:
        time.sleep(5)
        try:
            with HUB_LOCK:
                items = list(HUB.items())
            for ip, st in items:
                action = st.maybe_restart()
                if action == 'stop':
                    st.stop()
                    with HUB_LOCK:
                        HUB.pop(ip, None)
                    LOG.add('info', f'Поток освобождён (нет зрителей): {ip}', ip)
                elif action == 'restart':
                    st.do_restart()
        except Exception as e:
            LOG.add('error', f'Сторожевой пёс: {e}')



def _find_binary(name, extra_candidates=()):
    """Поиск бинарника: путь из PATH + доп. кандидаты + папка рядом."""
    found = shutil.which(name)
    if found:
        return found
    for p in extra_candidates:
        if p and os.path.isfile(p):
            return p
    # ffprobe часто лежит рядом с ffmpeg
    if FFMPEG_PATH and os.path.isfile(os.path.join(os.path.dirname(FFMPEG_PATH), name + ('.exe' if os.name == 'nt' else ''))):
        return os.path.join(os.path.dirname(FFMPEG_PATH), name + ('.exe' if os.name == 'nt' else ''))
    return None


def _binary_ok(path):
    try:
        subprocess.run([path, '-version'], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=5,
                       creationflags=CREATE_NO_WINDOW)
        return True
    except Exception:
        return False



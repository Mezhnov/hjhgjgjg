.pl-empty .ic{width:38px;height:38px;opacity:.45;stroke-width:1.4}
.pl-empty b{color:#c3d0dd}
.pl-empty small{font-size:11px;color:#63758a}
.pl-timecode{position:absolute;top:10px;left:12px;background:rgba(11,15,20,.75);
